  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod – Electrician Case Study IG</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body { background:#111; display:flex; flex-direction:column; align-items:center; padding:20px; gap:16px; font-family:'DM Sans',sans-serif; }\n  #post {\n    width:1080px; height:1350px;\n    background:#0B1929;\n    position:relative; overflow:hidden;\n    display:flex; flex-direction:column;\n    padding:60px 64px 52px;\n    color:#fff;\n  }\n  .dot-grid {\n    position:absolute; inset:0;\n    background-image:radial-gradient(circle,rgba(0,212,255,0.08) 1px,transparent 1px);\n    background-size:28px 28px; pointer-events:none;\n  }\n  .glow {\n    position:absolute; top:-180px; left:-180px;\n    width:640px; height:640px;\n    background:radial-gradient(circle,rgba(0,212,255,0.16) 0%,transparent 60%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute; top:-70px; right:-70px;\n    width:480px; height:480px; opacity:0.05; transform:rotate(12deg);\n    pointer-events:none; color:#00D4FF;\n  }\n  /* Character illustration */\n  .character {\n    position:absolute; top:44px; right:56px;\n    width:160px; height:180px;\n  }\n  .char-card {\n    width:160px; height:180px;\n    background:rgba(0,212,255,0.06);\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:20px;\n    display:flex; align-items:center; justify-content:center;\n    position:relative; overflow:hidden;\n  }\n  .char-card::before {\n    content:''; position:absolute; inset:0;\n    background:radial-gradient(circle at 50% 30%, rgba(0,212,255,0.1), transparent 70%);\n  }\n  .char-svg { width:90px; height:90px; }\n  .char-dot {\n    position:absolute; width:10px; height:10px; border-radius:50%;\n  }\n  .char-dot.red { background:#EF4444; top:12px; right:12px; box-shadow:0 0 8px #EF4444; }\n  .char-dot.cyan { background:#00D4FF; bottom:12px; right:12px; box-shadow:0 0 8px #00D4FF; }\n  .char-dot.yellow { background:#F59E0B; top:12px; left:12px; box-shadow:0 0 8px #F59E0B; }\n\n  .badge {\n    display:inline-flex; align-items:center; gap:10px;\n    padding:10px 20px;\n    border:1.5px solid rgba(0,212,255,0.6);\n    border-radius:100px;\n    font-family:'JetBrains Mono',monospace;\n    font-size:17px; color:#00D4FF;\n    width:fit-content; margin-bottom:22px;\n    background:rgba(0,212,255,0.05);\n    z-index:2;\n  }\n  .badge svg { width:16px; height:16px; }\n  .badge-label { display:flex; align-items:center; gap:6px; }\n\n  .headline {\n    font-family:'Outfit',sans-serif; font-weight:900;\n    font-size:88px; line-height:0.94;\n    letter-spacing:-0.03em; color:#fff;\n    margin-bottom:18px; z-index:2;\n    max-width:760px;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;\n  }\n  .headline .strikethrough {\n    text-decoration:line-through; color:rgba(255,255,255,0.35);\n    -webkit-text-fill-color:rgba(255,255,255,0.35);\n  }\n\n  .subtitle {\n    font-size:20px; color:rgba(255,255,255,0.55);\n    line-height:1.45; margin-bottom:24px; z-index:2; max-width:720px;\n  }\n\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.18);\n    border-radius:20px; padding:28px;\n    z-index:2; display:flex; flex-direction:column; gap:14px;\n    flex:1;\n  }\n\n  .compare {\n    display:grid; grid-template-columns:1fr 1fr; gap:12px;\n  }\n  .col {\n    border-radius:12px; padding:18px 16px;\n  }\n  .col.before {\n    background:rgba(239,68,68,0.07);\n    border-left:3px solid #EF4444;\n  }\n  .col.after {\n    background:rgba(0,212,255,0.07);\n    border-left:3px solid #00D4FF;\n  }\n  .col-title {\n    font-family:'JetBrains Mono',monospace; font-size:13px;\n    text-transform:uppercase; letter-spacing:0.1em; margin-bottom:10px;\n  }\n  .col.before .col-title { color:#EF4444; }\n  .col.after .col-title { color:#00D4FF; }\n  .col-item {\n    font-size:18px; color:rgba(255,255,255,0.75);\n    line-height:1.5; padding:3px 0;\n  }\n  .col.after .col-item { color:rgba(255,255,255,0.9); }\n\n  .divider {\n    display:flex; align-items:center; gap:10px;\n    font-family:'JetBrains Mono',monospace; font-size:12px;\n    color:rgba(0,212,255,0.6); text-transform:uppercase; letter-spacing:0.1em;\n  }\n  .divider-line { flex:1; height:1px; background:rgba(0,212,255,0.15); }\n\n  .tool-row {\n    display:flex; align-items:center; gap:14px;\n    padding:12px 16px;\n    background:rgba(255,255,255,0.025);\n    border-radius:10px;\n  }\n  .tool-num {\n    font-family:'JetBrains Mono',monospace; font-size:13px;\n    color:rgba(0,212,255,0.5); min-width:22px;\n  }\n  .tool-logo { width:28px; height:28px; object-fit:contain; flex-shrink:0; }\n  .tool-name {\n    font-family:'DM Sans',sans-serif; font-weight:700;\n    font-size:19px; color:#fff; flex:1;\n  }\n  .tool-desc {\n    font-size:17px; color:rgba(255,255,255,0.5);\n    font-style:italic;\n  }\n\n  .stat-box {\n    display:flex; align-items:center; justify-content:space-between;\n    background:rgba(0,212,255,0.06);\n    border:1px solid rgba(0,212,255,0.25);\n    border-radius:12px; padding:18px 22px;\n  }\n  .stat-label {\n    font-family:'JetBrains Mono',monospace; font-size:14px;\n    color:rgba(255,255,255,0.5); text-transform:uppercase; letter-spacing:0.08em;\n  }\n  .stat-value {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:52px;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;\n    line-height:1;\n  }\n\n  .footer {\n    display:flex; align-items:center; justify-content:space-between;\n    margin-top:20px; z-index:2;\n  }\n  .cta {\n    display:inline-flex; align-items:center; gap:10px;\n    padding:16px 28px;\n    background:rgba(0,212,255,0.1);\n    border:1.5px solid #00D4FF;\n    border-radius:100px;\n    font-family:'DM Sans',sans-serif; font-size:20px; font-weight:500; color:#fff;\n  }\n  .cta-dot { width:9px; height:9px; border-radius:50%; background:#00D4FF; box-shadow:0 0 10px #00D4FF; }\n  .logo {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:30px;\n    letter-spacing:-0.02em;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;\n  }\n  button { padding:12px 24px; background:#00D4FF; color:#0B1929; border:none; border-radius:8px; font-size:15px; cursor:pointer; margin-top:12px; }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <!-- Character illustration -->\n  <div class=\"character\">\n    <div class=\"char-card\">\n      <div class=\"char-dot red\"></div>\n      <div class=\"char-dot cyan\"></div>\n      <div class=\"char-dot yellow\"></div>\n      <svg class=\"char-svg\" viewBox=\"0 0 90 110\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Head -->\n        <circle cx=\"45\" cy=\"22\" r=\"18\" fill=\"#1E3A5F\"/>\n        <circle cx=\"45\" cy=\"20\" r=\"15\" fill=\"#2D5A8E\"/>\n        <!-- Eyes -->\n        <circle cx=\"39\" cy=\"20\" r=\"2.5\" fill=\"#00D4FF\"/>\n        <circle cx=\"51\" cy=\"20\" r=\"2.5\" fill=\"#00D4FF\"/>\n        <!-- Body -->\n        <rect x=\"28\" y=\"44\" width=\"34\" height=\"42\" rx=\"6\" fill=\"#00D4FF\"/>\n        <rect x=\"32\" y=\"50\" width=\"26\" height=\"28\" rx=\"4\" fill=\"#0B1929\"/>\n        <!-- Clipboard -->\n        <rect x=\"34\" y=\"53\" width=\"22\" height=\"18\" rx=\"2\" fill=\"#1E3A5F\"/>\n        <rect x=\"37\" y=\"57\" width=\"16\" height=\"2\" rx=\"1\" fill=\"#00D4FF\"/>\n        <rect x=\"37\" y=\"61\" width=\"12\" height=\"2\" rx=\"1\" fill=\"rgba(0,212,255,0.4)\"/>\n        <rect x=\"37\" y=\"65\" width=\"14\" height=\"2\" rx=\"1\" fill=\"rgba(0,212,255,0.4)\"/>\n        <!-- Arms -->\n        <rect x=\"10\" y=\"46\" width=\"18\" height=\"8\" rx=\"4\" fill=\"#00D4FF\"/>\n        <rect x=\"62\" y=\"46\" width=\"18\" height=\"8\" rx=\"4\" fill=\"#00D4FF\"/>\n        <!-- Legs -->\n        <rect x=\"32\" y=\"84\" width=\"10\" height=\"22\" rx=\"5\" fill=\"#1E3A5F\"/>\n        <rect x=\"48\" y=\"84\" width=\"10\" height=\"22\" rx=\"5\" fill=\"#1E3A5F\"/>\n      </svg>\n    </div>\n  </div>\n\n  <div class=\"badge\">\n    <svg width=\"16\" height=\"16\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n    AI Automation / Case Study\n  </div>\n\n  <h1 class=\"headline\">He didn't fire her because she was <span class=\"strikethrough\">bad.</span><br><em>The workflow</em> was just better.</h1>\n  <p class=\"subtitle\">A real electrician replaced a £45k/yr office manager with three tools talking to each other. Here's the receipt.</p>\n\n  <div class=\"panel\">\n    <div class=\"compare\">\n      <div class=\"col before\">\n        <div class=\"col-title\">✗ Before</div>\n        <div class=\"col-item\">1 office manager</div>\n        <div class=\"col-item\">3 spreadsheets</div>\n        <div class=\"col-item\">Missed jobs weekly</div>\n      </div>\n      <div class=\"col after\">\n        <div class=\"col-title\">✓ After</div>\n        <div class=\"col-item\">1 workflow</div>\n        <div class=\"col-item\">0 dropped leads</div>\n        <div class=\"col-item\">Sleeps on Sundays</div>\n      </div>\n    </div>\n\n    <div class=\"divider\">\n      <div class=\"divider-line\"></div>\n      The 3-tool stack that replaced her\n      <div class=\"divider-line\"></div>\n    </div>\n\n    <div class=\"tool-row\">\n      <span class=\"tool-num\">01</span>\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>\n      <span class=\"tool-name\">GoHighLevel</span>\n      <span class=\"tool-desc\">Captures every lead. Never sleeps.</span>\n    </div>\n    <div class=\"tool-row\">\n      <span class=\"tool-num\">02</span>\n      <img class=\"tool-logo\" src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\">\n      <span class=\"tool-name\">Claude Code</span>\n      <span class=\"tool-desc\">Writes quotes in the boss's voice.</span>\n    </div>\n    <div class=\"tool-row\">\n      <span class=\"tool-num\">03</span>\n      <img class=\"tool-logo\" src=\"https://cdn.simpleicons.org/n8n/EA4B71\" alt=\"n8n\">\n      <span class=\"tool-name\">N8N</span>\n      <span class=\"tool-desc\">Schedules jobs. Sends the van.</span>\n    </div>\n\n    <div class=\"stat-box\">\n      <span class=\"stat-label\">Annual cost saved</span>\n      <span class=\"stat-value\">£45,000</span>\n    </div>\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta\"><span class=\"cta-dot\"></span>Sound Interesting?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n</div>\n<button onclick=\"document.getElementById('post').style.overflow='visible'\">Export</button>\n</body>\n</html>\n",
  "fb_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod – Electrician Case Study FB</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body { background:#111; display:flex; flex-direction:column; align-items:center; padding:20px; font-family:'DM Sans',sans-serif; }\n  #post {\n    width:1200px; height:630px;\n    background:#0B1929;\n    position:relative; overflow:hidden;\n    display:flex; color:#fff;\n  }\n  .dot-grid {\n    position:absolute; inset:0;\n    background-image:radial-gradient(circle,rgba(0,212,255,0.07) 1px,transparent 1px);\n    background-size:24px 24px; pointer-events:none;\n  }\n  .glow {\n    position:absolute; top:-160px; left:-160px;\n    width:560px; height:560px;\n    background:radial-gradient(circle,rgba(0,212,255,0.14),transparent 65%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute; top:-50px; right:-50px;\n    width:380px; height:380px; opacity:0.05; transform:rotate(12deg);\n    pointer-events:none; color:#00D4FF;\n  }\n\n  /* LEFT */\n  .left {\n    width:340px; padding:36px 28px;\n    display:flex; flex-direction:column;\n    position:relative; z-index:2; flex-shrink:0;\n  }\n  .badge {\n    display:inline-flex; align-items:center; gap:8px;\n    padding:8px 14px;\n    border:1px solid rgba(0,212,255,0.5); border-radius:100px;\n    font-family:'JetBrains Mono',monospace; font-size:12px; color:#00D4FF;\n    width:fit-content; margin-bottom:20px;\n  }\n  .badge svg { width:13px; height:13px; }\n  .headline {\n    font-family:'Outfit',sans-serif; font-weight:900;\n    font-size:56px; line-height:0.93;\n    letter-spacing:-0.03em; color:#fff; margin-bottom:14px;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;\n  }\n  .headline .strikethrough {\n    text-decoration:line-through; color:rgba(255,255,255,0.3);\n    -webkit-text-fill-color:rgba(255,255,255,0.3);\n  }\n  .subtitle {\n    font-size:14px; color:rgba(255,255,255,0.55);\n    line-height:1.5; margin-bottom:20px;\n  }\n  .cta {\n    display:inline-flex; align-items:center; gap:8px;\n    padding:12px 20px;\n    background:rgba(0,212,255,0.1);\n    border:1px solid rgba(0,212,255,0.4); border-radius:100px;\n    font-family:'JetBrains Mono',monospace; font-size:13px; color:#00D4FF;\n    width:fit-content; margin-bottom:auto;\n  }\n  .logo {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:22px;\n    letter-spacing:-0.02em;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;\n  }\n\n  /* RIGHT */\n  .right {\n    flex:1; padding:28px 28px 28px 8px;\n    position:relative; z-index:2; display:flex; flex-direction:column;\n  }\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.18);\n    border-radius:16px; padding:22px;\n    flex:1; display:flex; flex-direction:column; gap:10px;\n  }\n  .panel-header {\n    display:flex; align-items:center; justify-content:space-between;\n    margin-bottom:4px;\n  }\n  .panel-title {\n    font-family:'JetBrains Mono',monospace; font-size:11px;\n    color:rgba(255,255,255,0.4); text-transform:uppercase; letter-spacing:0.1em;\n  }\n  .live-badge {\n    display:flex; align-items:center; gap:6px;\n    font-family:'JetBrains Mono',monospace; font-size:11px; color:#22C55E;\n  }\n  .live-dot { width:7px; height:7px; border-radius:50%; background:#22C55E; box-shadow:0 0 6px #22C55E; }\n\n  .compare { display:grid; grid-template-columns:1fr 1fr; gap:10px; }\n  .col { border-radius:10px; padding:14px 14px; }\n  .col.before { background:rgba(239,68,68,0.07); border-left:2px solid #EF4444; }\n  .col.after  { background:rgba(0,212,255,0.07);  border-left:2px solid #00D4FF; }\n  .col-title {\n    font-family:'JetBrains Mono',monospace; font-size:11px;\n    text-transform:uppercase; letter-spacing:0.1em; margin-bottom:8px;\n  }\n  .col.before .col-title { color:#EF4444; }\n  .col.after  .col-title { color:#00D4FF; }\n  .col-item { font-size:14px; color:rgba(255,255,255,0.7); line-height:1.6; }\n  .col.after .col-item { color:rgba(255,255,255,0.9); }\n\n  .tool-row {\n    display:flex; align-items:center; gap:10px;\n    padding:9px 12px;\n    background:rgba(255,255,255,0.025); border-radius:8px;\n  }\n  .tool-logo { width:22px; height:22px; object-fit:contain; flex-shrink:0; }\n  .tool-name { font-weight:700; font-size:14px; color:#fff; flex:1; }\n  .tool-desc { font-size:13px; color:rgba(255,255,255,0.45); font-style:italic; }\n  .tool-tag {\n    font-family:'JetBrains Mono',monospace; font-size:11px;\n    color:#00D4FF; background:rgba(0,212,255,0.1);\n    border:1px solid rgba(0,212,255,0.2); border-radius:4px;\n    padding:2px 8px; white-space:nowrap;\n  }\n\n  .stat-box {\n    display:flex; align-items:center; justify-content:space-between;\n    background:rgba(0,212,255,0.06);\n    border:1px solid rgba(0,212,255,0.22); border-radius:10px;\n    padding:14px 18px;\n  }\n  .stat-label { font-size:13px; color:rgba(255,255,255,0.5); }\n  .stat-value {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:38px;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;\n    line-height:1;\n  }\n  button { margin-top:12px; padding:10px 20px; background:#00D4FF; color:#0B1929; border:none; border-radius:6px; cursor:pointer; }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <svg style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n      Real Trades Case Study\n    </div>\n    <div class=\"headline\">He didn't fire her because she was <span class=\"strikethrough\">bad.</span><br><em>The workflow</em> was just better.</div>\n    <div class=\"subtitle\">He fired her because a workflow was better. Here's exactly what replaced her.</div>\n    <div class=\"cta\">→ Sound Interesting?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-header\">\n        <div class=\"panel-title\">Case Study · Electrician</div>\n        <div class=\"live-badge\"><div class=\"live-dot\"></div>Live in production</div>\n      </div>\n\n      <div class=\"compare\">\n        <div class=\"col before\">\n          <div class=\"col-title\">✗ Before</div>\n          <div class=\"col-item\">1 office manager</div>\n          <div class=\"col-item\">3 spreadsheets</div>\n          <div class=\"col-item\">Missed jobs weekly</div>\n        </div>\n        <div class=\"col after\">\n          <div class=\"col-title\">✓ After</div>\n          <div class=\"col-item\">1 workflow</div>\n          <div class=\"col-item\">0 dropped leads</div>\n          <div class=\"col-item\">Sundays off</div>\n        </div>\n      </div>\n\n      <div class=\"tool-row\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>\n        <span class=\"tool-name\">GoHighLevel</span>\n        <span class=\"tool-desc\">— lead intake</span>\n        <span class=\"tool-tag\">24/7</span>\n      </div>\n      <div class=\"tool-row\">\n        <img class=\"tool-logo\" src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\">\n        <span class=\"tool-name\">Claude Code</span>\n        <span class=\"tool-desc\">— auto-generates quotes</span>\n        <span class=\"tool-tag\">↑ 40%</span>\n      </div>\n      <div class=\"tool-row\">\n        <img class=\"tool-logo\" src=\"https://cdn.simpleicons.org/n8n/EA4B71\" alt=\"n8n\">\n        <span class=\"tool-name\">N8N</span>\n        <span class=\"tool-desc\">— schedules the job</span>\n        <span class=\"tool-tag\">Hands-off</span>\n      </div>\n\n      <div class=\"stat-box\">\n        <span class=\"stat-label\">💰 £45K saved per year · replaced admin role</span>\n        <span class=\"stat-value\">£45K</span>\n      </div>\n    </div>\n  </div>\n</div>\n<button>Export</button>\n</body>\n</html>\n"
}
