  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod — DIY Automation Broke</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    background:#1a1a1a;\n    font-family:'DM Sans', sans-serif;\n    display:flex; flex-direction:column; align-items:center; padding:30px; gap:20px;\n  }\n  #post {\n    width:1080px; height:1350px;\n    background:#0B1929;\n    position:relative;\n    overflow:hidden;\n    padding:80px 70px 70px;\n    display:flex; flex-direction:column;\n    font-family:'DM Sans', sans-serif;\n    color:#fff;\n  }\n  .dot-grid {\n    position:absolute; inset:0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 32px 32px;\n    pointer-events:none;\n  }\n  .glow-tl {\n    position:absolute; top:-220px; left:-220px;\n    width:760px; height:760px;\n    background: radial-gradient(circle, rgba(0,212,255,0.20) 0%, transparent 60%);\n    pointer-events:none;\n  }\n  .glow-br {\n    position:absolute; bottom:-260px; right:-200px;\n    width:680px; height:680px;\n    background: radial-gradient(circle, rgba(0,212,255,0.10) 0%, transparent 60%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute; top:-80px; right:-100px;\n    width:560px; height:560px;\n    opacity:0.05;\n    transform:rotate(12deg);\n    pointer-events:none;\n  }\n  .badge {\n    display:inline-flex; align-items:center; gap:12px;\n    padding:14px 26px;\n    border:1.5px solid #00D4FF;\n    border-radius:100px;\n    font-family:'JetBrains Mono', monospace;\n    font-size:22px;\n    font-weight:500;\n    color:#00D4FF;\n    width:fit-content;\n    background:rgba(0,212,255,0.05);\n    z-index:2;\n  }\n  .badge svg { width:22px; height:22px; }\n  .headline {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:112px;\n    line-height:0.94;\n    letter-spacing:-0.03em;\n    margin-top:32px;\n    color:#fff;\n    z-index:2;\n  }\n  .headline em {\n    font-style:normal;\n    background: linear-gradient(90deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-family:'DM Sans', sans-serif;\n    font-size:30px;\n    color:#8FA3B8;\n    margin-top:26px;\n    line-height:1.4;\n    max-width:940px;\n    z-index:2;\n  }\n  .panel {\n    margin-top:36px;\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:26px;\n    padding:38px 40px;\n    z-index:2;\n    flex:1;\n    display:flex; flex-direction:column;\n    gap:24px;\n  }\n  .stat-row {\n    display:flex; align-items:center; justify-content:space-between;\n    gap:24px;\n  }\n  .big-stat {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:88px;\n    letter-spacing:-0.03em;\n    background: linear-gradient(90deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    line-height:1;\n  }\n  .big-stat-label {\n    font-family:'JetBrains Mono', monospace;\n    font-size:20px;\n    color:#8FA3B8;\n    text-transform:uppercase;\n    letter-spacing:0.08em;\n    margin-top:10px;\n  }\n  .compare {\n    display:grid;\n    grid-template-columns: 1fr 1fr;\n    gap:18px;\n  }\n  .col {\n    border-radius:16px;\n    padding:26px 22px;\n  }\n  .col.bad {\n    background:rgba(239,68,68,0.08);\n    border:1px solid rgba(239,68,68,0.3);\n  }\n  .col.good {\n    background:rgba(0,212,255,0.08);\n    border:1px solid rgba(0,212,255,0.3);\n  }\n  .col-title {\n    font-family:'JetBrains Mono', monospace;\n    font-size:20px;\n    text-transform:uppercase;\n    letter-spacing:0.1em;\n    margin-bottom:18px;\n    font-weight:500;\n  }\n  .col.bad .col-title { color:#FF7B7B; }\n  .col.good .col-title { color:#00D4FF; }\n  .tool-row {\n    display:flex; align-items:center; gap:14px;\n    font-family:'DM Sans', sans-serif;\n    font-size:24px;\n    font-weight:500;\n    color:#E0E8F0;\n    padding:10px 0;\n  }\n  .tool-icon {\n    width:44px; height:44px;\n    border-radius:10px;\n    display:flex; align-items:center; justify-content:center;\n    flex-shrink:0;\n    font-size:24px;\n  }\n  .tool-icon.zapier { background:#FF4A00; color:#fff; font-weight:900; font-family:'Outfit'; }\n  .tool-icon.sheets { background:#0F9D58; color:#fff; font-weight:900; font-family:'Outfit'; }\n  .tool-icon.gpt { background:#10A37F; color:#fff; }\n  .tool-icon.mail { background:rgba(239,68,68,0.2); border:1px solid rgba(239,68,68,0.4); }\n  .tool-icon.n8n { background:#EA4B71; color:#fff; font-weight:900; font-family:'Outfit'; }\n  .tool-icon.ghl { background:#112240; border:1px solid rgba(0,212,255,0.3); color:#F59E0B; font-weight:900; font-family:'Outfit'; }\n  .tool-icon.claude { background:#D97757; color:#fff; }\n  .tool-icon.loop { background:rgba(0,212,255,0.15); border:1px solid rgba(0,212,255,0.4); }\n  .lesson {\n    display:flex; align-items:center; gap:22px;\n    background:linear-gradient(90deg, rgba(0,212,255,0.15), rgba(0,212,255,0.03));\n    border-left:4px solid #00D4FF;\n    padding:24px 28px;\n    border-radius:14px;\n  }\n  .lesson-num {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:64px;\n    background: linear-gradient(90deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    line-height:1;\n    flex-shrink:0;\n  }\n  .lesson-text {\n    font-family:'Outfit', sans-serif;\n    font-weight:700;\n    font-size:28px;\n    color:#fff;\n    line-height:1.25;\n  }\n  .lesson-text span { color:#8FA3B8; font-weight:400; font-size:22px; display:block; margin-top:6px; }\n  .footer {\n    display:flex; align-items:center; justify-content:space-between;\n    margin-top:32px;\n    z-index:2;\n  }\n  .cta {\n    display:inline-flex; align-items:center; gap:14px;\n    padding:20px 34px;\n    background:linear-gradient(90deg, rgba(0,212,255,0.15), rgba(51,225,255,0.08));\n    border:1.5px solid #00D4FF;\n    border-radius:100px;\n    font-family:'DM Sans', sans-serif;\n    font-size:26px;\n    font-weight:500;\n    color:#fff;\n  }\n  .cta-dot { width:12px; height:12px; border-radius:50%; background:#00D4FF; box-shadow:0 0 14px #00D4FF; }\n  .logo {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:38px;\n    letter-spacing:-0.02em;\n    background: linear-gradient(90deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  #export {\n    padding:14px 28px;\n    background:#00D4FF; color:#0B1929;\n    border:none; border-radius:8px;\n    font-family:'DM Sans'; font-weight:500; font-size:16px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n  <symbol id=\"icon-bolt\" viewBox=\"0 0 24 24\">\n    <path fill=\"currentColor\" d=\"M13 2L3 14h7l-1 8 10-12h-7l1-8z\"/>\n  </symbol>\n  <symbol id=\"icon-mail\" viewBox=\"0 0 24 24\">\n    <path fill=\"none\" stroke=\"#FF7B7B\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 6h18v12H3z M3 6l9 7 9-7\"/>\n  </symbol>\n  <symbol id=\"icon-loop\" viewBox=\"0 0 24 24\">\n    <path fill=\"none\" stroke=\"#00D4FF\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17 2l4 4-4 4 M3 12v-1a5 5 0 015-5h13 M7 22l-4-4 4-4 M21 12v1a5 5 0 01-5 5H3\"/>\n  </symbol>\n  <symbol id=\"icon-gpt\" viewBox=\"0 0 24 24\">\n    <path fill=\"currentColor\" d=\"M12 2a5 5 0 00-4.9 6.06A5 5 0 004 15a5 5 0 006.94 4.62A5 5 0 0020 15a5 5 0 00-3.1-4.94A5 5 0 0012 2zm0 3.5l5 2.9v5.2L12 16.5 7 13.6V8.4z\"/>\n  </symbol>\n  <symbol id=\"icon-claude\" viewBox=\"0 0 24 24\">\n    <path fill=\"currentColor\" d=\"M7 4h3l3 8-3 8H7l3-8zm7 0h3l3 8-3 8h-3l3-8z\"/>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"glow-tl\"></div>\n  <div class=\"glow-br\"></div>\n  <div class=\"dot-grid\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge\">\n    <svg viewBox=\"0 0 100 100\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n    AI Automation\n  </div>\n\n  <h1 class=\"headline\">DIY automation<br>always <em>breaks</em>.</h1>\n  <p class=\"subtitle\">He spent 6 months and £4,200 building an automation that broke every Tuesday.</p>\n\n  <div class=\"panel\">\n\n    <div class=\"stat-row\">\n      <div>\n        <div class=\"big-stat\">£4,200</div>\n        <div class=\"big-stat-label\">Sunk cost · DIY stack</div>\n      </div>\n      <div style=\"text-align:right;\">\n        <div class=\"big-stat\">6 mo</div>\n        <div class=\"big-stat-label\">Before it collapsed</div>\n      </div>\n    </div>\n\n    <div class=\"compare\">\n      <div class=\"col bad\">\n        <div class=\"col-title\">✗ The duct-tape stack</div>\n        <div class=\"tool-row\"><div class=\"tool-icon zapier\">Z</div>Zapier (14 zaps)</div>\n        <div class=\"tool-row\"><div class=\"tool-icon sheets\">S</div>Sheets as database</div>\n        <div class=\"tool-row\"><div class=\"tool-icon gpt\"><svg width=\"24\" height=\"24\"><use href=\"#icon-gpt\"/></svg></div>ChatGPT copy-paste</div>\n        <div class=\"tool-row\"><div class=\"tool-icon mail\"><svg width=\"24\" height=\"24\"><use href=\"#icon-mail\"/></svg></div>Manual triggers</div>\n      </div>\n      <div class=\"col good\">\n        <div class=\"col-title\">✓ What replaced it</div>\n        <div class=\"tool-row\"><div class=\"tool-icon n8n\">n8</div>n8n workflows</div>\n        <div class=\"tool-row\"><div class=\"tool-icon ghl\">HL</div>GoHighLevel CRM</div>\n        <div class=\"tool-row\"><div class=\"tool-icon claude\"><svg width=\"24\" height=\"24\"><use href=\"#icon-claude\"/></svg></div>Claude API</div>\n        <div class=\"tool-row\"><div class=\"tool-icon loop\"><svg width=\"24\" height=\"24\"><use href=\"#icon-loop\"/></svg></div>One clean pipeline</div>\n      </div>\n    </div>\n\n    <div class=\"lesson\">\n      <div class=\"lesson-num\">01</div>\n      <div class=\"lesson-text\">Cheap automation is the most expensive kind.<span>Every Tuesday cost him a client.</span></div>\n    </div>\n\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta\"><span class=\"cta-dot\"></span>Sound familiar?</div>\n    <div class=\"logo\">Accelod</div>\n  </div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\ndocument.getElementById('export').addEventListener('click', () => {\n  const node = document.getElementById('post');\n  domtoimage.toPng(node, { width:1080, height:1350, quality:1, scale:1 })\n    .then(dataUrl => {\n      const link = document.createElement('a');\n      link.download = 'accelod-diy-broke.png';\n      link.href = dataUrl;\n      link.click();\n    });\n});\n</script>\n</body>\n</html>",
  "fb_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod - DIY Automation Post</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body { background:#1a1a1a; display:flex; flex-direction:column; align-items:center; padding:20px; font-family:'DM Sans',sans-serif; gap:16px; }\n  #post {\n    width:1200px; height:630px;\n    background:#0B1929;\n    position:relative;\n    overflow:hidden;\n    display:flex;\n    font-family:'DM Sans',sans-serif;\n  }\n  .dot-grid {\n    position:absolute; inset:0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 28px 28px;\n    pointer-events:none;\n  }\n  .glow {\n    position:absolute; top:-200px; left:-200px;\n    width:700px; height:700px;\n    background:radial-gradient(circle, rgba(0,212,255,0.18), transparent 70%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute; top:-80px; right:-80px;\n    width:460px; height:460px;\n    opacity:0.06;\n    transform:rotate(12deg);\n    pointer-events:none;\n  }\n  .left {\n    width:480px;\n    padding:44px 32px 40px 44px;\n    display:flex; flex-direction:column;\n    position:relative; z-index:2;\n  }\n  .badge {\n    display:inline-flex; align-items:center; gap:8px;\n    padding:9px 16px;\n    border:1px solid rgba(0,212,255,0.5);\n    border-radius:100px;\n    font-family:'JetBrains Mono',monospace;\n    font-size:15px; color:#00D4FF;\n    width:fit-content;\n    margin-bottom:26px;\n  }\n  .badge svg { width:16px; height:16px; }\n  .headline {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:76px;\n    line-height:0.95;\n    letter-spacing:-0.03em;\n    color:#fff;\n    margin-bottom:22px;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-size:19px;\n    color:rgba(255,255,255,0.7);\n    line-height:1.45;\n    margin-bottom:28px;\n  }\n  .cta {\n    display:inline-flex; align-items:center; gap:8px;\n    padding:13px 22px;\n    background:rgba(0,212,255,0.1);\n    border:1px solid rgba(0,212,255,0.4);\n    border-radius:100px;\n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-size:16px;\n    width:fit-content;\n    margin-bottom:auto;\n  }\n  .logo {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:30px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    letter-spacing:-0.02em;\n    margin-top:24px;\n  }\n  .right {\n    flex:1;\n    padding:32px 32px 32px 8px;\n    position:relative; z-index:2;\n    display:flex; flex-direction:column;\n  }\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:22px;\n    flex:1;\n    display:flex; flex-direction:column;\n    gap:11px;\n  }\n  .panel-title {\n    font-family:'JetBrains Mono',monospace;\n    font-size:14px;\n    color:rgba(255,255,255,0.6);\n    text-transform:uppercase;\n    letter-spacing:0.08em;\n    margin-bottom:2px;\n  }\n  .stat-row {\n    display:flex; align-items:center; gap:16px;\n    padding:13px 16px;\n    background:rgba(239,68,68,0.08);\n    border-left:3px solid #EF4444;\n    border-radius:8px;\n  }\n  .stat-row.good {\n    background:rgba(0,212,255,0.08);\n    border-left-color:#00D4FF;\n  }\n  .stat-num {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:44px;\n    line-height:1;\n    color:#EF4444;\n    min-width:115px;\n  }\n  .stat-num.cyan {\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .stat-label {\n    font-size:16px;\n    color:rgba(255,255,255,0.88);\n    line-height:1.3;\n  }\n  .stat-label b { color:#fff; font-weight:700; }\n  .divider {\n    display:flex; align-items:center; gap:12px;\n    margin:2px 0;\n  }\n  .divider-line {\n    flex:1; height:1px;\n    background:linear-gradient(90deg,transparent,rgba(0,212,255,0.4),transparent);\n  }\n  .divider-label {\n    font-family:'JetBrains Mono',monospace;\n    font-size:13px;\n    color:#00D4FF;\n    letter-spacing:0.1em;\n  }\n  .stack-row {\n    display:flex; align-items:center; gap:10px;\n    padding:11px 12px;\n    background:rgba(255,255,255,0.04);\n    border:1px solid rgba(0,212,255,0.12);\n    border-radius:8px;\n  }\n  .stack-icon {\n    width:30px; height:30px;\n    display:flex; align-items:center; justify-content:center;\n    flex-shrink:0;\n    border-radius:6px;\n  }\n  .stack-icon svg { width:100%; height:100%; }\n  .stack-name {\n    font-family:'JetBrains Mono',monospace;\n    font-size:14px;\n    color:#fff;\n    font-weight:500;\n  }\n  .stack-grid {\n    display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px;\n  }\n  #export {\n    padding:12px 24px;\n    background:#00D4FF; color:#0B1929;\n    border:none; border-radius:8px;\n    font-family:'JetBrains Mono',monospace;\n    font-weight:500; cursor:pointer;\n    font-size:14px;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\"/>\n      <rect x=\"0\" y=\"48\" width=\"100\" height=\"4\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(45 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(15 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(75 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(105 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(135 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(150 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(165 50 50)\"/>\n    </g>\n  </symbol>\n  <symbol id=\"icon-n8n\" viewBox=\"0 0 100 100\">\n    <circle cx=\"50\" cy=\"50\" r=\"48\" fill=\"#1a1a1a\"/>\n    <circle cx=\"28\" cy=\"50\" r=\"10\" fill=\"#EA4B71\"/>\n    <circle cx=\"72\" cy=\"35\" r=\"10\" fill=\"#EA4B71\"/>\n    <circle cx=\"72\" cy=\"65\" r=\"10\" fill=\"#EA4B71\"/>\n    <path d=\"M35 50 L65 35 M35 50 L65 65\" stroke=\"#EA4B71\" stroke-width=\"4\" fill=\"none\"/>\n  </symbol>\n  <symbol id=\"icon-ghl\" viewBox=\"0 0 100 100\">\n    <circle cx=\"50\" cy=\"50\" r=\"48\" fill=\"#0F3B5C\"/>\n    <path d=\"M30 68 L30 48 L24 48 L36 24 L48 48 L42 48 L42 68 Z\" fill=\"#F59E0B\"/>\n    <path d=\"M56 72 L56 44 L49 44 L61 20 L73 44 L66 44 L66 72 Z\" fill=\"#3B82F6\"/>\n  </symbol>\n  <symbol id=\"icon-claude\" viewBox=\"0 0 100 100\">\n    <circle cx=\"50\" cy=\"50\" r=\"48\" fill=\"#D97757\"/>\n    <path d=\"M35 30 L28 70 L34 70 L36 62 L48 62 L50 70 L56 70 L48 30 Z M38 55 L42 40 L46 55 Z\" fill=\"#fff\"/>\n    <path d=\"M60 30 L52 70 L58 70 L60 62 L72 62 L74 70 L80 70 L72 30 Z M62 55 L66 40 L70 55 Z\" fill=\"#fff\"/>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <svg viewBox=\"0 0 100 100\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n    <div class=\"headline\">6 months.<br>£4,200.<br>Broke every <em>Tuesday.</em></div>\n    <div class=\"subtitle\">A real client's DIY Zapier + spreadsheet + ChatGPT stack — and what replaced it in 9 days.</div>\n    <div class=\"cta\">💭 Sound familiar?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n\n      <div class=\"panel-title\">❌ The DIY duct-tape stack</div>\n\n      <div class=\"stat-row\">\n        <div class=\"stat-num\">47</div>\n        <div class=\"stat-label\"><b>Zaps chained together</b><br>Each one a single point of failure</div>\n      </div>\n\n      <div class=\"stat-row\">\n        <div class=\"stat-num\">£350</div>\n        <div class=\"stat-label\"><b>Monthly SaaS bill</b><br>Zapier + Sheets addons + ChatGPT × 3</div>\n      </div>\n\n      <div class=\"stat-row\">\n        <div class=\"stat-num\">9hrs</div>\n        <div class=\"stat-label\"><b>Lost every Tuesday</b><br>Manually fixing what broke overnight</div>\n      </div>\n\n      <div class=\"divider\">\n        <div class=\"divider-line\"></div>\n        <div class=\"divider-label\">✓ REPLACED WITH</div>\n        <div class=\"divider-line\"></div>\n      </div>\n\n      <div class=\"stack-grid\">\n        <div class=\"stack-row\">\n          <div class=\"stack-icon\"><svg><use href=\"#icon-n8n\"/></svg></div>\n          <span class=\"stack-name\">n8n</span>\n        </div>\n        <div class=\"stack-row\">\n          <div class=\"stack-icon\"><svg><use href=\"#icon-ghl\"/></svg></div>\n          <span class=\"stack-name\">GoHighLevel</span>\n        </div>\n        <div class=\"stack-row\">\n          <div class=\"stack-icon\"><svg><use href=\"#icon-claude\"/></svg></div>\n          <span class=\"stack-name\">Claude</span>\n        </div>\n      </div>\n\n      <div class=\"stat-row good\">\n        <div class=\"stat-num cyan\">0</div>\n        <div class=\"stat-label\"><b>Tuesday breakdowns since.</b><br>Cheap automation is the most expensive kind.</div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1200, height:630, quality:1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-diy-automation.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>"
}