  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI - 4 Tool Stack</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    background:#0a0a0a;\n    min-height:100vh;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    padding:40px;\n    font-family:'DM Sans',sans-serif;\n    gap:20px;\n  }\n  #post {\n    width:1080px;\n    height:1350px;\n    background:#0B1929;\n    position:relative;\n    overflow:hidden;\n    padding:80px 70px;\n    display:flex;\n    flex-direction:column;\n  }\n  .dot-grid {\n    position:absolute;\n    inset:0;\n    background-image:radial-gradient(rgba(0,212,255,0.12) 1.2px, transparent 1.2px);\n    background-size:28px 28px;\n    opacity:0.5;\n    pointer-events:none;\n  }\n  .glow {\n    position:absolute;\n    top:-200px;\n    left:-200px;\n    width:700px;\n    height:700px;\n    background:radial-gradient(circle, rgba(0,212,255,0.22), transparent 65%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute;\n    top:-80px;\n    right:-80px;\n    width:520px;\n    height:520px;\n    opacity:0.05;\n    transform:rotate(12deg);\n    pointer-events:none;\n  }\n  .content {\n    position:relative;\n    z-index:2;\n    display:flex;\n    flex-direction:column;\n    height:100%;\n  }\n  .badge {\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    padding:12px 22px;\n    border:1.5px solid rgba(0,212,255,0.5);\n    border-radius:100px;\n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-weight:500;\n    font-size:20px;\n    align-self:flex-start;\n    background:rgba(0,212,255,0.05);\n  }\n  .badge svg { width:18px; height:18px; }\n  .headline {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:88px;\n    line-height:0.95;\n    color:#fff;\n    margin-top:28px;\n    letter-spacing:-2px;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-family:'DM Sans',sans-serif;\n    font-weight:400;\n    font-size:24px;\n    color:rgba(255,255,255,0.7);\n    margin-top:22px;\n    line-height:1.4;\n    max-width:900px;\n  }\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:38px 40px;\n    margin-top:32px;\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    gap:18px;\n  }\n  .tool-row {\n    display:flex;\n    align-items:center;\n    gap:22px;\n    padding:16px 20px;\n    background:rgba(0,212,255,0.04);\n    border-radius:12px;\n    border-left:3px solid #00D4FF;\n  }\n  .tool-name {\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:28px;\n    color:#fff;\n    min-width:230px;\n  }\n  .arrow {\n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-size:22px;\n    font-weight:500;\n  }\n  .role {\n    font-family:'DM Sans',sans-serif;\n    font-size:22px;\n    color:rgba(255,255,255,0.85);\n    font-weight:500;\n  }\n  .role strong {\n    color:#33E1FF;\n    font-weight:500;\n  }\n  .divider {\n    height:1px;\n    background:linear-gradient(90deg, transparent, rgba(0,212,255,0.3), transparent);\n    margin:8px 0;\n  }\n  .stat-line {\n    font-family:'JetBrains Mono',monospace;\n    font-size:20px;\n    color:rgba(255,255,255,0.6);\n    text-align:center;\n    margin-top:6px;\n  }\n  .stat-line span {\n    color:#00D4FF;\n    font-weight:500;\n  }\n  .footer {\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    margin-top:32px;\n  }\n  .cta-pill {\n    display:inline-flex;\n    align-items:center;\n    gap:12px;\n    padding:20px 32px;\n    background:rgba(0,212,255,0.1);\n    border:1.5px solid rgba(0,212,255,0.5);\n    border-radius:100px;\n    color:#fff;\n    font-family:'DM Sans',sans-serif;\n    font-weight:500;\n    font-size:24px;\n  }\n  .cta-pill::before {\n    content:'';\n    width:10px;\n    height:10px;\n    background:#00D4FF;\n    border-radius:50%;\n    box-shadow:0 0 12px #00D4FF;\n  }\n  .logo {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:32px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    letter-spacing:-0.5px;\n  }\n  #export-btn {\n    padding:14px 28px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    color:#0B1929;\n    border:none;\n    border-radius:8px;\n    font-family:'DM Sans',sans-serif;\n    font-weight:500;\n    font-size:15px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <!-- 12 spokes -->\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\"/>\n      <path d=\"M24,-41.6 L6.9,-4.6 L2.6,-7.4 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"content\">\n    <div class=\"badge\">\n      <svg><use href=\"#claude-star\"/></svg>\n      AI AUTOMATION\n    </div>\n\n    <h1 class=\"headline\">Most owners use 27 tools.<br>I use <em>4</em>.</h1>\n\n    <p class=\"subtitle\">Here's the exact stack running 90% of my daily operations — and why mine outperform yours.</p>\n\n    <div class=\"panel\">\n      <div class=\"tool-row\">\n        <div class=\"tool-name\">Claude AI</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"role\">The <strong>brain</strong> — thinking, writing, deciding</div>\n      </div>\n      <div class=\"tool-row\">\n        <div class=\"tool-name\">N8N</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"role\">The <strong>nervous system</strong> — signals between tools</div>\n      </div>\n      <div class=\"tool-row\">\n        <div class=\"tool-name\">GoHighLevel</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"role\">The <strong>mouth</strong> — client comms &amp; CRM</div>\n      </div>\n      <div class=\"tool-row\">\n        <div class=\"tool-name\">Google Workspace</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"role\">The <strong>memory</strong> — docs, data, storage</div>\n      </div>\n\n      <div class=\"divider\"></div>\n      <div class=\"stat-line\">Audit your stack. Count the tools. <span>How many do you actually need?</span></div>\n    </div>\n\n    <div class=\"footer\">\n      <div class=\"cta-pill\">How many are you running?</div>\n      <div class=\"logo\">Accelod</div>\n    </div>\n  </div>\n</div>\n\n<button id=\"export-btn\" onclick=\"exportPNG()\">Export PNG</button>\n\n<script>\n  function exportPNG() {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1080, height:1350, quality:1, bgcolor:'#0B1929' })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-4tool-stack.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  }\n</script>\n</body>\n</html>",
