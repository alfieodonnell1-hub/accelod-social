  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI - 4 Tool Stack</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    background:#0a0a0a;\n    min-height:100vh;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    padding:40px;\n    font-family:'DM Sans',sans-serif;\n    gap:20px;\n  }\n  #post {\n    width:1080px;\n    height:1350px;\n    background:#0B1929;\n    position:relative;\n    overflow:hidden;\n    padding:70px 60px;\n    display:flex;\n    flex-direction:column;\n  }\n  .dot-grid {\n    position:absolute;\n    inset:0;\n    background-image:radial-gradient(rgba(0,212,255,0.12) 1.2px, transparent 1.2px);\n    background-size:28px 28px;\n    opacity:0.5;\n    pointer-events:none;\n  }\n  .glow {\n    position:absolute;\n    top:-200px;\n    left:-200px;\n    width:700px;\n    height:700px;\n    background:radial-gradient(circle, rgba(0,212,255,0.22), transparent 65%);\n    pointer-events:none;\n  }\n  .glow2 {\n    position:absolute;\n    bottom:-250px;\n    right:-150px;\n    width:600px;\n    height:600px;\n    background:radial-gradient(circle, rgba(51,225,255,0.15), transparent 65%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute;\n    top:-80px;\n    right:-80px;\n    width:520px;\n    height:520px;\n    opacity:0.05;\n    transform:rotate(12deg);\n    pointer-events:none;\n  }\n  .content {\n    position:relative;\n    z-index:2;\n    display:flex;\n    flex-direction:column;\n    height:100%;\n  }\n  .top-row {\n    display:flex;\n    align-items:center;\n    gap:14px;\n    flex-wrap:wrap;\n  }\n  .badge {\n    display:inline-flex;\n    align-items:center;\n    gap:12px;\n    padding:14px 26px;\n    border:1.5px solid rgba(0,212,255,0.5);\n    border-radius:100px;\n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-weight:500;\n    font-size:24px;\n    background:rgba(0,212,255,0.05);\n  }\n  .badge svg { width:22px; height:22px; }\n  .mini-badge {\n    display:inline-flex;\n    align-items:center;\n    gap:8px;\n    padding:14px 22px;\n    border:1.5px solid rgba(0,212,255,0.3);\n    border-radius:100px;\n    color:rgba(255,255,255,0.85);\n    font-family:'JetBrains Mono',monospace;\n    font-weight:500;\n    font-size:20px;\n    background:rgba(255,255,255,0.03);\n  }\n  .mini-badge .dot {\n    width:10px;\n    height:10px;\n    border-radius:50%;\n    background:#00D4FF;\n    box-shadow:0 0 10px #00D4FF;\n  }\n  .headline {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:104px;\n    line-height:0.95;\n    color:#fff;\n    margin-top:26px;\n    letter-spacing:-2.5px;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-family:'DM Sans',sans-serif;\n    font-weight:400;\n    font-size:30px;\n    color:rgba(255,255,255,0.75);\n    margin-top:22px;\n    line-height:1.35;\n    max-width:960px;\n  }\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:20px;\n    padding:32px 34px;\n    margin-top:26px;\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    gap:18px;\n  }\n  .tool-row {\n    display:flex;\n    align-items:center;\n    gap:22px;\n    padding:20px 24px;\n    background:rgba(0,212,255,0.04);\n    border-radius:14px;\n    border-left:4px solid #00D4FF;\n  }\n  .tool-icon {\n    width:64px;\n    height:64px;\n    border-radius:14px;\n    background:#fff;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    flex-shrink:0;\n    box-shadow:0 4px 16px rgba(0,212,255,0.15);\n    overflow:hidden;\n  }\n  .tool-icon svg { width:44px; height:44px; }\n  .tool-icon.claude { background:#D97757; }\n  .tool-icon.n8n { background:#EA4B71; }\n  .tool-icon.ghl { background:#141B34; border:1px solid rgba(0,212,255,0.4); }\n  .tool-icon.google { background:#fff; }\n  .tool-name {\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:34px;\n    color:#fff;\n    min-width:270px;\n  }\n  .arrow {\n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-size:28px;\n    font-weight:500;\n  }\n  .role {\n    font-family:'DM Sans',sans-serif;\n    font-size:26px;\n    color:rgba(255,255,255,0.9);\n    font-weight:500;\n    line-height:1.25;\n  }\n  .role strong {\n    color:#33E1FF;\n    font-weight:500;\n  }\n  .divider {\n    height:1px;\n    background:linear-gradient(90deg, transparent, rgba(0,212,255,0.3), transparent);\n    margin:4px 0;\n  }\n  .stat-line {\n    font-family:'JetBrains Mono',monospace;\n    font-size:24px;\n    color:rgba(255,255,255,0.7);\n    text-align:center;\n    margin-top:2px;\n    line-height:1.35;\n  }\n  .stat-line span {\n    color:#00D4FF;\n    font-weight:500;\n  }\n  .footer {\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    margin-top:26px;\n    gap:20px;\n  }\n  .cta-pill {\n    display:inline-flex;\n    align-items:center;\n    gap:14px;\n    padding:22px 34px;\n    background:rgba(0,212,255,0.1);\n    border:1.5px solid rgba(0,212,255,0.5);\n    border-radius:100px;\n    color:#fff;\n    font-family:'DM Sans',sans-serif;\n    font-weight:500;\n    font-size:28px;\n  }\n  .cta-pill::before {\n    content:'';\n    width:12px;\n    height:12px;\n    background:#00D4FF;\n    border-radius:50%;\n    box-shadow:0 0 14px #00D4FF;\n  }\n  .logo {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:42px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    letter-spacing:-0.5px;\n  }\n  #export-btn {\n    padding:14px 28px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    color:#0B1929;\n    border:none;\n    border-radius:8px;\n    font-family:'DM Sans',sans-serif;\n    font-weight:500;\n    font-size:15px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\"/>\n      <path d=\"M24,-41.6 L6.9,-4.6 L2.6,-7.4 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n\n  <!-- N8N logo mark -->\n  <symbol id=\"n8n-logo\" viewBox=\"0 0 100 100\">\n    <g fill=\"#fff\">\n      <circle cx=\"20\" cy=\"50\" r=\"10\"/>\n      <circle cx=\"50\" cy=\"30\" r=\"10\"/>\n      <circle cx=\"50\" cy=\"70\" r=\"10\"/>\n      <circle cx=\"80\" cy=\"50\" r=\"10\"/>\n      <rect x=\"20\" y=\"46\" width=\"60\" height=\"8\"/>\n      <rect x=\"46\" y=\"30\" width=\"8\" height=\"40\"/>\n    </g>\n  </symbol>\n\n  <!-- GoHighLevel mark -->\n  <symbol id=\"ghl-logo\" viewBox=\"0 0 100 100\">\n    <g fill=\"#00D4FF\">\n      <path d=\"M20 70 L20 30 L30 30 L30 55 L50 30 L62 30 L42 55 L64 70 L50 70 L32 58 L30 60 L30 70 Z\"/>\n      <circle cx=\"75\" cy=\"35\" r=\"6\"/>\n      <rect x=\"70\" y=\"45\" width=\"10\" height=\"25\"/>\n    </g>\n  </symbol>\n\n  <!-- Google G -->\n  <symbol id=\"google-logo\" viewBox=\"0 0 48 48\">\n    <path fill=\"#EA4335\" d=\"M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z\"/>\n    <path fill=\"#4285F4\" d=\"M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z\"/>\n    <path fill=\"#FBBC05\" d=\"M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z\"/>\n    <path fill=\"#34A853\" d=\"M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z\"/>\n  </symbol>\n\n  <!-- Claude spark -->\n  <symbol id=\"claude-mark\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"#fff\">\n      <path d=\"M0,-40 L3,-6 L-3,-6 Z\"/>\n      <path d=\"M0,-40 L3,-6 L-3,-6 Z\" transform=\"rotate(45)\"/>\n      <path d=\"M0,-40 L3,-6 L-3,-6 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-40 L3,-6 L-3,-6 Z\" transform=\"rotate(135)\"/>\n      <path d=\"M0,-40 L3,-6 L-3,-6 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-40 L3,-6 L-3,-6 Z\" transform=\"rotate(225)\"/>\n      <path d=\"M0,-40 L3,-6 L-3,-6 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-40 L3,-6 L-3,-6 Z\" transform=\"rotate(315)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <div class=\"glow2\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"content\">\n    <div class=\"top-row\">\n      <div class=\"badge\">\n        <svg><use href=\"#claude-star\"/></svg>\n        AI AUTOMATION\n      </div>\n      <div class=\"mini-badge\"><span class=\"dot\"></span>THE STACK</div>\n    </div>\n\n    <h1 class=\"headline\">Most owners use 27 tools.<br>I use <em>4</em>.</h1>\n\n    <p class=\"subtitle\">Here's the exact stack running 90% of my daily operations — and why mine outperform yours.</p>\n\n    <div class=\"panel\">\n      <div class=\"tool-row\">\n        <div class=\"tool-icon claude\"><svg viewBox=\"-50 -50 100 100\"><use href=\"#claude-mark\"/></svg></div>\n        <div class=\"tool-name\">Claude AI</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"role\">The <strong>brain</strong> — thinking, writing, deciding</div>\n      </div>\n      <div class=\"tool-row\">\n        <div class=\"tool-icon n8n\"><svg viewBox=\"0 0 100 100\"><use href=\"#n8n-logo\"/></svg></div>\n        <div class=\"tool-name\">N8N</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"role\">The <strong>nervous system</strong> — signals between tools</div>\n      </div>\n      <div class=\"tool-row\">\n        <div class=\"tool-icon ghl\"><svg viewBox=\"0 0 100 100\"><use href=\"#ghl-logo\"/></svg></div>\n        <div class=\"tool-name\">GoHighLevel</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"role\">The <strong>mouth</strong> — client comms &amp; CRM</div>\n      </div>\n      <div class=\"tool-row\">\n        <div class=\"tool-icon google\"><svg viewBox=\"0 0 48 48\"><use href=\"#google-logo\"/></svg></div>\n        <div class=\"tool-name\">Google Workspace</div>\n        <div class=\"arrow\">→</div>\n        <div class=\"role\">The <strong>memory</strong> — docs, data, storage</div>\n      </div>\n\n      <div class=\"divider\"></div>\n      <div class=\"stat-line\">Audit your stack. Count the tools.<br><span>How many do you actually need?</span></div>\n    </div>\n\n    <div class=\"footer\">\n      <div class=\"cta-pill\">How many are you running?</div>\n      <div class=\"logo\">Accelod</div>\n    </div>\n  </div>\n</div>\n\n<button id=\"export-btn\" onclick=\"exportPNG()\">Export PNG</button>\n\n<script>\n  function exportPNG() {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1080, height:1350, quality:1, bgcolor:'#0B1929' })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-4tool-stack.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  }\n</script>\n</body>\n</html>",
  "fb_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI — 4-Tool Stack</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/dom-to-image-more/3.3.0/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    background:#1a1a1a;\n    min-height:100vh;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    padding:40px;\n    font-family:'DM Sans', sans-serif;\n    gap:20px;\n  }\n  #post {\n    width:1200px;\n    height:630px;\n    background:#0B1929;\n    position:relative;\n    overflow:hidden;\n    display:flex;\n    font-family:'DM Sans', sans-serif;\n  }\n  .dot-grid {\n    position:absolute;\n    inset:0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 24px 24px;\n    pointer-events:none;\n  }\n  .glow {\n    position:absolute;\n    top:-200px;\n    left:-200px;\n    width:600px;\n    height:600px;\n    background: radial-gradient(circle, rgba(0,212,255,0.18) 0%, transparent 60%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute;\n    top:-80px;\n    right:-80px;\n    width:420px;\n    height:420px;\n    opacity:0.05;\n    transform:rotate(12deg);\n    pointer-events:none;\n  }\n  .left-col {\n    width:430px;\n    padding:40px 28px 40px 36px;\n    display:flex;\n    flex-direction:column;\n    position:relative;\n    z-index:2;\n  }\n  .badge {\n    display:inline-flex;\n    align-items:center;\n    gap:8px;\n    padding:9px 18px;\n    border:1px solid #00D4FF;\n    border-radius:999px;\n    font-family:'JetBrains Mono', monospace;\n    font-size:15px;\n    font-weight:700;\n    color:#00D4FF;\n    align-self:flex-start;\n    letter-spacing:0.5px;\n  }\n  .badge svg { width:16px; height:16px; }\n  .headline {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:72px;\n    line-height:0.94;\n    color:#fff;\n    margin-top:20px;\n    letter-spacing:-2px;\n  }\n  .headline em {\n    font-style:normal;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-family:'DM Sans', sans-serif;\n    font-size:24px;\n    font-weight:500;\n    color:rgba(255,255,255,0.85);\n    margin-top:18px;\n    line-height:1.35;\n  }\n  .cta-pill {\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    padding:14px 22px;\n    background:rgba(0,212,255,0.12);\n    border:1px solid rgba(0,212,255,0.45);\n    border-radius:999px;\n    color:#33E1FF;\n    font-size:16px;\n    font-weight:700;\n    font-family:'JetBrains Mono', monospace;\n    margin-top:auto;\n    align-self:flex-start;\n  }\n  .cta-pill::before {\n    content:'';\n    width:10px; height:10px;\n    background:#00D4FF;\n    border-radius:50%;\n    box-shadow:0 0 12px #00D4FF;\n  }\n  .logo {\n    margin-top:18px;\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:26px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    letter-spacing:-0.5px;\n  }\n  .right-panel {\n    flex:1;\n    margin:40px 36px 40px 0;\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:30px 32px;\n    position:relative;\n    z-index:2;\n    display:flex;\n    flex-direction:column;\n  }\n  .panel-title {\n    font-family:'JetBrains Mono', monospace;\n    font-size:14px;\n    font-weight:700;\n    color:#00D4FF;\n    letter-spacing:2px;\n    text-transform:uppercase;\n    margin-bottom:14px;\n    display:flex;\n    align-items:center;\n    gap:10px;\n  }\n  .panel-title::after {\n    content:'';\n    flex:1;\n    height:1px;\n    background:linear-gradient(90deg, rgba(0,212,255,0.4), transparent);\n  }\n  .tool-row {\n    display:flex;\n    align-items:center;\n    padding:14px 0;\n    border-bottom:1px solid rgba(0,212,255,0.08);\n    gap:16px;\n  }\n  .tool-row:last-of-type { border-bottom:none; }\n  .tool-num {\n    font-family:'JetBrains Mono', monospace;\n    font-size:16px;\n    font-weight:700;\n    color:rgba(0,212,255,0.6);\n    width:26px;\n  }\n  .tool-icon {\n    width:48px;\n    height:48px;\n    border-radius:10px;\n    background:#0B1929;\n    border:1px solid rgba(0,212,255,0.25);\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    flex-shrink:0;\n    overflow:hidden;\n  }\n  .tool-icon svg { width:32px; height:32px; }\n  .tool-name {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:26px;\n    color:#fff;\n    width:220px;\n    letter-spacing:-0.5px;\n  }\n  .arrow {\n    color:#00D4FF;\n    font-size:22px;\n    font-weight:700;\n  }\n  .tool-role {\n    font-family:'DM Sans', sans-serif;\n    font-size:23px;\n    font-weight:700;\n    color:#33E1FF;\n    flex:1;\n  }\n  .footer-stat {\n    margin-top:auto;\n    padding-top:16px;\n    border-top:1px dashed rgba(0,212,255,0.25);\n    display:flex;\n    align-items:center;\n    gap:16px;\n  }\n  .stat-num {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:46px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    letter-spacing:-1px;\n  }\n  .stat-label {\n    font-size:17px;\n    color:rgba(255,255,255,0.85);\n    font-weight:500;\n    line-height:1.3;\n  }\n  #exportBtn {\n    padding:14px 28px;\n    background:linear-gradient(135deg, #00D4FF, #33E1FF);\n    color:#0B1929;\n    border:none;\n    border-radius:8px;\n    font-family:'Outfit', sans-serif;\n    font-weight:700;\n    font-size:15px;\n    cursor:pointer;\n    letter-spacing:0.5px;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n\n  <!-- Claude icon (orange star) -->\n  <symbol id=\"icon-claude\" viewBox=\"0 0 100 100\">\n    <rect width=\"100\" height=\"100\" rx=\"20\" fill=\"#D97757\"/>\n    <g fill=\"#fff\" transform=\"translate(50,50)\">\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-32 L1.5,-6 L0,-4 L-1.5,-6 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n\n  <!-- n8n icon -->\n  <symbol id=\"icon-n8n\" viewBox=\"0 0 100 100\">\n    <rect width=\"100\" height=\"100\" rx=\"20\" fill=\"#EA4B71\"/>\n    <g fill=\"#fff\">\n      <circle cx=\"25\" cy=\"50\" r=\"8\"/>\n      <circle cx=\"50\" cy=\"35\" r=\"8\"/>\n      <circle cx=\"50\" cy=\"65\" r=\"8\"/>\n      <circle cx=\"75\" cy=\"50\" r=\"8\"/>\n      <rect x=\"25\" y=\"47\" width=\"50\" height=\"6\"/>\n      <rect x=\"47\" y=\"35\" width=\"6\" height=\"30\"/>\n    </g>\n  </symbol>\n\n  <!-- GoHighLevel icon -->\n  <symbol id=\"icon-ghl\" viewBox=\"0 0 100 100\">\n    <rect width=\"100\" height=\"100\" rx=\"20\" fill=\"#141B34\"/>\n    <path d=\"M30 65 L50 30 L70 65 L60 65 L50 48 L40 65 Z\" fill=\"#FFB800\"/>\n  </symbol>\n\n  <!-- Google Workspace icon -->\n  <symbol id=\"icon-google\" viewBox=\"0 0 100 100\">\n    <rect width=\"100\" height=\"100\" rx=\"20\" fill=\"#fff\"/>\n    <path d=\"M75 50c0-2-.2-4-.5-6H50v11h14c-.6 3-2.5 6-5.3 8v6.5h8.5c5-4.6 7.8-11.5 7.8-19.5z\" fill=\"#4285F4\"/>\n    <path d=\"M50 76c7.2 0 13.2-2.4 17.6-6.5l-8.5-6.5c-2.4 1.6-5.4 2.5-9.1 2.5-7 0-13-4.7-15.1-11H26v6.9C30.3 70 39.4 76 50 76z\" fill=\"#34A853\"/>\n    <path d=\"M34.9 54.5c-.5-1.6-.8-3.3-.8-5s.3-3.4.8-5V37.6H26c-1.8 3.6-2.8 7.6-2.8 12s1 8.4 2.8 12l8.9-7.1z\" fill=\"#FBBC05\"/>\n    <path d=\"M50 33.5c4 0 7.5 1.4 10.3 4l7.7-7.7C63.2 25.5 57.2 23 50 23c-10.6 0-19.7 6-24 15l8.9 6.9c2.1-6.3 8.1-11 15.1-11z\" fill=\"#EA4335\"/>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" viewBox=\"-50 -50 100 100\"><use href=\"#claude-star\" style=\"color:#00D4FF\"/></svg>\n\n  <div class=\"left-col\">\n    <div class=\"badge\">\n      <svg viewBox=\"-50 -50 100 100\"><use href=\"#claude-star\" style=\"color:#00D4FF\"/></svg>\n      AI AUTOMATION\n    </div>\n    <h1 class=\"headline\">Most owners use 27 tools.<br>I use <em>4.</em></h1>\n    <p class=\"subtitle\">Here's why mine outperform yours.</p>\n    <div class=\"cta-pill\">Sound familiar?</div>\n    <div class=\"logo\">◆ Accelod AI</div>\n  </div>\n\n  <div class=\"right-panel\">\n    <div class=\"panel-title\">The Stack · 90% of Daily Ops</div>\n\n    <div class=\"tool-row\">\n      <div class=\"tool-num\">01</div>\n      <div class=\"tool-icon\"><svg viewBox=\"0 0 100 100\"><use href=\"#icon-claude\"/></svg></div>\n      <div class=\"tool-name\">Claude AI</div>\n      <div class=\"arrow\">→</div>\n      <div class=\"tool-role\">The Brain</div>\n    </div>\n    <div class=\"tool-row\">\n      <div class=\"tool-num\">02</div>\n      <div class=\"tool-icon\"><svg viewBox=\"0 0 100 100\"><use href=\"#icon-n8n\"/></svg></div>\n      <div class=\"tool-name\">N8N</div>\n      <div class=\"arrow\">→</div>\n      <div class=\"tool-role\">Nervous System</div>\n    </div>\n    <div class=\"tool-row\">\n      <div class=\"tool-num\">03</div>\n      <div class=\"tool-icon\"><svg viewBox=\"0 0 100 100\"><use href=\"#icon-ghl\"/></svg></div>\n      <div class=\"tool-name\">GoHighLevel</div>\n      <div class=\"arrow\">→</div>\n      <div class=\"tool-role\">The Mouth</div>\n    </div>\n    <div class=\"tool-row\">\n      <div class=\"tool-num\">04</div>\n      <div class=\"tool-icon\"><svg viewBox=\"0 0 100 100\"><use href=\"#icon-google\"/></svg></div>\n      <div class=\"tool-name\">Google WS</div>\n      <div class=\"arrow\">→</div>\n      <div class=\"tool-role\">The Memory</div>\n    </div>\n\n    <div class=\"footer-stat\">\n      <div class=\"stat-num\">4 &gt; 27</div>\n      <div class=\"stat-label\">Audit your stack.<br>What can you kill this week?</div>\n    </div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">↓ Export PNG</button>\n\n<script>\ndocument.getElementById('exportBtn').addEventListener('click', function() {\n  const node = document.getElementById('post');\n  domtoimage.toPng(node, { width:1200, height:630, quality:1 })\n    .then(function(dataUrl) {\n      const link = document.createElement('a');\n      link.download = 'accelod-4-tool-stack.png';\n      link.href = dataUrl;\n      link.click();\n    });\n});\n</script>\n</body>\n</html>",
