n  .row {\n    display:flex;\n    align-items:center;\n    gap:18px;\n    padding:12px 14px;\n    background:rgba(0,212,255,0.04);\n    border-left:3px solid #00D4FF;\n    border-radius:6px;\n  }\n  .ts {\n    font-family:'JetBrains Mono',monospace;\n    font-weight:500;\n    font-size:20px;\n    color:#33E1FF;\n    min-width:80px;\n  }\n  .label {\n    font-family:'DM Sans',sans-serif;\n    font-size:20px;\n    color:#fff;\n    flex:1;\n    font-weight:500;\n  }\n  .tool {\n    font-family:'JetBrains Mono',monospace;\n    font-size:13px;\n    color:rgba(255,255,255,0.55);\n    padding:4px 10px;\n    border:1px solid rgba(0,212,255,0.25);\n    border-radius:4px;\n  }\n  .result {\n    margin-top:18px;\n    padding:16px 18px;\n    background:linear-gradient(90deg, rgba(0,212,255,0.15), rgba(0,212,255,0.02));\n    border:1px solid rgba(0,212,255,0.35);\n    border-radius:10px;\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n  }\n  .result-text {\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:22px;\n    color:#fff;\n  }\n  .result-num {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:32px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .logo {\n    position:absolute;\n    bottom:24px;\n    right:32px;\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:22px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    letter-spacing:-0.5px;\n    z-index:3;\n  }\n  .logo-mini {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:18px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    margin-top:16px;\n  }\n  #exportBtn {\n    padding:14px 28px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    color:#0B1929;\n    border:none;\n    border-radius:8px;\n    font-family:'DM Sans',sans-serif;\n    font-weight:500;\n    font-size:15px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <!-- 12 spokes -->\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left-col\">\n    <div class=\"badge\">\n      <svg viewBox=\"-50 -50 100 100\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n    <h1 class=\"headline\">I Automated My <em>Monday</em>.</h1>\n    <p class=\"subtitle\">While you were checking emails, my system closed three deals before 9 AM.</p>\n    <div class=\"cta\">Sound familiar?</div>\n    <div class=\"logo-mini\">accelod<span style=\"color:#33E1FF\">.ai</span></div>\n  </div>\n\n  <div class=\"right-panel\">\n    <div class=\"panel-title\">// Monday Morning Workflow</div>\n    <div class=\"panel-sub\">Zero manual input. Full pipeline.</div>\n\n    <div class=\"timeline\">\n      <div class=\"row\">\n        <div class=\"ts\">06:42</div>\n        <div class=\"label\">Claude drafts 12 personalized proposals</div>\n        <div class=\"tool\">Claude</div>\n      </div>\n      <div class=\"row\">\n        <div class=\"ts\">07:18</div>\n        <div class=\"label\">N8N routes & scores 47 inbound leads</div>\n        <div class=\"tool\">N8N</div>\n      </div>\n      <div class=\"row\">\n        <div class=\"ts\">08:05</div>\n        <div class=\"label\">GoHighLevel books 9 discovery calls</div>\n        <div class=\"tool\">GHL</div>\n      </div>\n      <div class=\"row\">\n        <div class=\"ts\">08:51</div>\n        <div class=\"label\">Calendar synced. Follow-ups queued.</div>\n        <div class=\"tool\">Auto</div>\n      </div>\n    </div>\n\n    <div class=\"result\">\n      <div class=\"result-text\">Deals closed before coffee</div>\n      <div class=\"result-num\">3</div>\n    </div>\n  </div>\n\n  <div class=\"logo\">accelod<span style=\"color:#33E1FF\">.ai</span></div>\n</div>\n\n<button id=\"exportBtn\">Export PNG</button>\n\n<script>\n  document.getElementById('exportBtn').addEventListener('click', function() {\n    domtoimage.toPng(document.getElementById('post'), {\n      width:1200, height:630, quality:1.0,\n      style:{ transform:'scale(1)', transformOrigin:'top left' }\n    }).then(function(dataUrl){\n      var link = document.createElement('a');\n      link.download = 'accelod-monday-automated.png';\n      link.href = dataUrl;\n      link.click();\n    });\n  });\n</script>\n</body>\n</html>",
