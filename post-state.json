t: 18px; }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 62px;\n    line-height: 0.98;\n    letter-spacing: -0.03em;\n    color: white;\n    margin-bottom: 20px;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .subtitle {\n    font-size: 22px;\n    line-height: 1.35;\n    color: #a0b4c5;\n    margin-bottom: auto;\n  }\n  .cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: rgba(0,212,255,0.1);\n    border: 1px solid rgba(0,212,255,0.4);\n    border-radius: 999px;\n    padding: 12px 22px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 18px;\n    color: #00D4FF;\n    width: fit-content;\n    margin-top: 20px;\n    margin-bottom: 20px;\n  }\n  .logo {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 26px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -0.02em;\n  }\n  .right {\n    flex: 1;\n    padding: 40px 44px 40px 0;\n    position: relative;\n    z-index: 2;\n  }\n  .panel {\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 26px;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n  .panel-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-bottom: 8px;\n    border-bottom: 1px solid rgba(0,212,255,0.15);\n  }\n  .panel-title {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 18px;\n    color: #00D4FF;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n  }\n  .panel-tag {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 18px;\n    color: #a0b4c5;\n  }\n  .compare {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n  }\n  .col {\n    border-radius: 12px;\n    padding: 16px;\n  }\n  .before {\n    background: rgba(239,68,68,0.08);\n    border: 1px solid rgba(239,68,68,0.25);\n  }\n  .after {\n    background: rgba(0,212,255,0.08);\n    border: 1px solid rgba(0,212,255,0.3);\n  }\n  .col-label {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 18px;\n    margin-bottom: 8px;\n  }\n  .before .col-label { color: #ef4444; }\n  .after .col-label { color: #00D4FF; }\n  .col-line {\n    font-size: 22px;\n    color: white;\n    line-height: 1.3;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: 6px;\n  }\n  .stack {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .row {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    padding: 12px 14px;\n    border-radius: 10px;\n    background: rgba(255,255,255,0.03);\n    border-left: 3px solid #00D4FF;\n  }\n  .row img, .row svg.tool { width: 36px; height: 36px; object-fit: contain; flex-shrink: 0; }\n  .row-text {\n    font-size: 22px;\n    color: white;\n    flex: 1;\n  }\n  .row-text b { color: #33E1FF; font-weight: 700; }\n  .row-tag {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 18px;\n    color: #a0b4c5;\n  }\n  .savings {\n    display: flex;\n    align-items: baseline;\n    gap: 14px;\n    padding: 10px 14px;\n    background: linear-gradient(90deg, rgba(0,212,255,0.15), rgba(0,212,255,0));\n    border-radius: 10px;\n    margin-top: auto;\n  }\n  .savings-num {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 56px;\n    letter-spacing: -0.03em;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    line-height: 1;\n  }\n  .savings-label {\n    font-size: 22px;\n    color: white;\n    line-height: 1.2;\n  }\n  .savings-label span {\n    display: block;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 18px;\n    color: #a0b4c5;\n  }\n  #exportBtn {\n    margin-top: 20px;\n    padding: 12px 24px;\n    background: #00D4FF;\n    color: #0B1929;\n    border: none;\n    border-radius: 8px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    cursor: pointer;\n  }\n</style>\n</head>\n<body>\n<div id=\"post\">\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\">\n    <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n      <g fill=\"currentColor\">\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\"/>\n        <rect x=\"4\" y=\"48\" width=\"92\" height=\"4\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(30 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(60 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(120 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(150 50 50)\"/>\n      </g>\n    </symbol>\n  </svg>\n\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" viewBox=\"0 0 100 100\"><use href=\"#claude-star\" fill=\"#00D4FF\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <svg viewBox=\"0 0 100 100\"><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n    <h1 class=\"headline\">He didn't fire her because she was <em>bad.</em></h1>\n    <p class=\"subtitle\">He fired her because a workflow was better. A real trades case study.</p>\n    <div class=\"cta\">→ Sound familiar?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-header\">\n        <div class=\"panel-title\">Case Study · Electrician</div>\n        <div class=\"panel-tag\">Sparky Co.</div>\n      </div>\n\n      <div class=\"compare\">\n        <div class=\"col before\">\n          <div class=\"col-label\">◇ BEFORE</div>\n          <div class=\"col-line\">1 office manager</div>\n          <div class=\"col-line\">3 spreadsheets</div>\n          <div class=\"col-line\">Missed jobs weekly</div>\n        </div>\n        <div class=\"col after\">\n          <div class=\"col-label\">◆ AFTER</div>\n          <div class=\"col-line\">1 workflow</div>\n          <div class=\"col-line\">0 dropped leads</div>\n          <div class=\"col-line\">Sundays off</div>\n        </div>\n      </div>\n\n      <div class=\"stack\">\n        <div class=\"row\">\n          <svg class=\"tool\" viewBox=\"0 0 100 100\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>\n          <div class=\"row-text\"><b>GoHighLevel</b> — lead intake</div>\n          <div class=\"row-tag\">24/7</div>\n        </div>\n        <div class=\"row\">\n          <img src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\">\n          <div class=\"row-text\"><b>Claude</b> — auto-generates quotes</div>\n          <div class=\"row-tag\">&lt; 60s</div>\n        </div>\n        <div class=\"row\">\n          <img src=\"https://cdn.simpleicons.org/n8n/EA4B71\" alt=\"N8N\">\n          <div class=\"row-text\"><b>N8N</b> — schedules the job</div>\n          <div class=\"row-tag\">HANDS-OFF</div>\n        </div>\n      </div>\n\n      <div class=\"savings\">\n        <div class=\"savings-num\">$45K</div>\n        <div class=\"savings-label\">saved per year<span>replaced admin role</span></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">Export PNG</button>\n\n<script>\n  document.getElementById('exportBtn').addEventListener('click', () => {\n    domtoimage.toPng(document.getElementById('post'), { width: 1200, height: 630, quality: 1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-electrician-case.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>"
