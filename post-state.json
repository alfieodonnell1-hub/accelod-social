n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-size:13px;\n    font-weight:700;\n    width:fit-content;\n    background:rgba(0,212,255,0.05);\n  }\n  .badge svg { width:14px; height:14px; }\n  .headline {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:64px;\n    line-height:0.96;\n    color:#fff;\n    margin-top:22px;\n    letter-spacing:-2px;\n  }\n  .headline em {\n    font-style:normal;\n    background: linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-family:'DM Sans',sans-serif;\n    font-size:19px;\n    font-weight:500;\n    color:#C5D4E2;\n    line-height:1.4;\n    margin-top:18px;\n  }\n  .subtitle b { color:#fff; font-weight:700; }\n  .powered {\n    margin-top:22px;\n    display:flex;\n    flex-direction:column;\n    gap:10px;\n  }\n  .powered-label {\n    font-family:'JetBrains Mono',monospace;\n    font-size:11px;\n    color:#5C7388;\n    text-transform:uppercase;\n    letter-spacing:1.5px;\n    font-weight:700;\n  }\n  .logo-row {\n    display:flex;\n    gap:10px;\n    align-items:center;\n    flex-wrap:wrap;\n  }\n  .tool-pill {\n    display:inline-flex;\n    align-items:center;\n    gap:8px;\n    padding:8px 14px;\n    background:rgba(255,255,255,0.06);\n    border:1px solid rgba(0,212,255,0.3);\n    border-radius:10px;\n    color:#fff;\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:14px;\n  }\n  .tool-pill .icon {\n    width:22px;\n    height:22px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n  }\n  .cta-pill {\n    margin-top:auto;\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    padding:13px 22px;\n    background:rgba(0,212,255,0.12);\n    border:1px solid rgba(0,212,255,0.5);\n    border-radius:999px;\n    color:#fff;\n    font-family:'DM Sans',sans-serif;\n    font-weight:700;\n    font-size:16px;\n    width:fit-content;\n  }\n  .cta-pill::before {\n    content:'';\n    width:8px;\n    height:8px;\n    border-radius:50%;\n    background:#00D4FF;\n    box-shadow:0 0 12px #00D4FF;\n  }\n  .right-panel {\n    flex:1;\n    padding:36px 44px 36px 0;\n    position:relative;\n    z-index:2;\n  }\n  .content-panel {\n    height:100%;\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.25);\n    border-radius:16px;\n    padding:28px 30px;\n    display:flex;\n    flex-direction:column;\n  }\n  .panel-header {\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    padding-bottom:14px;\n    border-bottom:1px solid rgba(0,212,255,0.18);\n    margin-bottom:18px;\n  }\n  .panel-title {\n    font-family:'JetBrains Mono',monospace;\n    font-size:13px;\n    color:#00D4FF;\n    text-transform:uppercase;\n    letter-spacing:1.5px;\n    font-weight:700;\n  }\n  .timestamp {\n    font-family:'JetBrains Mono',monospace;\n    font-size:13px;\n    color:#5C7388;\n    font-weight:500;\n  }\n  .compare {\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:18px;\n  }\n  .col-head {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:15px;\n    text-transform:uppercase;\n    letter-spacing:1px;\n    margin-bottom:12px;\n  }\n  .col-head.red { color:#FF6B6B; }\n  .col-head.cyan { color:#00D4FF; }\n  .stat-row {\n    display:flex;\n    align-items:baseline;\n    gap:10px;\n    padding:8px 0;\n  }\n  .stat-val {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:36px;\n    color:#fff;\n    line-height:1;\n    letter-spacing:-1px;\n  }\n  .stat-val.cyan {\n    background: linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .stat-label {\n    font-size:14px;\n    color:#C5D4E2;\n    font-weight:500;\n    line-height:1.2;\n  }\n  .bullets {\n    margin-top:18px;\n    padding-top:16px;\n    border-top:1px solid rgba(0,212,255,0.18);\n    display:flex;\n    flex-direction:column;\n    gap:10px;\n  }\n  .bullet {\n    display:flex;\n    align-items:center;\n    gap:11px;\n    font-size:15px;\n    color:#E2EBF3;\n    font-weight:500;\n  }\n  .bullet svg {\n    width:16px;\n    height:16px;\n    flex-shrink:0;\n    color:#00D4FF;\n  }\n  .bullet b { color:#fff; font-weight:700; }\n  .logo {\n    position:absolute;\n    bottom:20px;\n    right:32px;\n    z-index:3;\n    display:flex;\n    align-items:center;\n    gap:8px;\n  }\n  .logo-text {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:22px;\n    background: linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    letter-spacing:-0.5px;\n  }\n  #exportBtn {\n    padding:12px 24px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    color:#0B1929;\n    border:none;\n    border-radius:8px;\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:14px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L3,-8 L-3,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n  <symbol id=\"n8n-logo\" viewBox=\"0 0 24 24\">\n    <path fill=\"#EA4B71\" d=\"M21 10.5a2.5 2.5 0 0 0-2.45 2H16.5a2 2 0 0 0-1.95 1.55l-.3 1.3a1 1 0 0 1-.97.8h-.83a2.5 2.5 0 1 0 0 1.7h.83a2 2 0 0 0 1.95-1.55l.3-1.3a1 1 0 0 1 .97-.8h2.05a2.5 2.5 0 1 0 2.45-3.7zm-15-3a2.5 2.5 0 0 0-2.45 2H3a1 1 0 1 0 0 1.7h.55a2.5 2.5 0 0 0 4.9 0h.83a1 1 0 0 1 .97.8l.3 1.3A2 2 0 0 0 12.5 15h.83a2.5 2.5 0 1 0 0-1.7h-.83a1 1 0 0 1-.97-.8l-.3-1.3a2 2 0 0 0-1.95-1.55H8.45A2.5 2.5 0 0 0 6 7.5z\"/>\n  </symbol>\n  <symbol id=\"gworkspace-logo\" viewBox=\"0 0 24 24\">\n    <g>\n      <circle cx=\"6\" cy=\"12\" r=\"3\" fill=\"#4285F4\"/>\n      <circle cx=\"18\" cy=\"12\" r=\"3\" fill=\"#34A853\"/>\n      <circle cx=\"12\" cy=\"6\" r=\"3\" fill=\"#FBBC04\"/>\n      <circle cx=\"12\" cy=\"18\" r=\"3\" fill=\"#EA4335\"/>\n    </g>\n  </symbol>\n  <symbol id=\"check-icon\" viewBox=\"0 0 24 24\">\n    <path fill=\"currentColor\" d=\"M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"/>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow-tl\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left-col\">\n    <div class=\"badge\">\n      <svg><use href=\"#claude-star\"/></svg>\n      AI AUTOMATION\n    </div>\n    <h1 class=\"headline\">The <em>3AM Email</em> Test.</h1>\n    <p class=\"subtitle\">If your business <b>stops making money</b> when you close your laptop, you don't have a business — <b>you have a job.</b></p>\n\n    <div class=\"powered\">\n      <span class=\"powered-label\">⚡ Powered By</span>\n      <div class=\"logo-row\">\n        <div class=\"tool-pill\">\n          <span class=\"icon\"><svg width=\"22\" height=\"22\"><use href=\"#n8n-logo\"/></svg></span>\n          n8n\n        </div>\n        <div class=\"tool-pill\">\n          <span class=\"icon\"><svg width=\"20\" height=\"20\"><use href=\"#gworkspace-logo\"/></svg></span>\n          Google Workspace\n        </div>\n      </div>\n    </div>\n\n    <div class=\"cta-pill\">Sound familiar?</div>\n  </div>\n\n  <div class=\"right-panel\">\n    <div class=\"content-panel\">\n      <div class=\"panel-header\">\n        <span class=\"panel-title\">▶ OVERNIGHT ACTIVITY LOG</span>\n        <span class=\"timestamp\">03:14 AM</span>\n      </div>\n\n      <div class=\"compare\">\n        <div>\n          <div class=\"col-head red\">✗ YOU, ASLEEP</div>\n          <div class=\"stat-row\">\n            <div class=\"stat-val\">47</div>\n            <div class=\"stat-label\">unread<br><b style=\"color:#fff\">leads</b></div>\n          </div>\n          <div class=\"stat-row\">\n            <div class=\"stat-val\">12h</div>\n            <div class=\"stat-label\">avg reply<br><b style=\"color:#fff\">delay</b></div>\n          </div>\n          <div class=\"stat-row\">\n            <div class=\"stat-val\">$0</div>\n            <div class=\"stat-label\">revenue<br><b style=\"color:#fff\">captured</b></div>\n          </div>\n        </div>\n        <div>\n          <div class=\"col-head cyan\">✓ N8N, WORKING</div>\n          <div class=\"stat-row\">\n            <div class=\"stat-val cyan\">47</div>\n            <div class=\"stat-label\">replies<br><b style=\"color:#fff\">sent</b></div>\n          </div>\n          <div class=\"stat-row\">\n            <div class=\"stat-val cyan\">9</div>\n            <div class=\"stat-label\">meetings<br><b style=\"color:#fff\">booked</b></div>\n          </div>\n          <div class=\"stat-row\">\n            <div class=\"stat-val cyan\">3min</div>\n            <div class=\"stat-label\">avg reply<br><b style=\"color:#fff\">time</b></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bullets\">\n        <div class=\"bullet\">\n          <svg><use href=\"#check-icon\"/></svg>\n          <span><b>Auto-qualifies</b> leads while you sleep</span>\n        </div>\n        <div class=\"bullet\">\n          <svg><use href=\"#check-icon\"/></svg>\n          <span><b>Books meetings</b> directly to your calendar</span>\n        </div>\n        <div class=\"bullet\">\n          <svg><use href=\"#check-icon\"/></svg>\n          <span><b>Syncs everything</b> with Gmail, Sheets & Drive</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"logo\">\n    <span class=\"logo-text\">ACCELOD AI</span>\n  </div>\n</div>\n\n<button id=\"exportBtn\" onclick=\"exportPost()\">Export PNG</button>\n\n<script>\n  function exportPost() {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1200, height:630, quality:1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-3am-facebook.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  }\n</script>\n</body>\n</html>",
