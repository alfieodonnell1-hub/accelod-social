  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI - Automated Monday</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    background: #1a1a1a;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 30px;\n    font-family: 'DM Sans', sans-serif;\n    gap: 20px;\n  }\n  #post {\n    width: 1080px;\n    height: 1350px;\n    background: #0B1929;\n    position: relative;\n    overflow: hidden;\n    display: grid;\n    grid-template-rows: auto 1fr auto;\n  }\n  .dot-grid {\n    position: absolute;\n    inset: 0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 28px 28px;\n    pointer-events: none;\n  }\n  .glow-tr {\n    position: absolute;\n    top: -250px;\n    right: -200px;\n    width: 800px;\n    height: 800px;\n    background: radial-gradient(circle, rgba(0,212,255,0.22) 0%, transparent 65%);\n    pointer-events: none;\n  }\n  .glow-bl {\n    position: absolute;\n    bottom: -300px;\n    left: -250px;\n    width: 800px;\n    height: 800px;\n    background: radial-gradient(circle, rgba(51,225,255,0.15) 0%, transparent 65%);\n    pointer-events: none;\n  }\n  .watermark {\n    position: absolute;\n    bottom: -120px;\n    right: -140px;\n    width: 600px;\n    height: 600px;\n    opacity: 0.04;\n    pointer-events: none;\n  }\n\n  /* TOP BAR */\n  .top-bar {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 50px 70px 0;\n    position: relative;\n    z-index: 3;\n  }\n  .logo {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 30px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -0.02em;\n  }\n  .badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    border: 1.5px solid #00D4FF;\n    border-radius: 100px;\n    padding: 9px 20px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    font-weight: 500;\n    color: #00D4FF;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n  }\n  .badge svg { width: 14px; height: 14px; }\n\n  /* MAIN HERO SECTION — split layout */\n  .hero {\n    display: grid;\n    grid-template-columns: 1.05fr 0.95fr;\n    align-items: center;\n    padding: 30px 70px 0;\n    position: relative;\n    z-index: 2;\n    gap: 30px;\n  }\n  .hero-text { position: relative; z-index: 3; }\n  .eyebrow {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 14px;\n    color: rgba(0,212,255,0.8);\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    margin-bottom: 18px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .live-dot {\n    width: 8px; height: 8px;\n    background: #00D4FF;\n    border-radius: 50%;\n    box-shadow: 0 0 12px #00D4FF;\n  }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 96px;\n    line-height: 0.92;\n    color: #fff;\n    letter-spacing: -0.04em;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .subtitle {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 22px;\n    color: rgba(255,255,255,0.7);\n    margin-top: 26px;\n    line-height: 1.45;\n  }\n\n  /* CHARACTER ILLUSTRATION */\n  .character-wrap {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 1/1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .character-bg {\n    position: absolute;\n    inset: 8%;\n    background: radial-gradient(circle, rgba(0,212,255,0.18) 0%, rgba(0,212,255,0.04) 50%, transparent 75%);\n    border-radius: 50%;\n  }\n  .character-ring {\n    position: absolute;\n    inset: 4%;\n    border: 1.5px dashed rgba(0,212,255,0.3);\n    border-radius: 50%;\n  }\n  .character {\n    position: relative;\n    width: 92%;\n    height: 92%;\n    z-index: 2;\n  }\n\n  /* BOTTOM SECTION */\n  .bottom {\n    padding: 0 70px 50px;\n    position: relative;\n    z-index: 2;\n  }\n  .stats-row {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 18px;\n    margin-bottom: 30px;\n  }\n  .stat {\n    background: rgba(0,212,255,0.06);\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 22px 24px;\n    position: relative;\n    overflow: hidden;\n  }\n  .stat::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%;\n    height: 2px;\n    background: linear-gradient(90deg, #00D4FF, transparent);\n  }\n  .stat-num {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 56px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    line-height: 1;\n  }\n  .stat-label {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 12px;\n    color: rgba(255,255,255,0.65);\n    margin-top: 10px;\n    text-transform: uppercase;\n    letter-spacing: 0.12em;\n  }\n  .workflow-strip {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.18);\n    border-radius: 100px;\n    padding: 16px 28px;\n    margin-bottom: 28px;\n  }\n  .step {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 18px;\n    color: #fff;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .step-time {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 12px;\n    color: #00D4FF;\n    font-weight: 500;\n  }\n  .arrow {\n    color: rgba(0,212,255,0.5);\n    font-size: 18px;\n    font-weight: 700;\n  }\n  .footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n  .cta-pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    color: #0B1929;\n    padding: 20px 36px;\n    border-radius: 100px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 22px;\n  }\n  .tagline {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    color: rgba(255,255,255,0.5);\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    text-align: right;\n    line-height: 1.6;\n  }\n  .tagline span { color: #00D4FF; }\n\n  #exportBtn {\n    background: #00D4FF;\n    color: #0B1929;\n    border: none;\n    padding: 14px 28px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    border-radius: 100px;\n    cursor: pointer;\n  }\n</style>\n</head>\n<body>\n\n<div id=\"post\">\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\">\n    <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n      <g fill=\"currentColor\">\n        <g>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(30)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(60)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(90)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(120)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(150)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(180)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(210)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(240)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(270)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(300)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(330)\"/>\n        </g>\n      </g>\n    </symbol>\n  </svg>\n\n  <div class=\"glow-tr\"></div>\n  <div class=\"glow-bl\"></div>\n  <div class=\"dot-grid\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <!-- TOP BAR -->\n  <div class=\"top-bar\">\n    <div class=\"logo\">Accelod<span style=\"color:#33E1FF\">/</span>AI</div>\n    <div class=\"badge\">\n      <svg><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n  </div>\n\n  <!-- HERO with character -->\n  <div class=\"hero\">\n    <div class=\"hero-text\">\n      <div class=\"eyebrow\"><span class=\"live-dot\"></span>Mon · 06:00 → 08:47</div>\n      <h1 class=\"headline\">I Automated<br>My <em>Monday.</em></h1>\n      <p class=\"subtitle\">While he kicks back, the system closed three deals before 9 AM — zero clicks, zero stress.</p>\n    </div>\n\n    <div class=\"character-wrap\">\n      <div class=\"character-bg\"></div>\n      <div class=\"character-ring\"></div>\n      <!-- Young lad sitting illustration -->\n      <svg class=\"character\" viewBox=\"0 0 400 400\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"chairGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#1a3147\"/>\n            <stop offset=\"100%\" stop-color=\"#0d1f30\"/>\n          </linearGradient>\n          <linearGradient id=\"shirtGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#00D4FF\"/>\n            <stop offset=\"100%\" stop-color=\"#0095b8\"/>\n          </linearGradient>\n          <linearGradient id=\"pantsGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#2a3f55\"/>\n            <stop offset=\"100%\" stop-color=\"#1a2838\"/>\n          </linearGradient>\n          <linearGradient id=\"phoneGlow\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#33E1FF\"/>\n            <stop offset=\"100%\" stop-color=\"#00D4FF\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Floor shadow -->\n        <ellipse cx=\"200\" cy=\"370\" rx=\"130\" ry=\"10\" fill=\"#000\" opacity=\"0.35\"/>\n\n        <!-- Chair back -->\n        <rect x=\"120\" y=\"170\" width=\"160\" height=\"180\" rx=\"22\" fill=\"url(#chairGrad)\"/>\n        <rect x=\"120\" y=\"170\" width=\"160\" height=\"40\" rx=\"22\" fill=\"#fff\" opacity=\"0.04\"/>\n\n        <!-- Chair legs -->\n        <rect x=\"135\" y=\"340\" width=\"14\" height=\"30\" fill=\"#0a1620\"/>\n        <rect x=\"251\" y=\"340\" width=\"14\" height=\"30\" fill=\"#0a1620\"/>\n\n        <!-- Pants / legs (crossed casually) -->\n        <path d=\"M 145 280 Q 150 340 175 355 L 230 355 Q 240 340 245 290 Z\" fill=\"url(#pantsGrad)\"/>\n        <!-- Front leg extending -->\n        <path d=\"M 210 320 Q 260 330 290 345 L 295 360 Q 250 360 210 355 Z\" fill=\"url(#pantsGrad)\"/>\n        <!-- Shoes -->\n        <ellipse cx=\"295\" cy=\"358\" rx=\"22\" ry=\"9\" fill=\"#0a1620\"/>\n        <ellipse cx=\"170\" cy=\"362\" rx=\"18\" ry=\"8\" fill=\"#0a1620\"/>\n\n        <!-- Torso (slouched/relaxed) -->\n        <path d=\"M 150 200 Q 145 250 160 285 L 240 285 Q 255 250 250 200 Q 230 180 200 180 Q 170 180 150 200 Z\" fill=\"url(#shirtGrad)\"/>\n        <!-- Shirt highlight -->\n        <path d=\"M 158 205 Q 158 240 168 270 L 180 270 Q 175 235 178 205 Z\" fill=\"#fff\" opacity=\"0.12\"/>\n        <!-- Collar -->\n        <path d=\"M 185 180 L 200 195 L 215 180 L 210 175 L 190 175 Z\" fill=\"#06101A\"/>\n\n        <!-- Left arm (resting on lap holding phone) -->\n        <path d=\"M 155 215 Q 145 250 165 280 Q 180 290 200 285 L 200 270 Q 180 270 175 255 Q 170 235 175 215 Z\" fill=\"url(#shirtGrad)\"/>\n        <!-- Right arm (relaxed behind head) -->\n        <path d=\"M 245 215 Q 270 200 275 170 Q 278 145 260 140 Q 250 145 248 165 Q 245 185 240 200 Z\" fill=\"url(#shirtGrad)\"/>\n\n        <!-- Hand holding phone -->\n        <ellipse cx=\"195\" cy=\"282\" rx=\"14\" ry=\"10\" fill=\"#d4a574\"/>\n        <!-- Phone -->\n        <rect x=\"180\" y=\"260\" width=\"38\" height=\"58\" rx=\"6\" fill=\"#0a1620\" stroke=\"#00D4FF\" stroke-width=\"1.5\"/>\n        <rect x=\"184\" y=\"265\" width=\"30\" height=\"48\" rx=\"2\" fill=\"url(#phoneGlow)\" opacity=\"0.85\"/>\n        <!-- Phone screen content lines -->\n        <rect x=\"187\" y=\"270\" width=\"20\" height=\"2\" fill=\"#fff\" opacity=\"0.7\"/>\n        <rect x=\"187\" y=\"276\" width=\"14\" height=\"2\" fill=\"#fff\" opacity=\"0.5\"/>\n        <rect x=\"187\" y=\"282\" width=\"18\" height=\"2\" fill=\"#fff\" opacity=\"0.6\"/>\n        <rect x=\"187\" y=\"290\" width=\"24\" height=\"8\" rx=\"2\" fill=\"#0B1929\" opacity=\"0.5\"/>\n\n        <!-- Right hand behind head -->\n        <circle cx=\"262\" cy=\"138\" r=\"9\" fill=\"#d4a574\"/>\n\n        <!-- Neck -->\n        <rect x=\"190\" y=\"135\" width=\"20\" height=\"22\" fill=\"#d4a574\"/>\n\n        <!-- Head -->\n        <ellipse cx=\"200\" cy=\"115\" rx=\"32\" ry=\"36\" fill=\"#e0b48a\"/>\n        <!-- Hair -->\n        <path d=\"M 168 105 Q 165 78 195 72 Q 225 68 232 95 Q 235 110 230 118 Q 225 100 210 98 Q 195 102 185 110 Q 175 115 170 118 Z\" fill=\"#2a1810\"/>\n        <!-- Hair fringe -->\n        <path d=\"M 178 95 Q 185 88 200 90 Q 215 88 222 100 Q 210 96 200 98 Q 188 96 178 100 Z\" fill=\"#1a0e08\"/>\n\n        <!-- Face -->\n        <!-- Eyes (relaxed, slightly closed - chill vibe) -->\n        <path d=\"M 185 118 Q 190 116 195 118\" stroke=\"#1a0e08\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M 205 118 Q 210 116 215 118\" stroke=\"#1a0e08\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n        <!-- Smirk smile -->\n        <path d=\"M 192 132 Q 200 137 210 131\" stroke=\"#1a0e08\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n        <!-- Cheek blush hint -->\n        <circle cx=\"180\" cy=\"125\" r=\"4\" fill=\"#d4756a\" opacity=\"0.3\"/>\n        <circle cx=\"220\" cy=\"125\" r=\"4\" fill=\"#d4756a\" opacity=\"0.3\"/>\n\n        <!-- Floating notification bubbles -->\n        <g opacity=\"0.9\">\n          <circle cx=\"80\" cy=\"120\" r=\"22\" fill=\"#00D4FF\" opacity=\"0.15\"/>\n          <circle cx=\"80\" cy=\"120\" r=\"14\" fill=\"#00D4FF\"/>\n          <text x=\"80\" y=\"125\" text-anchor=\"middle\" font-family=\"Outfit\" font-weight=\"900\" font-size=\"14\" fill=\"#0B1929\">✓</text>\n        </g>\n        <g opacity=\"0.9\">\n          <circle cx=\"330\" cy=\"240\" r=\"18\" fill=\"#33E1FF\" opacity=\"0.15\"/>\n          <circle cx=\"330\" cy=\"240\" r=\"11\" fill=\"#33E1FF\"/>\n          <text x=\"330\" y=\"244\" text-anchor=\"middle\" font-family=\"Outfit\" font-weight=\"900\" font-size=\"11\" fill=\"#0B1929\">$</text>\n        </g>\n        <g opacity=\"0.85\">\n          <circle cx=\"60\" cy=\"240\" r=\"14\" fill=\"#00D4FF\" opacity=\"0.18\"/>\n          <circle cx=\"60\" cy=\"240\" r=\"8\" fill=\"#00D4FF\"/>\n        </g>\n      </svg>\n    </div>\n  </div>\n\n  <!-- BOTTOM -->\n  <div class=\"bottom\">\n    <div class=\"workflow-strip\">\n      <div class=\"step\"><span class=\"step-time\">06:12</span> Claude</div>\n      <span class=\"arrow\">→</span>\n      <div class=\"step\"><span class=\"step-time\">07:03</span> N8N</div>\n      <span class=\"arrow\">→</span>\n      <div class=\"step\"><span class=\"step-time\">08:47</span> GoHighLevel</div>\n    </div>\n\n    <div class=\"stats-row\">\n      <div class=\"stat\">\n        <div class=\"stat-num\">3</div>\n        <div class=\"stat-label\">Deals Closed</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"stat-num\">0</div>\n        <div class=\"stat-label\">Manual Clicks</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"stat-num\">9AM</div>\n        <div class=\"stat-label\">Done By</div>\n      </div>\n    </div>\n\n    <div class=\"footer\">\n      <div class=\"cta-pill\">Sound familiar? →</div>\n      <div class=\"tagline\">Build · Automate<br><span>Scale Without You</span></div>\n    </div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">Export PNG</button>\n\n<script>\n  document.getElementById('exportBtn').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1080, height: 1350, quality: 1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-automated-monday.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>",
  "fb_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI - Monday Automated</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    background:#0a1320;\n    min-height:100vh;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    padding:30px;\n    font-family:'DM Sans',sans-serif;\n    gap:20px;\n  }\n  #post {\n    width:1200px;\n    height:630px;\n    background:#0B1929;\n    position:relative;\n    overflow:hidden;\n    font-family:'DM Sans',sans-serif;\n  }\n  .bg-grid {\n    position:absolute;\n    inset:0;\n    background-image:\n      linear-gradient(rgba(0,212,255,0.06) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(0,212,255,0.06) 1px, transparent 1px);\n    background-size:40px 40px;\n    pointer-events:none;\n  }\n  .glow-1 {\n    position:absolute;\n    top:-200px;\n    right:-100px;\n    width:600px;\n    height:600px;\n    background:radial-gradient(circle, rgba(0,212,255,0.22) 0%, transparent 65%);\n    pointer-events:none;\n  }\n  .glow-2 {\n    position:absolute;\n    bottom:-220px;\n    left:-150px;\n    width:520px;\n    height:520px;\n    background:radial-gradient(circle, rgba(51,225,255,0.16) 0%, transparent 70%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute;\n    top:50%;\n    left:50%;\n    transform:translate(-50%,-50%) rotate(8deg);\n    width:700px;\n    height:700px;\n    opacity:0.04;\n    color:#00D4FF;\n    pointer-events:none;\n  }\n\n  /* HERO: young lad illustration on the right */\n  .hero {\n    position:absolute;\n    right:60px;\n    top:50%;\n    transform:translateY(-50%);\n    width:440px;\n    height:520px;\n    z-index:2;\n  }\n  .hero-frame {\n    position:absolute;\n    inset:0;\n    border:1px solid rgba(0,212,255,0.3);\n    border-radius:24px;\n    background:linear-gradient(180deg, rgba(0,212,255,0.08), rgba(0,212,255,0.02));\n    overflow:hidden;\n  }\n  .hero-tag {\n    position:absolute;\n    top:16px;\n    left:16px;\n    z-index:3;\n    font-family:'JetBrains Mono',monospace;\n    font-size:11px;\n    color:#00D4FF;\n    padding:5px 10px;\n    background:rgba(11,25,41,0.85);\n    border:1px solid rgba(0,212,255,0.3);\n    border-radius:4px;\n    letter-spacing:1px;\n  }\n  .hero-stat {\n    position:absolute;\n    bottom:16px;\n    right:16px;\n    z-index:3;\n    background:rgba(11,25,41,0.9);\n    border:1px solid rgba(0,212,255,0.35);\n    border-radius:8px;\n    padding:10px 14px;\n    text-align:right;\n  }\n  .hero-stat .n {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:28px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    line-height:1;\n  }\n  .hero-stat .l {\n    font-family:'JetBrains Mono',monospace;\n    font-size:10px;\n    color:rgba(255,255,255,0.6);\n    letter-spacing:1px;\n    text-transform:uppercase;\n    margin-top:2px;\n  }\n\n  /* LEFT content */\n  .content {\n    position:absolute;\n    left:60px;\n    top:60px;\n    bottom:60px;\n    width:640px;\n    z-index:3;\n    display:flex;\n    flex-direction:column;\n  }\n  .badge {\n    display:inline-flex;\n    align-items:center;\n    gap:8px;\n    padding:8px 16px;\n    border:1px solid rgba(0,212,255,0.5);\n    border-radius:999px;\n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-size:12px;\n    font-weight:500;\n    width:fit-content;\n    background:rgba(0,212,255,0.05);\n    letter-spacing:1px;\n  }\n  .badge svg { width:14px; height:14px; }\n\n  .day-strip {\n    margin-top:22px;\n    display:flex;\n    gap:6px;\n    font-family:'JetBrains Mono',monospace;\n    font-size:11px;\n  }\n  .day {\n    padding:5px 10px;\n    border:1px solid rgba(255,255,255,0.1);\n    border-radius:4px;\n    color:rgba(255,255,255,0.4);\n    letter-spacing:1px;\n  }\n  .day.active {\n    background:rgba(0,212,255,0.15);\n    border-color:#00D4FF;\n    color:#00D4FF;\n  }\n\n  .headline {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:78px;\n    line-height:0.92;\n    color:#fff;\n    margin-top:18px;\n    letter-spacing:-2.5px;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .underline {\n    width:80px;\n    height:4px;\n    background:linear-gradient(90deg,#00D4FF,transparent);\n    margin-top:18px;\n    border-radius:2px;\n  }\n  .subtitle {\n    font-family:'DM Sans',sans-serif;\n    font-size:20px;\n    line-height:1.45;\n    color:rgba(255,255,255,0.72);\n    margin-top:18px;\n    font-weight:400;\n    max-width:520px;\n  }\n\n  .stack {\n    margin-top:24px;\n    display:flex;\n    gap:10px;\n    flex-wrap:wrap;\n  }\n  .chip {\n    font-family:'JetBrains Mono',monospace;\n    font-size:12px;\n    color:rgba(255,255,255,0.75);\n    padding:6px 12px;\n    border:1px solid rgba(0,212,255,0.25);\n    border-radius:999px;\n    background:rgba(0,212,255,0.04);\n  }\n  .chip span { color:#00D4FF; margin-right:6px; }\n\n  .bottom-bar {\n    margin-top:auto;\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:20px;\n  }\n  .cta {\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    padding:14px 24px;\n    background:rgba(0,212,255,0.1);\n    border:1px solid rgba(0,212,255,0.5);\n    border-radius:999px;\n    color:#33E1FF;\n    font-family:'DM Sans',sans-serif;\n    font-weight:500;\n    font-size:18px;\n  }\n  .cta::before {\n    content:'';\n    width:8px; height:8px;\n    border-radius:50%;\n    background:#00D4FF;\n    box-shadow:0 0 12px #00D4FF;\n  }\n  .logo {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:22px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    letter-spacing:-0.5px;\n  }\n\n  #exportBtn {\n    padding:14px 28px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    color:#0B1929;\n    border:none;\n    border-radius:8px;\n    font-family:'DM Sans',sans-serif;\n    font-weight:500;\n    font-size:15px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"bg-grid\"></div>\n  <div class=\"glow-1\"></div>\n  <div class=\"glow-2\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <!-- LEFT CONTENT -->\n  <div class=\"content\">\n    <div class=\"badge\">\n      <svg viewBox=\"-50 -50 100 100\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n      AI AUTOMATION\n    </div>\n\n    <div class=\"day-strip\">\n      <div class=\"day active\">MON</div>\n      <div class=\"day\">TUE</div>\n      <div class=\"day\">WED</div>\n      <div class=\"day\">THU</div>\n      <div class=\"day\">FRI</div>\n    </div>\n\n    <h1 class=\"headline\">I Automated<br>My <em>Monday</em>.</h1>\n    <div class=\"underline\"></div>\n\n    <p class=\"subtitle\">While you were checking emails, my system closed three deals before 9 AM.</p>\n\n    <div class=\"stack\">\n      <div class=\"chip\"><span>›</span>Claude</div>\n      <div class=\"chip\"><span>›</span>N8N</div>\n      <div class=\"chip\"><span>›</span>GoHighLevel</div>\n    </div>\n\n    <div class=\"bottom-bar\">\n      <div class=\"cta\">Sound familiar?</div>\n      <div class=\"logo\">accelod<span style=\"color:#33E1FF\">.ai</span></div>\n    </div>\n  </div>\n\n  <!-- HERO: young lad sitting -->\n  <div class=\"hero\">\n    <div class=\"hero-frame\">\n      <div class=\"hero-tag\">// 08:51 · MONDAY</div>\n\n      <svg viewBox=\"0 0 440 520\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid slice\">\n        <defs>\n          <linearGradient id=\"bgGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0d2236\"/>\n            <stop offset=\"100%\" stop-color=\"#06101a\"/>\n          </linearGradient>\n          <linearGradient id=\"screenGlow\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#00D4FF\" stop-opacity=\"0.55\"/>\n            <stop offset=\"100%\" stop-color=\"#00D4FF\" stop-opacity=\"0.05\"/>\n          </linearGradient>\n          <linearGradient id=\"hairGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#3a2a1a\"/>\n            <stop offset=\"100%\" stop-color=\"#2a1f12\"/>\n          </linearGradient>\n          <linearGradient id=\"skinGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#e9c4a3\"/>\n            <stop offset=\"100%\" stop-color=\"#d4a880\"/>\n          </linearGradient>\n          <linearGradient id=\"hoodieGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#1a3a52\"/>\n            <stop offset=\"100%\" stop-color=\"#0f2436\"/>\n          </linearGradient>\n          <radialGradient id=\"lampGlow\" cx=\"0.5\" cy=\"0.5\" r=\"0.5\">\n            <stop offset=\"0%\" stop-color=\"#00D4FF\" stop-opacity=\"0.4\"/>\n            <stop offset=\"100%\" stop-color=\"#00D4FF\" stop-opacity=\"0\"/>\n          </radialGradient>\n        </defs>\n\n        <!-- background -->\n        <rect width=\"440\" height=\"520\" fill=\"url(#bgGrad)\"/>\n\n        <!-- ambient light behind -->\n        <circle cx=\"220\" cy=\"180\" r=\"180\" fill=\"url(#lampGlow)\"/>\n\n        <!-- window grid pattern background -->\n        <g opacity=\"0.15\" stroke=\"#00D4FF\" stroke-width=\"0.5\" fill=\"none\">\n          <line x1=\"0\" y1=\"100\" x2=\"440\" y2=\"100\"/>\n          <line x1=\"0\" y1=\"150\" x2=\"440\" y2=\"150\"/>\n          <line x1=\"0\" y1=\"200\" x2=\"440\" y2=\"200\"/>\n          <line x1=\"60\" y1=\"0\" x2=\"60\" y2=\"520\"/>\n          <line x1=\"120\" y1=\"0\" x2=\"120\" y2=\"520\"/>\n          <line x1=\"380\" y1=\"0\" x2=\"380\" y2=\"520\"/>\n        </g>\n\n        <!-- desk -->\n        <rect x=\"60\" y=\"380\" width=\"320\" height=\"14\" rx=\"2\" fill=\"#0a1828\" stroke=\"#00D4FF\" stroke-opacity=\"0.3\"/>\n        <rect x=\"80\" y=\"394\" width=\"6\" height=\"100\" fill=\"#0a1828\"/>\n        <rect x=\"354\" y=\"394\" width=\"6\" height=\"100\" fill=\"#0a1828\"/>\n\n        <!-- monitor -->\n        <rect x=\"130\" y=\"240\" width=\"180\" height=\"120\" rx=\"6\" fill=\"#04101c\" stroke=\"#00D4FF\" stroke-opacity=\"0.5\" stroke-width=\"1.5\"/>\n        <rect x=\"138\" y=\"248\" width=\"164\" height=\"104\" rx=\"2\" fill=\"url(#screenGlow)\"/>\n        <!-- screen content lines -->\n        <g fill=\"#00D4FF\" opacity=\"0.85\">\n          <rect x=\"146\" y=\"256\" width=\"60\" height=\"4\" rx=\"1\"/>\n          <rect x=\"146\" y=\"266\" width=\"100\" height=\"3\" rx=\"1\" opacity=\"0.6\"/>\n          <rect x=\"146\" y=\"274\" width=\"80\" height=\"3\" rx=\"1\" opacity=\"0.6\"/>\n          <rect x=\"146\" y=\"288\" width=\"140\" height=\"2\" opacity=\"0.4\"/>\n          <rect x=\"146\" y=\"294\" width=\"120\" height=\"2\" opacity=\"0.4\"/>\n          <rect x=\"146\" y=\"300\" width=\"130\" height=\"2\" opacity=\"0.4\"/>\n          <rect x=\"146\" y=\"306\" width=\"90\" height=\"2\" opacity=\"0.4\"/>\n          <rect x=\"146\" y=\"320\" width=\"40\" height=\"14\" rx=\"2\"/>\n          <rect x=\"192\" y=\"320\" width=\"40\" height=\"14\" rx=\"2\" opacity=\"0.5\"/>\n        </g>\n        <!-- monitor stand -->\n        <rect x=\"210\" y=\"360\" width=\"20\" height=\"16\" fill=\"#0a1828\"/>\n        <rect x=\"195\" y=\"376\" width=\"50\" height=\"4\" rx=\"1\" fill=\"#0a1828\"/>\n\n        <!-- CHAIR back -->\n        <path d=\"M 280 300 Q 310 305 312 360 L 308 410 Q 305 420 295 420 L 280 420 Z\" fill=\"#0a1828\" stroke=\"#00D4FF\" stroke-opacity=\"0.2\"/>\n\n        <!-- YOUNG LAD sitting -->\n        <!-- torso / hoodie -->\n        <path d=\"M 175 320 Q 175 290 220 285 Q 265 290 270 320 L 282 410 Q 280 420 270 420 L 175 420 Q 165 420 165 410 Z\" fill=\"url(#hoodieGrad)\" stroke=\"#00D4FF\" stroke-opacity=\"0.25\" stroke-width=\"1\"/>\n        <!-- hoodie strings -->\n        <line x1=\"215\" y1=\"295\" x2=\"213\" y2=\"320\" stroke=\"#00D4FF\" stroke-opacity=\"0.4\" stroke-width=\"1.5\"/>\n        <line x1=\"225\" y1=\"295\" x2=\"227\" y2=\"320\" stroke=\"#00D4FF\" stroke-opacity=\"0.4\" stroke-width=\"1.5\"/>\n        <circle cx=\"213\" cy=\"322\" r=\"2\" fill=\"#00D4FF\" opacity=\"0.5\"/>\n        <circle cx=\"227\" cy=\"322\" r=\"2\" fill=\"#00D4FF\" opacity=\"0.5\"/>\n\n        <!-- neck -->\n        <rect x=\"210\" y=\"270\" width=\"20\" height=\"20\" fill=\"url(#skinGrad)\"/>\n\n        <!-- head -->\n        <ellipse cx=\"220\" cy=\"245\" rx=\"34\" ry=\"38\" fill=\"url(#skinGrad)\"/>\n\n        <!-- hair -->\n        <path d=\"M 188 235 Q 186 205 220 200 Q 256 203 254 238 Q 250 220 240 215 Q 230 225 215 222 Q 200 220 195 230 Z\" fill=\"url(#hairGrad)\"/>\n        <path d=\"M 188 240 Q 190 228 200 226 L 198 248 Q 192 246 188 240 Z\" fill=\"url(#hairGrad)\"/>\n\n        <!-- ear -->\n        <ellipse cx=\"187\" cy=\"248\" rx=\"4\" ry=\"6\" fill=\"url(#skinGrad)\"/>\n\n        <!-- eyes -->\n        <ellipse cx=\"208\" cy=\"248\" rx=\"2.2\" ry=\"2.8\" fill=\"#1a1a1a\"/>\n        <ellipse cx=\"232\" cy=\"248\" rx=\"2.2\" ry=\"2.8\" fill=\"#1a1a1a\"/>\n        <circle cx=\"208.5\" cy=\"247\" r=\"0.7\" fill=\"#fff\"/>\n        <circle cx=\"232.5\" cy=\"247\" r=\"0.7\" fill=\"#fff\"/>\n\n        <!-- eyebrows -->\n        <path d=\"M 202 241 Q 208 239 214 241\" stroke=\"#2a1f12\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M 226 241 Q 232 239 238 241\" stroke=\"#2a1f12\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/>\n\n        <!-- nose -->\n        <path d=\"M 220 252 L 217 262 Q 220 264 223 262\" stroke=\"#b88a65\" stroke-width=\"1\" fill=\"none\" stroke-linecap=\"round\"/>\n\n        <!-- subtle smile -->\n        <path d=\"M 213 270 Q 220 273 227 270\" stroke=\"#8a5a3a\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\"/>\n\n        <!-- arm holding mug -->\n        <path d=\"M 175 340 Q 160 360 170 385 Q 175 392 185 388 L 200 380 Q 205 375 202 368 L 195 345 Z\" fill=\"url(#hoodieGrad)\" stroke=\"#00D4FF\" stroke-opacity=\"0.25\"/>\n        <!-- hand -->\n        <ellipse cx=\"188\" cy=\"382\" rx=\"9\" ry=\"7\" fill=\"url(#skinGrad)\"/>\n\n        <!-- mug -->\n        <rect x=\"178\" y=\"370\" width=\"22\" height=\"20\" rx=\"2\" fill=\"#00D4FF\" opacity=\"0.85\"/>\n        <path d=\"M 200 374 Q 207 376 207 380 Q 207 384 200 386\" stroke=\"#00D4FF\" stroke-width=\"2\" fill=\"none\" opacity=\"0.85\"/>\n        <!-- steam -->\n        <path d=\"M 184 366 Q 182 360 186 356 Q 190 352 188 346\" stroke=\"#fff\" stroke-opacity=\"0.4\" stroke-width=\"1.5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M 192 366 Q 194 360 190 356 Q 188 352 192 346\" stroke=\"#fff\" stroke-opacity=\"0.3\" stroke-width=\"1.5\" fill=\"none\" stroke-linecap=\"round\"/>\n\n        <!-- other arm resting -->\n        <path d=\"M 265 335 Q 285 345 290 370 L 285 385 Q 278 388 273 383 L 260 360 Z\" fill=\"url(#hoodieGrad)\" stroke=\"#00D4FF\" stroke-opacity=\"0.25\"/>\n\n        <!-- floating particles / data bits -->\n        <g fill=\"#00D4FF\">\n          <circle cx=\"80\" cy=\"120\" r=\"2\" opacity=\"0.7\"/>\n          <circle cx=\"380\" cy=\"160\" r=\"1.5\" opacity=\"0.5\"/>\n          <circle cx=\"60\" cy=\"220\" r=\"1.5\" opacity=\"0.6\"/>\n          <circle cx=\"395\" cy=\"280\" r=\"2\" opacity=\"0.5\"/>\n          <circle cx=\"45\" cy=\"340\" r=\"1.5\" opacity=\"0.4\"/>\n        </g>\n        <g font-family=\"JetBrains Mono, monospace\" font-size=\"9\" fill=\"#00D4FF\" opacity=\"0.4\">\n          <text x=\"40\" y=\"80\">01</text>\n          <text x=\"395\" y=\"100\">AI</text>\n          <text x=\"35\" y=\"450\">›_</text>\n        </g>\n      </svg>\n\n      <div class=\"hero-stat\">\n        <div class=\"n\">3</div>\n        <div class=\"l\">deals · 9AM</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">Export PNG</button>\n\n<script>\n  document.getElementById('exportBtn').addEventListener('click', function() {\n    domtoimage.toPng(document.getElementById('post'), {\n      width:1200, height:630, quality:1.0,\n      style:{ transform:'scale(1)', transformOrigin:'top left' }\n    }).then(function(dataUrl){\n      var link = document.createElement('a');\n      link.download = 'accelod-monday-automated.png';\n      link.href = dataUrl;\n      link.click();\n    });\n  });\n</script>\n</body>\n</html>",
