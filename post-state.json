: normal;\n  background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n.subtitle {\n  font-family: 'DM Sans', sans-serif;\n  font-weight: 400;\n  font-size: 24px;\n  line-height: 1.5;\n  color: rgba(255,255,255,0.7);\n  margin-top: 28px;\n  max-width: 880px;\n}\n.panel {\n  background: #06101A;\n  border: 1px solid rgba(0,212,255,0.2);\n  border-radius: 16px;\n  padding: 40px;\n  margin-top: 40px;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 28px;\n}\n.col-title {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 14px;\n  font-weight: 500;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n  margin-bottom: 18px;\n}\n.col-stressed .col-title { color: #FF6B6B; }\n.col-auto .col-title { color: #00D4FF; }\n.col-line {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  font-family: 'DM Sans', sans-serif;\n  font-size: 20px;\n  line-height: 1.4;\n  color: rgba(255,255,255,0.85);\n  margin-bottom: 14px;\n}\n.col-line .dot {\n  flex-shrink: 0;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  margin-top: 9px;\n}\n.col-stressed .dot { background: #FF6B6B; }\n.col-auto .dot { background: #00D4FF; box-shadow: 0 0 12px #00D4FF; }\n.timestamp {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 16px;\n  color: rgba(255,255,255,0.4);\n  margin-top: 18px;\n  padding-top: 18px;\n  border-top: 1px dashed rgba(255,255,255,0.1);\n}\n.col-auto .timestamp { color: #33E1FF; }\n.stack-line {\n  margin-top: 32px;\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 22px;\n  font-weight: 500;\n  color: #FFFFFF;\n  text-align: center;\n}\n.stack-line span {\n  color: #00D4FF;\n}\n.bottom {\n  margin-top: auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.cta {\n  display: inline-flex;\n  align-items: center;\n  gap: 12px;\n  background: rgba(0,212,255,0.1);\n  border: 1.5px solid #00D