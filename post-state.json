r-spacing:-0.03em;\n    margin-top:26px;\n    color:#fff;\n    z-index:2;\n  }\n  .headline em {\n    font-style:normal;\n    background: linear-gradient(90deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-family:'DM Sans', sans-serif;\n    font-size:24px;\n    color:#8FA3B8;\n    margin-top:20px;\n    line-height:1.4;\n    max-width:900px;\n    z-index:2;\n  }\n  .panel {\n    margin-top:32px;\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:22px;\n    padding:34px 36px;\n    z-index:2;\n    flex:1;\n    display:flex; flex-direction:column;\n    gap:20px;\n  }\n  .stat-row {\n    display:flex; align-items:center; justify-content:space-between;\n    gap:20px;\n  }\n  .big-stat {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:76px;\n    letter-spacing:-0.03em;\n    background: linear-gradient(90deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    line-height:1;\n  }\n  .big-stat-label {\n    font-family:'JetBrains Mono', monospace;\n    font-size:18px;\n    color:#8FA3B8;\n    text-transform:uppercase;\n    letter-spacing:0.08em;\n    margin-top:6px;\n  }\n  .compare {\n    display:grid;\n    grid-template-columns: 1fr 1fr;\n    gap:16px;\n  }\n  .col {\n    border-radius:14px;\n    padding:22px 20px;\n  }\n  .col.bad {\n    background:rgba(239,68,68,0.08);\n    border:1px solid rgba(239,68,68,0.3);\n  }\n  .col.good {\n    background:rgba(0,212,255,0.08);\n    border:1px solid rgba(0,212,255,0.3);\n  }\n  .col-title {\n    font-family:'JetBrains Mono', monospace;\n    font-size:18px;\n    text-transform:uppercase;\n    letter-spacing:0.1em;\n    margin-bottom:14px;\n  }\n  .col.bad .col-title { color:#FF7B7B; }\n  .col.good .col-title { color:#00D4FF; }\n  .tool-row {\n    display:flex; align-items:center; gap:12px;\n    font-family:'DM Sans', sans-serif;\n    font-size:22px;\n    font-weight:500;\n    color:#E0E8F0;\n    padding:8px 0;\n  }\n  .tool-row img, .tool-row svg { width:36px; height:36px; object-fit:contain; flex-shrink:0; }\n  .tool-icon-emoji {\n    width:36px; height:36px;\n    display:flex; align-items:center; justify-content:center;\n    font-size:26px;\n  }\n  .lesson {\n    display:flex; align-items:center; gap:18px;\n    background:linear-gradient(90deg, rgba(0,212,255,0.15), rgba(0,212,255,0.03));\n    border-left:4px solid #00D4FF;\n    padding:20px 24px;\n    border-radius:12px;\n  }\n  .lesson-num {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:56px;\n    background: linear-gradient(90deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    line-height:1;\n  }\n  .lesson-text {\n    font-family:'Outfit', sans-serif;\n    font-weight:700;\n    font-size:24px;\n    color:#fff;\n    line-height:1.25;\n  }\n  .lesson-text span { color:#8FA3B8; font-weight:400; font-size:20px; display:block; margin-top:4px; }\n  .footer {\n    display:flex; align-items:center; justify-content:space-between;\n    margin-top:26px;\n    z-index:2;\n  }\n  .cta {\n    display:inline-flex; align-items:center; gap:12px;\n    padding:18px 30px;\n    background:linear-gradient(90deg, rgba(0,212,255,0.15), rgba(51,225,255,0.08));\n    border:1.5px solid #00D4FF;\n    border-radius:100px;\n    font-family:'DM Sans', sans-serif;\n    font-size:22px;\n    font-weight:500;\n    color:#fff;\n  }\n  .cta-dot { width:10px; height:10px; border-radius:50%; background:#00D4FF; box-shadow:0 0 12px #00D4FF; }\n  .logo {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:32px;\n    letter-spacing:-0.02em;\n    background: linear-gradient(90deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  #export {\n    padding:14px 28px;\n    background:#00D4FF; color:#0B1929;\n    border:none; border-radius:8px;\n    font-family:'DM Sans'; font-weight:500; font-size:16px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"glow-tl\"></div>\n  <div class=\"dot-grid\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge\">\n    <svg viewBox=\"0 0 100 100\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n    AI Automation\n  </div>\n\n  <h1 class=\"headline\">DIY automation<br>always <em>breaks</em>.</h1>\n  <p class=\"subtitle\">He spent 6 months and £4,200 building an automation that broke every Tuesday.</p>\n\n  <div class=\"panel\">\n\n    <div class=\"stat-row\">\n      <div>\n        <div class=\"big-stat\">£4,200</div>\n        <div class=\"big-stat-label\">Sunk cost · DIY stack</div>\n      </div>\n      <div style=\"text-align:right;\">\n        <div class=\"big-stat\">6 mo</div>\n        <div class=\"big-stat-label\">Before it collapsed</div>\n      </div>\n    </div>\n\n    <div class=\"compare\">\n      <div class=\"col bad\">\n        <div class=\"col-title\">✗ The duct-tape stack</div>\n        <div class=\"tool-row\"><div class=\"tool-icon-emoji\">⚡</div>Zapier (14 zaps)</div>\n        <div class=\"tool-row\"><img src=\"https://cdn.simpleicons.org/google\" alt=\"Sheets\">Sheets as database</div>\n        <div class=\"tool-row\"><img src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"ChatGPT\">ChatGPT copy-paste</div>\n        <div class=\"tool-row\"><div class=\"tool-icon-emoji\">📧</div>Manual email triggers</div>\n      </div>\n      <div class=\"col good\">\n        <div class=\"col-title\">✓ What replaced it</div>\n        <div class=\"tool-row\"><img src=\"https://cdn.simpleicons.org/n8n/EA4B71\" alt=\"n8n\">n8n workflows</div>\n        <div class=\"tool-row\"><svg width=\"36\" height=\"36\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>GoHighLevel CRM</div>\n        <div class=\"tool-row\"><img src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\">Claude API</div>\n        <div class=\"tool-row\"><div class=\"tool-icon-emoji\">🔁</div>One clean pipeline</div>\n      </div>\n    </div>\n\n    <div class=\"lesson\">\n      <div class=\"lesson-num\">01</div>\n      <div class=\"lesson-text\">Cheap automation is the most expensive kind.<span>Every Tuesday cost him a client.</span></div>\n    </div>\n\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta\"><span class=\"cta-dot\"></span>Sound familiar?</div>\n    <div class=\"logo\">Accelod</div>\n  </div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\ndocument.getElementById('export').addEventListener('click', () => {\n  const node = document.getElementById('post');\n  domtoimage.toPng(node, { width:1080, height:1350, quality:1, scale:1 })\n    .then(dataUrl => {\n      const link = document.createElement('a');\n      link.download = 'accelod-diy-broke.png';\n      link.href = dataUrl;\n      link.click();\n    });\n});\n</script>\n</body>\n</html>",
