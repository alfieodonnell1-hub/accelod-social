ius: 999px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: 0.5px;\n    width: fit-content;\n    background: rgba(0,212,255,0.05);\n  }\n  .badge svg { width: 12px; height: 12px; }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 64px;\n    line-height: 0.95;\n    color: white;\n    margin-top: 20px;\n    letter-spacing: -1.8px;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .boy-scene {\n    margin-top: 22px;\n    display: flex;\n    align-items: flex-end;\n    gap: 14px;\n  }\n  .boy {\n    width: 90px;\n    height: 110px;\n    flex-shrink: 0;\n  }\n  .bubble {\n    background: white;\n    color: #0B1929;\n    padding: 12px 16px;\n    border-radius: 16px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 18px;\n    line-height: 1.2;\n    position: relative;\n    box-shadow: 0 4px 20px rgba(0,212,255,0.2);\n    max-width: 220px;\n  }\n  .bubble::after {\n    content: '';\n    position: absolute;\n    left: -10px;\n    bottom: 18px;\n    width: 0;\n    height: 0;\n    border-top: 8px solid transparent;\n    border-bottom: 8px solid transparent;\n    border-right: 12px solid white;\n  }\n  .bubble .claude-icon {\n    display: inline-block;\n    width: 18px;\n    height: 18px;\n    vertical-align: -3px;\n    color: #00D4FF;\n    margin-right: 2px;\n  }\n  .logo {\n    margin-top: auto;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 28px;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -0.5px;\n  }\n  .right {\n    flex: 1;\n    padding: 40px 44px 40px 20px;\n    position: relative;\n    z-index: 2;\n    display: flex;\n  }\n  .panel {\n    flex: 1;\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 28px 32px;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n  .panel-header {\n    display: flex;\n    justify-content: space-between;\n    padding-bottom: 10px;\n    border-bottom: 1px dashed rgba(0,212,255,0.15);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n    font-weight: 500;\n  }\n  .panel-header .myth { color: #ff5c7a; }\n  .panel-header .reality { color: #33E1FF; }\n  .row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n    align-items: center;\n    padding: 2px 0;\n  }\n  .myth-txt {\n    color: rgba(255,255,255,0.55);\n    font-size: 19px;\n    font-weight: 500;\n    line-height: 1.25;\n    text-decoration: line-through;\n    text-decoration-color: rgba(255,92,122,0.6);\n  }\n  .reality-txt {\n    color: white;\n    font-size: 20px;\n    font-weight: 600;\n    line-height: 1.25;\n    position: relative;\n    padding-left: 18px;\n  }\n  .reality-txt::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 9px;\n    width: 9px;\n    height: 9px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    border-radius: 50%;\n    box-shadow: 0 0 10px rgba(0,212,255,0.6);\n  }\n  .reality-txt b {\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    font-weight: 800;\n  }\n  .divider {\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(0,212,255,0.15), transparent);\n  }\n  #export {\n    margin-top: 24px;\n    padding: 12px 24px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    color: #0B1929;\n    border: none;\n    border-radius: 8px;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 700;\n    font-size: 14px;\n    cursor: pointer;\n    letter-spacing: 0.5px;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n  <symbol id=\"boy-character\" viewBox=\"0 0 90 110\">\n    <!-- Head -->\n    <circle cx=\"45\" cy=\"28\" r=\"18\" fill=\"#F5C89A\"/>\n    <!-- Hair -->\n    <path d=\"M28 24 Q28 10 45 10 Q62 10 62 24 Q62 18 55 16 Q50 12 45 13 Q40 12 35 16 Q28 18 28 24 Z\" fill=\"#3A2818\"/>\n    <!-- Eyes -->\n    <circle cx=\"39\" cy=\"28\" r=\"2\" fill=\"#1a1a1a\"/>\n    <circle cx=\"51\" cy=\"28\" r=\"2\" fill=\"#1a1a1a\"/>\n    <!-- Smile -->\n    <path d=\"M40 35 Q45 39 50 35\" stroke=\"#8B4513\" stroke-width=\"1.5\" fill=\"none\" stroke-linecap=\"round\"/>\n    <!-- Neck -->\n    <rect x=\"41\" y=\"44\" width=\"8\" height=\"6\" fill=\"#F5C89A\"/>\n    <!-- Body / Shirt -->\n    <path d=\"M22 58 Q22 52 30 50 L60 50 Q68 52 68 58 L68 95 Q68 100 63 100 L27 100 Q22 100 22 95 Z\" fill=\"#00D4FF\"/>\n    <!-- Shirt accent -->\n    <path d=\"M40 50 L45 60 L50 50\" stroke=\"#0B1929\" stroke-width=\"1.5\" fill=\"none\"/>\n    <!-- Arm raised (pointing) -->\n    <path d=\"M22 58 Q10 55 8 45 Q7 40 12 40 Q15 42 16 46 Q22 52 22 58 Z\" fill=\"#F5C89A\"/>\n    <!-- Other arm -->\n    <path d=\"M68 58 Q76 68 74 82 Q73 86 69 85 Q67 80 66 72 Z\" fill=\"#00D4FF\"/>\n    <!-- Pants -->\n    <rect x=\"28\" y=\"95\" width=\"14\" height=\"15\" fill=\"#1a3a5a\"/>\n    <rect x=\"48\" y=\"95\" width=\"14\" height=\"15\" fill=\"#1a3a5a\"/>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <svg><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n    <div class=\"headline\">AI isn't the<br>problem.<br><em>Bad systems</em><br>are.</div>\n\n    <div class=\"boy-scene\">\n      <svg class=\"boy\"><use href=\"#boy-character\"/></svg>\n      <div class=\"bubble\">\n        <svg class=\"claude-icon\"><use href=\"#claude-star\"/></svg>\n        Wait, AI won't replace me?\n      </div>\n    </div>\n\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-header\">\n        <span class=\"myth\">▲ Myth</span>\n        <span class=\"reality\">◆ Reality</span>\n      </div>\n\n      <div class=\"row\">\n        <div class=\"myth-txt\">\"AI replaces my team.\"</div>\n        <div class=\"reality-txt\">Replaces <b>busywork</b>, not people.</div>\n      </div>\n      <div class=\"divider\"></div>\n\n      <div class=\"row\">\n        <div class=\"myth-txt\">\"Too expensive.\"</div>\n        <div class=\"reality-txt\">Pays back in <b>&lt;60 days</b>.</div>\n      </div>\n      <div class=\"divider\"></div>\n\n      <div class=\"row\">\n        <div class=\"myth-txt\">\"Too complex to set up.\"</div>\n        <div class=\"reality-txt\">Live in <b>2 weeks</b>. No code.</div>\n      </div>\n      <div class=\"divider\"></div>\n\n      <div class=\"row\">\n        <div class=\"myth-txt\">\"Only for tech firms.\"</div>\n        <div class=\"reality-txt\"><b>87%</b> of clients aren't tech.</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<button id=\"export\">⬇ Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1200, height: 630, quality: 1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-myth-vs-reality.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>",
