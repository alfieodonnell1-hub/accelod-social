er-spacing:-0.035em; margin-bottom:18px; z-index:2; position:relative; }\n  .headline em { font-style:normal; background:linear-gradient(90deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\n  .subtitle { font-size:23px; color:rgba(255,255,255,0.6); line-height:1.4; margin-bottom:26px; max-width:900px; z-index:2; position:relative; }\n\n  .panel { background:#06101A; border:1px solid rgba(0,212,255,0.2); border-radius:20px; padding:28px; z-index:2; position:relative; display:flex; flex-direction:column; gap:20px; flex:1; }\n\n  .compare-head { display:grid; grid-template-columns:1fr 1fr; gap:18px; }\n  .col-head { display:flex; align-items:baseline; gap:12px; }\n  .col-num { font-family:'Outfit',sans-serif; font-weight:900; font-size:72px; line-height:1; letter-spacing:-0.03em; }\n  .col-num.bad { color:#EF4444; }\n  .col-num.good { background:linear-gradient(90deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\n  .col-title { font-family:'JetBrains Mono',monospace; font-size:18px; text-transform:uppercase; letter-spacing:0.08em; }\n  .col-title.bad { color:#EF4444; }\n  .col-title.good { color:#00D4FF; }\n  .col-sub { font-family:'JetBrains Mono',monospace; font-size:14px; color:rgba(255,255,255,0.4); text-transform:uppercase; letter-spacing:0.08em; margin-top:4px; }\n\n  .messy-box { background:rgba(239,68,68,0.05); border:1px dashed rgba(239,68,68,0.3); border-radius:14px; padding:18px; }\n  .messy-grid { display:flex; flex-wrap:wrap; gap:8px; }\n  .messy-chip { font-family:'JetBrains Mono',monospace; font-size:14px; color:rgba(255,255,255,0.55); background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); padding:8px 12px; border-radius:8px; }\n  .messy-chip.strike { text-decoration:line-through; text-decoration-color:rgba(239,68,68,0.6); opacity:0.6; }\n\n  .clean-stack { display:flex; flex-direction:column; gap:12px; }\n  .tool-row { display:flex; align-items:center; gap:14px; padding:14px 16px; background:rgba(0,212,255,0.05); border:1px solid rgba(0,212,255,0.18); border-radius:12px; }\n  .tool-logo { width:38px; height:38px; object-fit:contain; flex-shrink:0; }\n  .tool-name { font-family:'Outfit',sans-serif; font-weight:700; font-size:22px; color:#fff; }\n  .tool-role { font-family:'DM Sans',sans-serif; font-size:16px; color:rgba(255,255,255,0.5); flex:1; }\n  .tool-tag { font-family:'JetBrains Mono',monospace; font-size:13px; color:#00D4FF; background:rgba(0,212,255,0.1); border:1px solid rgba(0,212,255,0.25); border-radius:6px; padding:4px 10px; white-space:nowrap; }\n\n  .divider-label { display:flex; align-items:center; gap:14px; margin:4px 0; }\n  .divider-label .line { flex:1; height:1px; background:rgba(0,212,255,0.2); }\n  .divider-label .txt { font-family:'JetBrains Mono',monospace; font-size:15px; color:#00D4FF; text-transform:uppercase; letter-spacing:0.1em; }\n\n  .insight { display:flex; gap:16px; align-items:flex-start; background:rgba(0,212,255,0.06); border:1px solid rgba(0,212,255,0.22); border-radius:14px; padding:18px 20px; }\n  .insight-icon { width:44px; height:44px; border-radius:10px; background:linear-gradient(135deg,#00D4FF,#33E1FF); display:flex; align-items:center; justify-content:center; font-family:'Outfit',sans-serif; font-weight:900; font-size:24px; color:#0B1929; flex-shrink:0; }\n  .insight-title { font-family:'Outfit',sans-serif; font-weight:700; font-size:22px; color:#fff; line-height:1.2; margin-bottom:4px; }\n  .insight-desc { font-size:17px; color:rgba(255,255,255,0.55); line-height:1.35; }\n\n  .footer { display:flex; align-items:center; justify-content:space-between; margin-top:22px; z-index:2; position:relative; }\n  .cta { display:inline-flex; align-items:center; gap:10px; padding:18px 30px; background:rgba(0,212,255,0.1); border:1.5px solid #00D4FF; border-radius:100px; font-family:'DM Sans',sans-serif; font-size:22px; font-weight:500; color:#fff; }\n  .cta-dot { width:10px; height:10px; border-radius:50%; background:#00D4FF; box-shadow:0 0 10px #00D4FF; }\n  .logo { font-family:'Outfit',sans-serif; font-weight:900; font-size:32px; letter-spacing:-0.02em; background:linear-gradient(90deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\n  button { padding:12px 24px; background:#00D4FF; color:#0B1929; border:none; border-radius:8px; font-size:15px; cursor:pointer; }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge-row\">\n    <div class=\"badge cyan\"><svg width=\"14\" height=\"14\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>AI Automation</div>\n    <div class=\"badge dark\"><div class=\"badge-dot\" style=\"background:#EF4444\"></div>Myth Bust</div>\n  </div>\n\n  <h1 class=\"headline\">The tool stack<br><em>lie.</em></h1>\n  <p class=\"subtitle\">You don't need 47 SaaS subscriptions. You need one thing: a brain that connects them.</p>\n\n  <div class=\"panel\">\n    <div class=\"compare-head\">\n      <div>\n        <div class=\"col-head\"><div class=\"col-num bad\">15+</div><div><div class=\"col-title bad\">✗ Duct-tape</div><div class=\"col-sub\">Disconnected apps</div></div></div>\n      </div>\n      <div>\n        <div class=\"col-head\"><div class=\"col-num good\">4</div><div><div class=\"col-title good\">✓ Integrated</div><div class=\"col-sub\">One brain</div></div></div>\n      </div>\n    </div>\n\n    <div class=\"messy-box\">\n      <div class=\"messy-grid\">\n        <span class=\"messy-chip strike\">Zapier</span>\n        <span class=\"messy-chip strike\">Make</span>\n        <span class=\"messy-chip strike\">Airtable</span>\n        <span class=\"messy-chip strike\">Notion</span>\n        <span class=\"messy-chip strike\">Trello</span>\n        <span class=\"messy-chip strike\">Slack bots</span>\n        <span class=\"messy-chip strike\">HubSpot</span>\n        <span class=\"messy-chip strike\">Mailchimp</span>\n        <span class=\"messy-chip strike\">Calendly</span>\n        <span class=\"messy-chip strike\">Typeform</span>\n        <span class=\"messy-chip strike\">Sheets</span>\n        <span class=\"messy-chip strike\">ChatGPT</span>\n        <span class=\"messy-chip strike\">Pipedrive</span>\n        <span class=\"messy-chip strike\">Asana</span>\n        <span class=\"messy-chip strike\">+more</span>\n      </div>\n    </div>\n\n    <div class=\"divider-label\"><div class=\"line\"></div><div class=\"txt\">↓ Replaced by ↓</div><div class=\"line\"></div></div>\n\n    <div class=\"clean-stack\">\n      <div class=\"tool-row\">\n        <img class=\"tool-logo\" src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\">\n        <span class=\"tool-name\">Claude</span>\n        <span class=\"tool-role\">— the brain</span>\n        <span class=\"tool-tag\">reasoning</span>\n      </div>\n      <div class=\"tool-row\">\n        <img class=\"tool-logo\" src=\"https://cdn.simpleicons.org/n8n/EA4B71\" alt=\"n8n\">\n        <span class=\"tool-name\">N8N</span>\n        <span class=\"tool-role\">— the nervous system</span>\n        <span class=\"tool-tag\">workflows</span>\n      </div>\n      <div class=\"tool-row\">\n        <svg class=\"tool-logo\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>\n        <span class=\"tool-name\">GoHighLevel</span>\n        <span class=\"tool-role\">— the CRM engine</span>\n        <span class=\"tool-tag\">leads + comms</span>\n      </div>\n      <div class=\"tool-row\">\n        <img class=\"tool-logo\" src=\"https://cdn.simpleicons.org/google\" alt=\"Google\">\n        <span class=\"tool-name\">Google Workspace</span>\n        <span class=\"tool-role\">— the source of truth</span>\n        <span class=\"tool-tag\">data</span>\n      </div>\n    </div>\n\n    <div class=\"insight\">\n      <div class=\"insight-icon\">!</div>\n      <div>\n        <div class=\"insight-title\">Tool count doesn't win. Integration does.</div>\n        <div class=\"insight-desc\">A stack of 4 that talks beats a stack of 40 that doesn't.</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta\"><span class=\"cta-dot\"></span>Stacking apps again?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n</div>\n<button onclick=\"domtoimage.toPng(document.getElementById('post'),{width:1080,height:1350,quality:1}).then(d=>{const l=document.createElement('a');l.download='accelod-tool-stack-lie.png';l.href=d;l.click();})\">Export PNG</button>\n</body>\n</html>",
