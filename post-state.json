', monospace;\n    font-size:13px;\n    font-weight:500;\n    color:#00D4FF;\n    align-self:flex-start;\n    letter-spacing:0.5px;\n  }\n  .badge svg { width:14px; height:14px; }\n  .headline {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:62px;\n    line-height:0.96;\n    color:#fff;\n    margin-top:22px;\n    letter-spacing:-1.5px;\n  }\n  .headline em {\n    font-style:normal;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-family:'DM Sans', sans-serif;\n    font-size:20px;\n    font-weight:400;\n    color:rgba(255,255,255,0.7);\n    margin-top:18px;\n    line-height:1.4;\n  }\n  .cta-pill {\n    display:inline-flex;\n    align-items:center;\n    gap:8px;\n    padding:12px 20px;\n    background:rgba(0,212,255,0.1);\n    border:1px solid rgba(0,212,255,0.4);\n    border-radius:999px;\n    color:#33E1FF;\n    font-size:14px;\n    font-weight:500;\n    font-family:'JetBrains Mono', monospace;\n    margin-top:auto;\n    align-self:flex-start;\n  }\n  .cta-pill::before {\n    content:'';\n    width:8px; height:8px;\n    background:#00D4FF;\n    border-radius:50%;\n    box-shadow:0 0 12px #00D4FF;\n  }\n  .logo {\n    margin-top:16px;\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:22px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    letter-spacing:-0.5px;\n  }\n  .right-panel {\n    flex:1;\n    margin:44px 44px 44px 0;\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:36px 38px;\n    position:relative;\n    z-index:2;\n    display:flex;\n    flex-direction:column;\n  }\n  .panel-title {\n    font-family:'JetBrains Mono', monospace;\n    font-size:12px;\n    color:#00D4FF;\n    letter-spacing