dius: 999px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 14px;\n    font-weight: 500;\n    letter-spacing: 0.5px;\n    width: fit-content;\n    background: rgba(255,138,42,0.08);\n  }\n  .badge svg { width: 16px; height: 16px; }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 96px;\n    line-height: 0.92;\n    color: white;\n    margin-top: 22px;\n    letter-spacing: -3px;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #FF8A2A 0%, #FFB366 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .character {\n    display: flex;\n    align-items: flex-end;\n    gap: 12px;\n    margin-top: 26px;\n  }\n  .boy-svg { width: 110px; height: 140px; flex-shrink: 0; }\n  .speech {\n    position: relative;\n    background: white;\n    color: #0B1929;\n    padding: 14px 20px;\n    border-radius: 16px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 22px;\n    line-height: 1.2;\n    max-width: 280px;\n    margin-bottom: 40px;\n  }\n  .speech::after {\n    content: '';\n    position: absolute;\n    left: -10px;\n    bottom: 18px;\n    width: 0;\n    height: 0;\n    border-top: 8px solid transparent;\n    border-bottom: 8px solid transparent;\n    border-right: 12px solid white;\n  }\n  .speech span {\n    color: #FF8A2A;\n  }\n  .logo {\n    margin-top: auto;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 32px;\n    color: white;\n    letter-spacing: -0.5px;\n  }\n  .claudebot-icon {\n    width: 38px;\n    height: 38px;\n    color: #FF8A2A;\n    filter: drop-shadow(0 0 10px rgba(255,138,42,0.6));\n  }\n  .right {\n    flex: 1;\n    padding: 44px 44px 44px 12px;\n    position: relative;\n    z-index: 2;\n    display: flex;\n  }\n  .panel {\n    flex: 1;\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 30px 32px;\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n  }\n  .panel-header {\n    display: flex;\n    justify-content: space-between;\n    padding-bottom: 12px;\n    border-bottom: 1px dashed rgba(0,212,255,0.15);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 14px;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n  }\n  .panel-header .myth { color: #ff5c7a; }\n  .panel-header .reality { color: #33E1FF; }\n  .row {\n    display: grid;\n    grid-template-columns: 1fr 1.15fr;\n    gap: 20px;\n    align-items: center;\n    padding: 4px 0;\n  }\n  .myth-txt {\n    color: rgba(255,255,255,0.55);\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.3;\n    text-decoration: line-through;\n    text-decoration-color: rgba(255,92,122,0.5);\n  }\n  .reality-txt {\n    color: white;\n    font-size: 18px;\n    font-weight: 600;\n    line-height: 1.3;\n    position: relative;\n    padding-left: 18px;\n  }\n  .reality-txt::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 9px;\n    width: 9px;\n    height: 9px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    border-radius: 50%;\n    box-shadow: 0 0 10px rgba(0,212,255,0.6);\n  }\n  .reality-txt b {\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    font-weight: 800;\n  }\n  .divider {\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(0,212,255,0.15), transparent);\n  }\n  #export {\n    margin-top: 24px;\n    padding: 12px 24px;\n    background: linear-gradient(135deg, #FF8A2A, #FFB366);\n    color: #0B1929;\n    border: none;\n    border-radius: 8px;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 700;\n    font-size: 14px;\n    cursor: pointer;\n    letter-spacing: 0.5px;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L2,-8 L0,0 L-2,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"boy\" viewBox=\"0 0 110 140\">\n    <path d=\"M30 38 Q30 18 55 15 Q80 18 80 38 L80 46 Q75 30 55 30 Q35 30 30 46 Z\" fill=\"#2a1a10\"/>\n    <rect x=\"49\" y=\"55\" width=\"12\" height=\"12\" fill=\"#e8b898\"/>\n    <ellipse cx=\"55\" cy=\"42\" rx=\"22\" ry=\"25\" fill=\"#f2c9a8\"/>\n    <path d=\"M33 38 Q35 22 55 20 Q75 22 77 38 Q70 28 55 30 Q42 30 33 40 Z\" fill=\"#2a1a10\"/>\n    <circle cx=\"47\" cy=\"42\" r=\"2.5\" fill=\"#0B1929\"/>\n    <circle cx=\"63\" cy=\"42\" r=\"2.5\" fill=\"#0B1929\"/>\n    <path d=\"M48 52 Q55 57 62 52\" stroke=\"#8b4a2b\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n    <path d=\"M25 140 L25 82 Q25 68 40 65 L70 65 Q85 68 85 82 L85 140 Z\" fill=\"#00D4FF\"/>\n    <path d=\"M40 65 L55 90 L70 65 Z\" fill=\"#33E1FF\" opacity=\"0.5\"/>\n    <path d=\"M25 82 Q12 78 10 62 Q10 56 16 56 Q22 58 22 68 L28 90 Z\" fill=\"#f2c9a8\"/>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#FF8A2A\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <svg style=\"color:#FF8A2A\"><use href=\"#claude-star\"/></svg>\n      MYTH vs REALITY\n    </div>\n    <div class=\"headline\">Myth vs<br><em>reality</em></div>\n\n    <div class=\"character\">\n      <svg class=\"boy-svg\"><use href=\"#boy\"/></svg>\n      <div class=\"speech\">Wait… <span>really?</span></div>\n    </div>\n\n    <div class=\"logo\">\n      <svg class=\"claudebot-icon\"><use href=\"#claude-star\"/></svg>\n      Accelod AI\n    </div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-header\">\n        <span class=\"myth\">▲ MYTH</span>\n        <span class=\"reality\">◆ REALITY</span>\n      </div>\n\n      <div class=\"row\">\n        <div class=\"myth-txt\">\"AI replaces my team.\"</div>\n        <div class=\"reality-txt\">Replaces <b>busywork</b>, not people.</div>\n      </div>\n      <div class=\"divider\"></div>\n\n      <div class=\"row\">\n        <div class=\"myth-txt\">\"Too expensive.\"</div>\n        <div class=\"reality-txt\">Pays back in <b>&lt;60 days</b>.</div>\n      </div>\n      <div class=\"divider\"></div>\n\n      <div class=\"row\">\n        <div class=\"myth-txt\">\"Too complex to set up.\"</div>\n        <div class=\"reality-txt\">Live in <b>2 weeks</b>. No code.</div>\n      </div>\n      <div class=\"divider\"></div>\n\n      <div class=\"row\">\n        <div class=\"myth-txt\">\"Only for tech companies.\"</div>\n        <div class=\"reality-txt\"><b>87%</b> of clients aren't tech.</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<button id=\"export\">⬇ Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1200, height: 630, quality: 1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-myth-vs-reality.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>",
