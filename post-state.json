  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI — Inbox Audit</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    background:#1a1a1a; min-height:100vh;\n    display:flex; flex-direction:column; align-items:center; padding:24px;\n    font-family:'DM Sans',sans-serif;\n  }\n  #export {\n    margin-bottom:20px; padding:12px 24px; background:#00D4FF; color:#0B1929;\n    border:none; border-radius:8px; font-weight:700; cursor:pointer; font-size:14px;\n    font-family:'DM Sans',sans-serif;\n  }\n  #post {\n    width:1080px; height:1350px; background:#0B1929; position:relative;\n    overflow:hidden; padding:70px 70px 60px; display:flex; flex-direction:column;\n    font-family:'DM Sans',sans-serif; color:#fff;\n  }\n  .dot-grid {\n    position:absolute; inset:0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 28px 28px;\n    pointer-events:none;\n  }\n  .glow {\n    position:absolute; top:-200px; left:-200px; width:700px; height:700px;\n    background: radial-gradient(circle, rgba(0,212,255,0.18) 0%, transparent 60%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute; top:40px; right:-60px; width:520px; height:520px;\n    opacity:0.05; transform:rotate(12deg); pointer-events:none;\n  }\n  .content { position:relative; z-index:2; display:flex; flex-direction:column; height:100%; }\n  .badge {\n    display:inline-flex; align-items:center; gap:10px;\n    border:1.5px solid #00D4FF; padding:10px 20px; border-radius:999px;\n    font-family:'JetBrains Mono',monospace; font-size:18px; color:#00D4FF;\n    align-self:flex-start; font-weight:500;\n  }\n  .badge svg { width:18px; height:18px; }\n  h1 {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:104px;\n    line-height:0.96; letter-spacing:-0.03em; margin-top:28px; color:#fff;\n  }\n  h1 em {\n    font-style:normal;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-size:24px; color:#8FA3B8; margin-top:22px; font-weight:400;\n    line-height:1.4; max-width:900px;\n  }\n  .panel {\n    background:#06101A; border:1px solid rgba(0,212,255,0.2); border-radius:16px;\n    padding:32px; margin-top:32px; flex:1; display:flex; flex-direction:column; gap:18px;\n  }\n  .stat-hero {\n    display:flex; align-items:center; justify-content:space-between;\n    background: linear-gradient(90deg, rgba(0,212,255,0.12), rgba(0,212,255,0.02));\n    border-left:4px solid #00D4FF; border-radius:10px; padding:22px 26px;\n  }\n  .stat-hero .num {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:82px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent;\n    line-height:1; letter-spacing:-0.02em;\n  }\n  .stat-hero .label {\n    font-family:'JetBrains Mono',monospace; font-size:20px; color:#8FA3B8;\n    text-transform:uppercase; letter-spacing:0.08em; text-align:right;\n  }\n  .stat-hero .label strong { color:#fff; display:block; font-size:22px; margin-top:4px; }\n  .row {\n    display:flex; align-items:center; gap:18px;\n    padding:16px 20px; border-radius:10px;\n  }\n  .row.alt { background:rgba(0,212,255,0.05); }\n  .row .idx {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:32px;\n    color:#00D4FF; min-width:44px;\n  }\n  .row .icon {\n    width:40px; height:40px; display:flex; align-items:center; justify-content:center;\n    background:#0B1929; border-radius:8px; border:1px solid rgba(0,212,255,0.15);\n  }\n  .row .icon img { width:24px; height:24px; object-fit:contain; }\n  .row .text { font-size:22px; color:#E8F1F8; font-weight:500; flex:1; }\n  .row .text span { color:#8FA3B8; font-size:20px; display:block; margin-top:2px; font-weight:400; }\n  .row .tag {\n    font-family:'JetBrains Mono',monospace; font-size:18px; color:#00D4FF;\n    background:rgba(0,212,255,0.1); padding:6px 12px; border-radius:6px;\n  }\n  .compare {\n    display:grid; grid-template-columns:1fr auto 1fr; gap:18px; align-items:center;\n    padding:18px 0;\n  }\n  .compare .side {\n    background:#0B1929; border:1px solid rgba(255,255,255,0.08); border-radius:12px;\n    padding:20px; text-align:center;\n  }\n  .compare .side.win { border-color:rgba(0,212,255,0.4); }\n  .compare .side .big {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:56px; line-height:1;\n    color:#fff; margin-bottom:6px;\n  }\n  .compare .side.win .big {\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent;\n  }\n  .compare .side .cap {\n    font-family:'JetBrains Mono',monospace; font-size:18px; color:#8FA3B8;\n    text-transform:uppercase; letter-spacing:0.05em;\n  }\n  .compare .arrow {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:44px; color:#00D4FF;\n  }\n  .footer {\n    display:flex; align-items:center; justify-content:space-between; margin-top:28px;\n  }\n  .cta {\n    display:inline-flex; align-items:center; gap:12px;\n    background:linear-gradient(135deg, #00D4FF, #33E1FF); color:#0B1929;\n    padding:18px 32px; border-radius:999px; font-weight:700; font-size:22px;\n    font-family:'DM Sans',sans-serif;\n  }\n  .cta::before {\n    content:''; width:10px; height:10px; background:#0B1929; border-radius:50%;\n  }\n  .logo {\n    font-family:'Outfit',sans-serif; font-weight:900; font-size:30px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip:text; -webkit-text-fill-color:transparent;\n    letter-spacing:-0.02em;\n  }\n</style>\n</head>\n<body>\n<button id=\"export\">Export PNG</button>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\"/>\n      <rect x=\"5\" y=\"48\" width=\"90\" height=\"4\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"content\">\n    <div class=\"badge\">\n      <svg viewBox=\"0 0 100 100\"><use href=\"#claude-star\"/></svg>\n      AI AUTOMATION\n    </div>\n\n    <h1>I asked Claude to audit my <em>inbox</em>.</h1>\n    <p class=\"subtitle\">Your inbox isn't a to-do list. It's a tax on your attention. Here's what one afternoon with Claude + Google Workspace actually returned.</p>\n\n    <div class=\"panel\">\n      <div class=\"stat-hero\">\n        <div class=\"num\">6.2 hrs</div>\n        <div class=\"label\">reclaimed<strong>every single week</strong></div>\n      </div>\n\n      <div class=\"compare\">\n        <div class=\"side\">\n          <div class=\"big\">247</div>\n          <div class=\"cap\">unread · before</div>\n        </div>\n        <div class=\"arrow\">→</div>\n        <div class=\"side win\">\n          <div class=\"big\">12</div>\n          <div class=\"cap\">priority · after</div>\n        </div>\n      </div>\n\n      <div class=\"row alt\">\n        <div class=\"idx\">01</div>\n        <div class=\"icon\"><img src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\"></div>\n        <div class=\"text\">Claude scans & categorises threads<span>Sorted by intent, not sender</span></div>\n        <div class=\"tag\">SORT</div>\n      </div>\n\n      <div class=\"row\">\n        <div class=\"idx\">02</div>\n        <div class=\"icon\"><img src=\"https://cdn.simpleicons.org/google\" alt=\"Google\"></div>\n        <div class=\"text\">Google Workspace surfaces priority<span>VIPs & deadlines bubble to the top</span></div>\n        <div class=\"tag\">FLAG</div>\n      </div>\n\n      <div class=\"row alt\">\n        <div class=\"idx\">03</div>\n        <div class=\"icon\"><img src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\"></div>\n        <div class=\"text\">Drafts replies in your voice<span>Review, tweak, send in 30 seconds</span></div>\n        <div class=\"tag\">DRAFT</div>\n      </div>\n    </div>\n\n    <div class=\"footer\">\n      <div class=\"cta\">Sound familiar?</div>\n      <div class=\"logo\">ACCELOD AI</div>\n    </div>\n  </div>\n</div>\n\n<script>\n  document.getElementById('export').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1080, height:1350, quality:1, bgcolor:'#0B1929' })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-inbox-audit.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>",
  "fb_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI — Inbox Audit</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    background: #1a1a1a;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 24px;\n    font-family: 'DM Sans', sans-serif;\n  }\n  #post {\n    width: 1200px;\n    height: 630px;\n    background: #0B1929;\n    position: relative;\n    overflow: hidden;\n    display: flex;\n    font-family: 'DM Sans', sans-serif;\n  }\n  .dot-grid {\n    position: absolute;\n    inset: 0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 24px 24px;\n    pointer-events: none;\n  }\n  .glow {\n    position: absolute;\n    top: -200px;\n    left: -200px;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(0,212,255,0.18) 0%, transparent 60%);\n    pointer-events: none;\n  }\n  .watermark {\n    position: absolute;\n    top: 30px;\n    right: 30px;\n    opacity: 0.05;\n    transform: rotate(12deg);\n    pointer-events: none;\n  }\n  .left {\n    width: 360px;\n    padding: 44px 32px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    position: relative;\n    z-index: 2;\n  }\n  .badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    border: 1px solid rgba(0,212,255,0.5);\n    border-radius: 999px;\n    padding: 8px 16px;\n    color: #00D4FF;\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 500;\n    font-size: 13px;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    width: fit-content;\n    background: rgba(0,212,255,0.05);\n  }\n  .badge svg { width: 14px; height: 14px; }\n  h1 {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 62px;\n    line-height: 0.95;\n    letter-spacing: -0.03em;\n    color: #fff;\n    margin-top: 24px;\n  }\n  h1 em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .subtitle {\n    font-size: 16px;\n    color: #8ba3bd;\n    line-height: 1.4;\n    margin-top: 18px;\n    font-weight: 400;\n  }\n  .cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: rgba(0,212,255,0.1);\n    border: 1px solid rgba(0,212,255,0.3);\n    border-radius: 999px;\n    padding: 10px 18px;\n    color: #00D4FF;\n    font-size: 14px;\n    font-weight: 500;\n    width: fit-content;\n    margin-top: 20px;\n  }\n  .logo {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 22px;\n    letter-spacing: -0.02em;\n  }\n  .logo-dot {\n    width: 12px;\n    height: 12px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n  }\n  .logo-text {\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n  .right {\n    flex: 1;\n    padding: 32px 36px 32px 0;\n    display: flex;\n    align-items: center;\n    position: relative;\n    z-index: 2;\n  }\n  .panel {\n    width: 100%;\n    height: 100%;\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 28px 30px;\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n  }\n  .panel-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding-bottom: 12px;\n    border-bottom: 1px solid rgba(0,212,255,0.12);\n  }\n  .panel-title {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 12px;\n    color: #8ba3bd;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n  .live {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 12px;\n    color: #22C55E;\n  }\n  .live-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #22C55E;\n    box-shadow: 0 0 8px #22C55E;\n  }\n  .stat-hero {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    background: linear-gradient(90deg, rgba(0,212,255,0.12) 0%, rgba(0,212,255,0.02) 100%);\n    border-left: 3px solid #00D4FF;\n    padding: 14px 18px;\n    border-radius: 10px;\n  }\n  .stat-number {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 64px;\n    line-height: 1;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    letter-spacing: -0.03em;\n  }\n  .stat-label {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n  .stat-label .big {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    color: #fff;\n    font-size: 20px;\n  }\n  .stat-label .sm {\n    font-size: 13px;\n    color: #8ba3bd;\n    font-family: 'JetBrains Mono', monospace;\n  }\n  .rows {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .row {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    padding: 11px 14px;\n    border-radius: 10px;\n    background: rgba(255,255,255,0.02);\n    border: 1px solid rgba(255,255,255,0.04);\n  }\n  .row.alt {\n    background: rgba(0,212,255,0.04);\n    border-color: rgba(0,212,255,0.12);\n  }\n  .row-icon {\n    width: 38px;\n    height: 38px;\n    border-radius: 8px;\n    background: rgba(0,212,255,0.1);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .row-icon img { width: 22px; height: 22px; object-fit: contain; }\n  .row-body {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 1px;\n  }\n  .row-title {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 15px;\n    color: #fff;\n  }\n  .row-desc {\n    font-size: 12px;\n    color: #8ba3bd;\n    font-family: 'DM Sans', sans-serif;\n  }\n  .row-stat {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 500;\n    font-size: 14px;\n    color: #00D4FF;\n    background: rgba(0,212,255,0.08);\n    padding: 5px 10px;\n    border-radius: 6px;\n    flex-shrink: 0;\n  }\n  .row-stat.green { color: #22C55E; background: rgba(34,197,94,0.1); }\n  .row-stat.amber { color: #F59E0B; background: rgba(245,158,11,0.1); }\n  .footer-strip {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding-top: 8px;\n    border-top: 1px solid rgba(0,212,255,0.12);\n    margin-top: 2px;\n  }\n  .footer-strip .tag {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 11px;\n    color: #8ba3bd;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n  .counter {\n    display: flex;\n    align-items: baseline;\n    gap: 6px;\n  }\n  .counter-num {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 28px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n  .counter-label {\n    font-size: 11px;\n    color: #8ba3bd;\n    font-family: 'JetBrains Mono', monospace;\n  }\n  #export {\n    margin-top: 20px;\n    padding: 12px 24px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    color: #0B1929;\n    border: none;\n    border-radius: 8px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 14px;\n    cursor: pointer;\n    letter-spacing: 0.02em;\n  }\n</style>\n</head>\n<body>\n\n<div id=\"post\">\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\">\n    <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n      <g fill=\"currentColor\">\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\"/>\n        <rect x=\"4\" y=\"48\" width=\"92\" height=\"4\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(30 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(60 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(15 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(45 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(75 50 50)\"/>\n      </g>\n    </symbol>\n  </svg>\n\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <div class=\"watermark\" style=\"color:#00D4FF\">\n    <svg width=\"380\" height=\"380\"><use href=\"#claude-star\"/></svg>\n  </div>\n\n  <div class=\"left\">\n    <div>\n      <div class=\"badge\">\n        <svg viewBox=\"0 0 100 100\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n        AI Automation\n      </div>\n      <h1>Your inbox isn't a <em>to-do list</em>.</h1>\n      <p class=\"subtitle\">It's a tax on your attention. I asked Claude to audit mine — it found 6 hours a week.</p>\n      <div class=\"cta\">👀 Sound familiar?</div>\n    </div>\n    <div class=\"logo\">\n      <div class=\"logo-dot\"></div>\n      <span class=\"logo-text\">Accelod AI</span>\n    </div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-header\">\n        <div class=\"panel-title\">// inbox_audit.log</div>\n        <div class=\"live\"><span class=\"live-dot\"></span> LIVE</div>\n      </div>\n\n      <div class=\"stat-hero\">\n        <div class=\"stat-number\">6.2h</div>\n        <div class=\"stat-label\">\n          <div class=\"big\">Reclaimed every week</div>\n          <div class=\"sm\">across 847 emails processed</div>\n        </div>\n      </div>\n\n      <div class=\"rows\">\n        <div class=\"row alt\">\n          <div class=\"row-icon\"><img src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\"></div>\n          <div class=\"row-body\">\n            <div class=\"row-title\">Claude categorises inbox</div>\n            <div class=\"row-desc\">Priority · FYI · Newsletter · Trash — auto-labelled</div>\n          </div>\n          <div class=\"row-stat\">847 sorted</div>\n        </div>\n\n        <div class=\"row\">\n          <div class=\"row-icon\"><img src=\"https://cdn.simpleicons.org/google\" alt=\"Google\"></div>\n          <div class=\"row-body\">\n            <div class=\"row-title\">Google Workspace drafts replies</div>\n            <div class=\"row-desc\">Context-aware responses saved to Drafts folder</div>\n          </div>\n          <div class=\"row-stat green\">312 drafted</div>\n        </div>\n\n        <div class=\"row alt\">\n          <div class=\"row-icon\">🚩</div>\n          <div class=\"row-body\">\n            <div class=\"row-title\">Priority flags surface fast</div>\n            <div class=\"row-desc\">Clients, contracts, and revenue land on top</div>\n          </div>\n          <div class=\"row-stat amber\">18 urgent</div>\n        </div>\n\n        <div class=\"row\">\n          <div class=\"row-icon\">🗑️</div>\n          <div class=\"row-body\">\n            <div class=\"row-title\">Noise auto-archived</div>\n            <div class=\"row-desc\">Newsletters and receipts filed without a click</div>\n          </div>\n          <div class=\"row-stat\">−94% noise</div>\n        </div>\n      </div>\n\n      <div class=\"footer-strip\">\n        <div class=\"tag\">// time_saved_counter</div>\n        <div class=\"counter\">\n          <span class=\"counter-num\">+6h 12m</span>\n          <span class=\"counter-label\">this week</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1200, height: 630, quality: 1, scale: 2 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-inbox-audit.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>"
}