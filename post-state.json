;\n    height:100%;\n  }\n  .badge {\n    display:inline-flex;\n    align-items:center;\n    gap:12px;\n    padding:14px 26px;\n    border:2px solid rgba(0,212,255,0.6);\n    border-radius:100px;\n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-weight:500;\n    font-size:24px;\n    align-self:flex-start;\n    background:rgba(0,212,255,0.08);\n  }\n  .badge svg { width:22px; height:22px; }\n  .headline {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:104px;\n    line-height:0.95;\n    color:#fff;\n    margin-top:26px;\n    letter-spacing:-2.5px;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-family:'DM Sans',sans-serif;\n    font-weight:400;\n    font-size:30px;\n    color:rgba(255,255,255,0.8);\n    margin-top:22px;\n    line-height:1.35;\n    max-width:960px;\n  }\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.25);\n    border-radius:18px;\n    padding:32px 34px;\n    margin-top:28px;\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    gap:16px;\n  }\n  .tool-row {\n    display:flex;\n    align-items:center;\n    gap:22px;\n    padding:18px 22px;\n    background:rgba(0,212,255,0.05);\n    border-radius:14px;\n    border-left:4px solid #00D4FF;\n  }\n  .tool-icon {\n    width:64px;\n    height:64px;\n    border-radius:14px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    flex-shrink:0;\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:32px;\n    color:#fff;\n  }\n  .icon-claude { background:linear-gradient(135deg,#D97757,#C15F3C); }\n  .icon-n8n { background:linear-gradient(135deg,#EA4B71,#B93254); }\n  .icon-ghl { background:linear-gradient(135deg,#3B82F6,#1E40AF); }\n  .icon-google {\n    background:#fff;\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    grid-template-rows:1fr 1fr;\n    padding:14px;\n    gap:4px;\n  }\n  .icon-google span {\n    display:block;\n    border-radius:2px;\n  }\n  .icon-google span:nth-child(1){background:#4285F4;}\n  .icon-google span:nth-child(2){background:#EA4335;}\n  .icon-google span:nth-child(3){background:#FBBC05;}\n  .icon-google span:nth-child(4){background:#34A853;}\n  .tool-body {\n    display:flex;\n    flex-direction:column;\n    gap:4px;\n    flex:1;\n  }\n  .tool-name {\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:34px;\n    color:#fff;\n    line-height:1.1;\n  }\n  .role {\n    font-family:'DM Sans',sans-serif;\n    font-size:24px;\n    color:rgba(255,255,255,0.85);\n    font-weight:500;\n    line-height:1.3;\n  }\n  .role strong {\n    color:#33E1FF;\n    font-weight:600;\n  }\n  .arrow {\n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-size:28px;\n    font-weight:500;\n  }\n  .divider {\n    height:1px;\n    background:linear-gradient(90deg, transparent, rgba(0,212,255,0.4), transparent);\n    margin:6px 0;\n  }\n  .stat-line {\n    font-family:'JetBrains Mono',monospace;\n    font-size:22px;\n    color:rgba(255,255,255,0.7);\n    text-align:center;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:12px;\n  }\n  .stat-line svg { width:20px; height:20px; color:#00D4FF; }\n  .stat-line span {\n    color:#00D4FF;\n    font-weight:500;\n  }\n  .footer {\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    margin-top:28px;\n    gap:20px;\n  }\n  .cta-pill {\n    display:inline-flex;\n    align-items:center;\n    gap:14px;\n    padding:22px 34px;\n    background:rgba(0,212,255,0.12)…\n    border:2px solid rgba(0,212,255,0.55);\n    border-radius:100px;\n    color:#fff;\n    font-family:'DM Sans',sans-serif;\n    font-weight:600;\n    font-size:28px;\n  }\n  .cta-pill {\n    background:rgba(0,212,255,0.12);\n  }\n  .cta-pill::before {\n    content:'';\n    width:12px;\n    height:12px;\n    background:#00D4FF;\n    border-radius:50%;\n    box-shadow:0 0 14px #00D4FF;\n  }\n  .logo-wrap {\n    display:flex;\n    align-items:center;\n    gap:10px;\n  }\n  .logo-wrap svg { width:38px; height:38px; color:#00D4FF; }\n  .logo {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:40px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    letter-spacing:-0.5px;\n  }\n  #export-btn {\n    padding:14px 28px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    color:#0B1929;\n    border:none;\n    border-radius:8px;\n    font-family:'DM Sans',sans-serif;\n    font-weight:500;\n    font-size:15px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\"/>\n      <path d=\"M24,-41.6 L6.9,-4.6 L2.6,-7.4 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L2.5,-8 L-2.5,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n  <symbol id=\"ic-bolt\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M13 2L3 14h7l-1 8 10-12h-7l1-8z\"/></symbol>\n  <symbol id=\"ic-spark\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 2l1.5 6.5L20 10l-6.5 1.5L12 18l-1.5-6.5L4 10l6.5-1.5z\"/></symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <div class=\"glow-2\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"content\">\n    <div class=\"badge\">\n      <svg><use href=\"#claude-star\"/></svg>\n      AI AUTOMATION\n      <svg><use href=\"#ic-bolt\"/></svg>\n    </div>\n\n    <h1 class=\"headline\">Most owners use 27 tools.<br>I use <em>4</em>.</h1>\n\n    <p class=\"subtitle\">Here's the exact stack running 90% of my daily operations — and why mine outperform yours.</p>\n\n    <div class=\"panel\">\n      <div class=\"tool-row\">\n        <div class=\"tool-icon icon-claude\">C</div>\n        <div class=\"tool-body\">\n          <div class=\"tool-name\">Claude AI</div>\n          <div class=\"role\">The <strong>brain</strong> — thinking, writing, deciding</div>\n        </div>\n        <div class=\"arrow\">→</div>\n      </div>\n      <div class=\"tool-row\">\n        <div class=\"tool-icon icon-n8n\">n8n</div>\n        <div class=\"tool-body\">\n          <div class=\"tool-name\">N8N</div>\n          <div class=\"role\">The <strong>nervous system</strong> — signals between tools</div>\n        </div>\n        <div class=\"arrow\">→</div>\n      </div>\n      <div class=\"tool-row\">\n        <div class=\"tool-icon icon-ghl\">HL</div>\n        <div class=\"tool-body\">\n          <div class=\"tool-name\">GoHighLevel</div>\n          <div class=\"role\">The <strong>mouth</strong> — client comms &amp; CRM</div>\n        </div>\n        <div class=\"arrow\">→</div>\n      </div>\n      <div class=\"tool-row\">\n        <div class=\"tool-icon icon-google\"><span></span><span></span><span></span><span></span></div>\n        <div class=\"tool-body\">\n          <div class=\"tool-name\">Google Workspace</div>\n          <div class=\"role\">The <strong>memory</strong> — docs, data, storage</div>\n        </div>\n        <div class=\"arrow\">→</div>\n      </div>\n\n      <div class=\"divider\"></div>\n      <div class=\"stat-line\">\n        <svg><use href=\"#ic-spark\"/></svg>\n        Audit your stack. <span>How many do you actually need?</span>\n        <svg><use href=\"#ic-spark\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"footer\">\n      <div class=\"cta-pill\">How many are you running?</div>\n      <div class=\"logo-wrap\">\n        <svg><use href=\"#claude-star\"/></svg>\n        <div class=\"logo\">Accelod</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<button id=\"export-btn\" onclick=\"exportPNG()\">Export PNG</button>\n\n<script>\n  function exportPNG() {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1080, height:1350, quality:1, bgcolor:'#0B1929' })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-4tool-stack.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  }\n</script>\n</body>\n</html>",
