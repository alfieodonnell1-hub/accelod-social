  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI — Case Study</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    background:#020814;\n    font-family:'DM Sans',sans-serif;\n    min-height:100vh;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    padding:40px 20px;\n    gap:24px;\n  }\n  #post {\n    width:1080px;\n    height:1350px;\n    background:#0B1929;\n    position:relative;\n    overflow:hidden;\n    color:#fff;\n    padding:60px 60px;\n    display:flex;\n    flex-direction:column;\n  }\n  .dot-grid {\n    position:absolute; inset:0;\n    background-image: radial-gradient(rgba(0,212,255,0.12) 1.2px, transparent 1.2px);\n    background-size: 26px 26px;\n    opacity:0.5;\n    pointer-events:none;\n  }\n  .glow-tl {\n    position:absolute;\n    top:-200px; left:-200px;\n    width:700px; height:700px;\n    background: radial-gradient(circle, rgba(0,212,255,0.22), transparent 70%);\n    pointer-events:none;\n  }\n  .glow-br {\n    position:absolute;\n    bottom:-250px; right:-250px;\n    width:750px; height:750px;\n    background: radial-gradient(circle, rgba(255,140,50,0.18), transparent 70%);\n    pointer-events:none;\n  }\n  .watermark {\n    position:absolute;\n    top:30px; right:-80px;\n    width:380px; height:380px;\n    opacity:0.05;\n    transform:rotate(12deg);\n    pointer-events:none;\n  }\n  .badge {\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    border:1px solid rgba(0,212,255,0.5);\n    background:rgba(0,212,255,0.06);\n    color:#00D4FF;\n    padding:9px 18px;\n    border-radius:999px;\n    font-family:'JetBrains Mono',monospace;\n    font-size:16px;\n    font-weight:500;\n    letter-spacing:0.02em;\n    width:fit-content;\n    position:relative;\n    z-index:2;\n  }\n  .badge svg { width:16px; height:16px; }\n  .hero {\n    display:grid;\n    grid-template-columns: 1.4fr 1fr;\n    gap:24px;\n    margin-top:20px;\n    align-items:center;\n    position:relative;\n    z-index:2;\n  }\n  .headline {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:74px;\n    line-height:0.95;\n    letter-spacing:-0.03em;\n    color:#fff;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(90deg,#FF8C32,#FFB366);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .headline s {\n    text-decoration: line-through;\n    text-decoration-color: #EF4444;\n    text-decoration-thickness: 4px;\n    color:#8896A6;\n  }\n  /* Woman graphic */\n  .woman-scene {\n    position:relative;\n    height:340px;\n    background:linear-gradient(135deg, rgba(255,140,50,0.08), rgba(0,212,255,0.08));\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:20px;\n    overflow:hidden;\n    display:flex;\n    align-items:flex-end;\n    justify-content:center;\n  }\n  .woman-scene::before {\n    content:'';\n    position:absolute;\n    inset:0;\n    background-image:\n      linear-gradient(rgba(0,212,255,0.08) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size:20px 20px;\n  }\n  .woman-svg {\n    position:relative;\n    z-index:2;\n    height:300px;\n    width:auto;\n  }\n  .float-icon {\n    position:absolute;\n    background:#0B1929;\n    border:1.5px solid rgba(0,212,255,0.4);\n    width:52px; height:52px;\n    border-radius:50%;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    z-index:3;\n    box-shadow:0 4px 20px rgba(0,212,255,0.25);\n  }\n  .float-icon.orange {\n    border-color:rgba(255,140,50,0.6);\n    box-shadow:0 4px 20px rgba(255,140,50,0.35);\n  }\n  .float-icon svg { width:26px; height:26px; }\n  .fi1 { top:20px; left:16px; }\n  .fi2 { top:14px; right:20px; }\n  .fi3 { bottom:80px; right:8px; }\n\n  .subtitle {\n    font-family:'DM Sans',sans-serif;\n    font-weight:400;\n    font-size:22px;\n    line-height:1.4;\n    color:#B8C5D6;\n    margin-top:18px;\n    max-width:980px;\n    position:relative;\n    z-index:2;\n  }\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:26px;\n    margin-top:20px;\n    position:relative;\n    z-index:2;\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    gap:14px;\n  }\n  .compare {\n    display:grid;\n    grid-template-columns: 1fr 1fr;\n    gap:14px;\n  }\n  .compare-box {\n    padding:18px;\n    border-radius:12px;\n    display:flex;\n    flex-direction:column;\n    gap:8px;\n    position:relative;\n    overflow:hidden;\n  }\n  .before {\n    background:rgba(239,68,68,0.08);\n    border:1px solid rgba(239,68,68,0.3);\n  }\n  .after {\n    background:rgba(0,212,255,0.08);\n    border:1px solid rgba(0,212,255,0.35);\n  }\n  .compare-label {\n    font-family:'JetBrains Mono',monospace;\n    font-size:16px;\n    letter-spacing:0.08em;\n    text-transform:uppercase;\n  }\n  .before .compare-label { color:#EF4444; }\n  .after .compare-label { color:#00D4FF; }\n  .compare-stat {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:54px;\n    line-height:1;\n    color:#fff;\n    letter-spacing:-0.02em;\n  }\n  .after .compare-stat {\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .compare-desc {\n    font-family:'DM Sans',sans-serif;\n    font-size:19px;\n    color:#B8C5D6;\n    line-height:1.35;\n  }\n  .savings-strip {\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    background:linear-gradient(90deg, rgba(0,212,255,0.15), rgba(255,140,50,0.12));\n    border-left:4px solid #00D4FF;\n    border-right:4px solid #FF8C32;\n    border-radius:10px;\n    padding:16px 22px;\n  }\n  .savings-label {\n    font-family:'JetBrains Mono',monospace;\n    font-size:18px;\n    color:#B8C5D6;\n    text-transform:uppercase;\n    letter-spacing:0.05em;\n  }\n  .savings-num {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:50px;\n    background:linear-gradient(90deg,#00D4FF,#FFB366);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n    letter-spacing:-0.02em;\n  }\n  .stack-title {\n    font-family:'JetBrains Mono',monospace;\n    font-size:16px;\n    color:#00D4FF;\n    letter-spacing:0.12em;\n    text-transform:uppercase;\n    margin-top:2px;\n  }\n  .stack-row {\n    display:flex;\n    align-items:center;\n    gap:16px;\n    padding:14px 18px;\n    background:rgba(255,255,255,0.02);\n    border:1px solid rgba(255,255,255,0.06);\n    border-radius:12px;\n  }\n  .stack-row.orange {\n    background:linear-gradient(90deg, rgba(255,140,50,0.08), rgba(255,140,50,0.02));\n    border:1px solid rgba(255,140,50,0.35);\n  }\n  .stack-row .step {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:28px;\n    color:#00D4FF;\n    min-width:36px;\n  }\n  .stack-row.orange .step { color:#FF8C32; }\n  .tool-icon {\n    width:44px; height:44px;\n    border-radius:10px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    flex-shrink:0;\n  }\n  .tool-icon svg { width:28px; height:28px; }\n  .stack-row .tool-name {\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:22px;\n    color:#fff;\n    min-width:160px;\n  }\n  .stack-row.orange .tool-name {\n    background:linear-gradient(90deg,#FF8C32,#FFB366);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .stack-row .tool-job {\n    font-family:'DM Sans',sans-serif;\n    font-size:19px;\n    color:#B8C5D6;\n    flex:1;\n  }\n  .footer {\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    margin-top:20px;\n    position:relative;\n    z-index:2;\n  }\n  .cta {\n    display:inline-flex;\n    align-items:center;\n    gap:12px;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    color:#0B1929;\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:22px;\n    padding:16px 30px;\n    border-radius:999px;\n    letter-spacing:-0.01em;\n  }\n  .logo {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:32px;\n    letter-spacing:-0.02em;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  #export {\n    padding:14px 28px;\n    background:#00D4FF;\n    color:#0B1929;\n    border:none;\n    border-radius:8px;\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:16px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow-tl\"></div>\n  <div class=\"glow-br\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge\">\n    <svg><use href=\"#claude-star\"/></svg>\n    AI AUTOMATION / CASE STUDY\n  </div>\n\n  <div class=\"hero\">\n    <h1 class=\"headline\">He didn't fire her<br>because she was<br><s>bad</s>. He built a<br><em>workflow</em> instead.</h1>\n\n    <div class=\"woman-scene\">\n      <!-- Floating tool badges around woman -->\n      <div class=\"float-icon fi1\" title=\"GHL\">\n        <svg viewBox=\"0 0 100 100\"><circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"#112240\"/><text x=\"50\" y=\"62\" font-family=\"Outfit\" font-weight=\"900\" font-size=\"42\" fill=\"#3B82F6\" text-anchor=\"middle\">G</text></svg>\n      </div>\n      <div class=\"float-icon orange fi2\" title=\"Claude Code\">\n        <svg viewBox=\"0 0 100 100\" style=\"color:#FF8C32\"><use href=\"#claude-star\"/></svg>\n      </div>\n      <div class=\"float-icon fi3\" title=\"n8n\">\n        <svg viewBox=\"0 0 100 100\"><circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"#EA4B71\"/><circle cx=\"30\" cy=\"40\" r=\"8\" fill=\"#fff\"/><circle cx=\"70\" cy=\"40\" r=\"8\" fill=\"#fff\"/><circle cx=\"50\" cy=\"65\" r=\"8\" fill=\"#fff\"/><path d=\"M30 40 L50 65 L70 40\" stroke=\"#fff\" stroke-width=\"3\" fill=\"none\"/></svg>\n      </div>\n\n      <!-- Woman illustration -->\n      <svg class=\"woman-svg\" viewBox=\"0 0 200 300\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Hair back -->\n        <path d=\"M60 70 Q55 40 100 32 Q150 38 145 78 L148 120 L140 118 L138 88 Q135 70 100 68 Q68 72 62 92 L60 118 L52 120 Z\" fill=\"#2A1810\"/>\n        <!-- Neck -->\n        <rect x=\"90\" y=\"98\" width=\"20\" height=\"20\" fill=\"#F4C7A1\"/>\n        <!-- Face -->\n        <ellipse cx=\"100\" cy=\"78\" rx=\"30\" ry=\"34\" fill=\"#F4C7A1\"/>\n        <!-- Hair front -->\n        <path d=\"M70 68 Q72 48 100 44 Q130 46 132 70 Q128 58 118 56 Q110 62 100 60 Q88 62 82 58 Q74 60 70 68 Z\" fill=\"#2A1810\"/>\n        <!-- Eyes -->\n        <ellipse cx=\"90\" cy=\"80\" rx=\"2.5\" ry=\"3\" fill=\"#0B1929\"/>\n        <ellipse cx=\"110\" cy=\"80\" rx=\"2.5\" ry=\"3\" fill=\"#0B1929\"/>\n        <!-- Eyebrows -->\n        <path d=\"M85 74 L94 73\" stroke=\"#2A1810\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n        <path d=\"M106 73 L115 74\" stroke=\"#2A1810\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n        <!-- Nose -->\n        <path d=\"M100 84 L98 92 L102 92\" stroke=\"#D4A585\" stroke-width=\"1.2\" fill=\"none\" stroke-linecap=\"round\"/>\n        <!-- Smile -->\n        <path d=\"M92 98 Q100 102 108 98\" stroke=\"#B8593C\" stroke-width=\"1.5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <!-- Earrings -->\n        <circle cx=\"70\" cy=\"86\" r=\"2\" fill=\"#FF8C32\"/>\n        <circle cx=\"130\" cy=\"86\" r=\"2\" fill=\"#FF8C32\"/>\n\n        <!-- Body / blazer -->\n        <path d=\"M50 130 Q55 118 90 116 L110 116 Q145 118 150 130 L155 220 Q155 240 145 245 L55 245 Q45 240 45 220 Z\" fill=\"#00D4FF\"/>\n        <!-- Blazer lapels -->\n        <path d=\"M90 116 L100 155 L85 175 L75 130 Z\" fill=\"#0B1929\"/>\n        <path d=\"M110 116 L100 155 L115 175 L125 130 Z\" fill=\"#0B1929\"/>\n        <!-- Shirt -->\n        <path d=\"M90 116 L100 155 L110 116 Z\" fill=\"#fff\"/>\n        <!-- Arms -->\n        <path d=\"M50 132 Q40 160 45 200 L58 205 Q60 175 62 138 Z\" fill=\"#00D4FF\"/>\n        <path d=\"M150 132 Q160 160 155 200 L142 205 Q140 175 138 138 Z\" fill=\"#00D4FF\"/>\n        <!-- Hand holding laptop -->\n        <ellipse cx=\"52\" cy=\"210\" rx=\"10\" ry=\"8\" fill=\"#F4C7A1\"/>\n        <ellipse cx=\"148\" cy=\"210\" rx=\"10\" ry=\"8\" fill=\"#F4C7A1\"/>\n\n        <!-- Laptop -->\n        <rect x=\"55\" y=\"205\" width=\"90\" height=\"55\" rx=\"4\" fill=\"#0B1929\" stroke=\"#FF8C32\" stroke-width=\"2\"/>\n        <rect x=\"60\" y=\"210\" width=\"80\" height=\"45\" rx=\"2\" fill=\"#020814\"/>\n        <!-- Screen code lines -->\n        <rect x=\"65\" y=\"216\" width=\"30\" height=\"3\" rx=\"1\" fill=\"#FF8C32\"/>\n        <rect x=\"65\" y=\"223\" width=\"45\" height=\"3\" rx=\"1\" fill=\"#00D4FF\"/>\n        <rect x=\"70\" y=\"230\" width=\"35\" height=\"3\" rx=\"1\" fill=\"#B8C5D6\"/>\n        <rect x=\"70\" y=\"237\" width=\"50\" height=\"3\" rx=\"1\" fill=\"#00D4FF\"/>\n        <rect x=\"65\" y=\"244\" width=\"25\" height=\"3\" rx=\"1\" fill=\"#FF8C32\"/>\n        <!-- Laptop base -->\n        <rect x=\"50\" y=\"258\" width=\"100\" height=\"6\" rx=\"2\" fill=\"#1a2b3d\"/>\n\n        <!-- Sparkle around -->\n        <g fill=\"#FF8C32\" opacity=\"0.9\">\n          <circle cx=\"30\" cy=\"140\" r=\"2\"/>\n          <circle cx=\"170\" cy=\"160\" r=\"2\"/>\n          <circle cx=\"25\" cy=\"180\" r=\"1.5\"/>\n        </g>\n        <g fill=\"#00D4FF\" opacity=\"0.9\">\n          <circle cx=\"175\" cy=\"130\" r=\"1.5\"/>\n          <circle cx=\"20\" cy=\"110\" r=\"2\"/>\n        </g>\n      </svg>\n    </div>\n  </div>\n\n  <p class=\"subtitle\">A real electrician replaced a $45k/yr office manager with three tools talking to each other. Here's the receipt.</p>\n\n  <div class=\"panel\">\n\n    <div class=\"compare\">\n      <div class=\"compare-box before\">\n        <div class=\"compare-label\">◼ Before</div>\n        <div class=\"compare-stat\">1 · 3 · ∞</div>\n        <div class=\"compare-desc\">1 office manager<br>3 spreadsheets<br>Missed jobs weekly</div>\n      </div>\n      <div class=\"compare-box after\">\n        <div class=\"compare-label\">◆ After</div>\n        <div class=\"compare-stat\">1 · 0 · 0</div>\n        <div class=\"compare-desc\">1 workflow<br>0 dropped leads<br>Sleeps in Sundays</div>\n      </div>\n    </div>\n\n    <div class=\"savings-strip\">\n      <div class=\"savings-label\">Annual cost saved</div>\n      <div class=\"savings-num\">$45,000</div>\n    </div>\n\n    <div class=\"stack-title\">— The 3-tool stack that replaced her</div>\n\n    <div class=\"stack-row\">\n      <div class=\"step\">01</div>\n      <div class=\"tool-icon\" style=\"background:#112240\">\n        <svg viewBox=\"0 0 100 100\"><text x=\"50\" y=\"70\" font-family=\"Outfit\" font-weight=\"900\" font-size=\"60\" fill=\"#3B82F6\" text-anchor=\"middle\">G</text></svg>\n      </div>\n      <div class=\"tool-name\">GoHighLevel</div>\n      <div class=\"tool-job\">Captures every lead. Never sleeps.</div>\n    </div>\n\n    <div class=\"stack-row orange\">\n      <div class=\"step\">02</div>\n      <div class=\"tool-icon\" style=\"background:rgba(255,140,50,0.15); border:1px solid rgba(255,140,50,0.4)\">\n        <svg viewBox=\"0 0 100 100\" style=\"color:#FF8C32\"><use href=\"#claude-star\"/></svg>\n      </div>\n      <div class=\"tool-name\">Claude Code</div>\n      <div class=\"tool-job\">Writes quotes in the boss's voice.</div>\n    </div>\n\n    <div class=\"stack-row\">\n      <div class=\"step\">03</div>\n      <div class=\"tool-icon\" style=\"background:rgba(234,75,113,0.15)\">\n        <svg viewBox=\"0 0 100 100\"><circle cx=\"30\" cy=\"35\" r=\"10\" fill=\"#EA4B71\"/><circle cx=\"70\" cy=\"35\" r=\"10\" fill=\"#EA4B71\"/><circle cx=\"50\" cy=\"70\" r=\"10\" fill=\"#EA4B71\"/><path d=\"M30 35 L50 70 L70 35\" stroke=\"#EA4B71\" stroke-width=\"3\" fill=\"none\"/></svg>\n      </div>\n      <div class=\"tool-name\">n8n</div>\n      <div class=\"tool-job\">Schedules jobs. Sends the van.</div>\n    </div>\n\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta\">Sound familiar? →</div>\n    <div class=\"logo\">✦ Accelod AI</div>\n  </div>\n</div>\n\n<button id=\"export\">⬇ Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1080, height:1350, quality:1, bgcolor:'#0B1929' })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-electrician-case-study.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>",
  "fb_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI - Electrician Case Study</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    background: #1a1a1a;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 20px;\n    font-family: 'DM Sans', sans-serif;\n  }\n  #post {\n    width: 1200px;\n    height: 630px;\n    background: #0B1929;\n    position: relative;\n    overflow: hidden;\n    display: flex;\n    color: white;\n  }\n  .dot-grid {\n    position: absolute;\n    inset: 0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 24px 24px;\n    pointer-events: none;\n  }\n  .glow {\n    position: absolute;\n    top: -200px;\n    left: -200px;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(0,212,255,0.15) 0%, transparent 70%);\n    pointer-events: none;\n  }\n  .glow-orange {\n    position: absolute;\n    bottom: -180px;\n    right: 380px;\n    width: 500px;\n    height: 500px;\n    background: radial-gradient(circle, rgba(255,138,44,0.18) 0%, transparent 70%);\n    pointer-events: none;\n  }\n  .circuit-lines {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: 0.3;\n  }\n  .watermark {\n    position: absolute;\n    top: -80px;\n    right: -80px;\n    width: 400px;\n    height: 400px;\n    opacity: 0.05;\n    transform: rotate(12deg);\n    pointer-events: none;\n  }\n  .left {\n    width: 460px;\n    padding: 40px 24px 40px 44px;\n    display: flex;\n    flex-direction: column;\n    position: relative;\n    z-index: 2;\n  }\n  .badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    border: 1px solid #00D4FF;\n    border-radius: 999px;\n    padding: 8px 16px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 16px;\n    color: #00D4FF;\n    width: fit-content;\n    margin-bottom: 18px;\n    background: rgba(0,212,255,0.05);\n  }\n  .badge svg { width: 16px; height: 16px; }\n  .badge .pulse {\n    width: 8px;\n    height: 8px;\n    background: #00D4FF;\n    border-radius: 50%;\n    box-shadow: 0 0 8px #00D4FF;\n  }\n  .hero-visual {\n    position: relative;\n    display: flex;\n    align-items: flex-end;\n    gap: 14px;\n    margin-bottom: 18px;\n  }\n  .woman-graphic {\n    width: 110px;\n    height: 140px;\n    flex-shrink: 0;\n    position: relative;\n  }\n  .thought-bubble {\n    flex: 1;\n    background: rgba(255,255,255,0.06);\n    border: 1px solid rgba(255,138,44,0.4);\n    border-radius: 14px 14px 14px 4px;\n    padding: 10px 14px;\n    position: relative;\n    margin-bottom: 12px;\n  }\n  .thought-bubble::before {\n    content: '';\n    position: absolute;\n    left: -8px;\n    bottom: 6px;\n    width: 14px;\n    height: 14px;\n    background: rgba(255,255,255,0.06);\n    border-left: 1px solid rgba(255,138,44,0.4);\n    border-bottom: 1px solid rgba(255,138,44,0.4);\n    transform: rotate(45deg);\n  }\n  .thought-text {\n    font-size: 15px;\n    color: #FF8A2C;\n    font-family: 'JetBrains Mono', monospace;\n    line-height: 1.3;\n  }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 46px;\n    line-height: 1.0;\n    letter-spacing: -0.03em;\n    color: white;\n    margin-bottom: 14px;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #FF8A2C, #FFB366);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .subtitle {\n    font-size: 18px;\n    line-height: 1.35;\n    color: #a0b4c5;\n    margin-bottom: auto;\n  }\n  .cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: rgba(0,212,255,0.1);\n    border: 1px solid rgba(0,212,255,0.4);\n    border-radius: 999px;\n    padding: 10px 20px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 16px;\n    color: #00D4FF;\n    width: fit-content;\n    margin-top: 16px;\n    margin-bottom: 16px;\n  }\n  .logo {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 24px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -0.02em;\n  }\n  .right {\n    flex: 1;\n    padding: 36px 44px 36px 0;\n    position: relative;\n    z-index: 2;\n  }\n  .panel {\n    background: linear-gradient(180deg, #06101A 0%, #0A1524 100%);\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 22px;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    position: relative;\n    overflow: hidden;\n  }\n  .panel::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 3px;\n    background: linear-gradient(90deg, #00D4FF 0%, #FF8A2C 100%);\n  }\n  .panel-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-bottom: 8px;\n    border-bottom: 1px solid rgba(0,212,255,0.15);\n  }\n  .panel-title {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 16px;\n    color: #00D4FF;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .panel-title svg { width: 20px; height: 20px; }\n  .panel-tag {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 14px;\n    color: #a0b4c5;\n    background: rgba(255,255,255,0.05);\n    padding: 4px 10px;\n    border-radius: 6px;\n  }\n  .compare {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 12px;\n  }\n  .col {\n    border-radius: 12px;\n    padding: 14px;\n    position: relative;\n  }\n  .before {\n    background: rgba(239,68,68,0.08);\n    border: 1px solid rgba(239,68,68,0.25);\n  }\n  .after {\n    background: rgba(0,212,255,0.08);\n    border: 1px solid rgba(0,212,255,0.3);\n  }\n  .col-label {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 15px;\n    margin-bottom: 6px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .before .col-label { color: #ef4444; }\n  .after .col-label { color: #00D4FF; }\n  .col-line {\n    font-size: 17px;\n    color: white;\n    line-height: 1.3;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-top: 4px;\n  }\n  .col-line::before {\n    content: '';\n    width: 4px;\n    height: 4px;\n    border-radius: 50%;\n    background: currentColor;\n    opacity: 0.5;\n  }\n  .before .col-line::before { color: #ef4444; }\n  .after .col-line::before { color: #00D4FF; }\n  .stack {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .row {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 10px 12px;\n    border-radius: 10px;\n    background: rgba(255,255,255,0.03);\n    border-left: 3px solid #00D4FF;\n  }\n  .row.orange {\n    border-left-color: #FF8A2C;\n    background: linear-gradient(90deg, rgba(255,138,44,0.08), rgba(255,255,255,0.03));\n  }\n  .tool-icon {\n    width: 36px;\n    height: 36px;\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    background: rgba(255,255,255,0.05);\n  }\n  .tool-icon svg { width: 26px; height: 26px; }\n  .row-text {\n    font-size: 17px;\n    color: white;\n    flex: 1;\n  }\n  .row-text b { color: #33E1FF; font-weight: 700; }\n  .row.orange .row-text b { color: #FF8A2C; font-weight: 700; }\n  .row-tag {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    color: #a0b4c5;\n    background: rgba(255,255,255,0.05);\n    padding: 3px 8px;\n    border-radius: 6px;\n  }\n  .row.orange .row-tag {\n    color: #FF8A2C;\n    background: rgba(255,138,44,0.1);\n  }\n  .savings {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    padding: 12px 16px;\n    background: linear-gradient(90deg, rgba(0,212,255,0.15), rgba(255,138,44,0.1));\n    border-radius: 10px;\n    margin-top: auto;\n    border: 1px solid rgba(0,212,255,0.2);\n  }\n  .savings-num {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 52px;\n    letter-spacing: -0.03em;\n    background: linear-gradient(135deg, #00D4FF, #FF8A2C);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    line-height: 1;\n  }\n  .savings-label {\n    font-size: 18px;\n    color: white;\n    line-height: 1.2;\n    flex: 1;\n  }\n  .savings-label span {\n    display: block;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 14px;\n    color: #a0b4c5;\n    margin-top: 2px;\n  }\n  .savings-icon {\n    font-size: 40px;\n  }\n  #exportBtn {\n    margin-top: 20px;\n    padding: 12px 24px;\n    background: #00D4FF;\n    color: #0B1929;\n    border: none;\n    border-radius: 8px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    cursor: pointer;\n  }\n</style>\n</head>\n<body>\n<div id=\"post\">\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\">\n    <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n      <g fill=\"currentColor\">\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\"/>\n        <rect x=\"4\" y=\"48\" width=\"92\" height=\"4\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(30 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(60 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(120 50 50)\"/>\n        <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" transform=\"rotate(150 50 50)\"/>\n      </g>\n    </symbol>\n  </svg>\n\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <div class=\"glow-orange\"></div>\n\n  <svg class=\"circuit-lines\" viewBox=\"0 0 1200 630\" preserveAspectRatio=\"none\">\n    <path d=\"M0,100 L200,100 L220,80 L400,80\" stroke=\"#00D4FF\" stroke-width=\"1\" fill=\"none\" opacity=\"0.4\"/>\n    <path d=\"M0,540 L150,540 L170,560 L380,560\" stroke=\"#FF8A2C\" stroke-width=\"1\" fill=\"none\" opacity=\"0.4\"/>\n    <circle cx=\"220\" cy=\"80\" r=\"3\" fill=\"#00D4FF\"/>\n    <circle cx=\"170\" cy=\"560\" r=\"3\" fill=\"#FF8A2C\"/>\n  </svg>\n\n  <svg class=\"watermark\" viewBox=\"0 0 100 100\"><use href=\"#claude-star\" fill=\"#00D4FF\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <span class=\"pulse\"></span>\n      REAL TRADES CASE STUDY\n    </div>\n\n    <div class=\"hero-visual\">\n      <!-- Woman graphic -->\n      <svg class=\"woman-graphic\" viewBox=\"0 0 110 140\">\n        <!-- Hair back -->\n        <path d=\"M30,42 Q28,58 32,72 L34,82 L28,88 L30,45 Z\" fill=\"#4A2E1F\"/>\n        <path d=\"M80,42 Q82,58 78,72 L76,82 L82,88 L80,45 Z\" fill=\"#4A2E1F\"/>\n        <!-- Neck -->\n        <rect x=\"50\" y=\"46\" width=\"10\" height=\"12\" fill=\"#E8B896\"/>\n        <!-- Body / blouse -->\n        <path d=\"M32,60 Q30,90 32,120 L78,120 Q80,90 78,60 Q70,55 60,58 L55,58 Q45,55 32,60 Z\" fill=\"#FF8A2C\"/>\n        <!-- Collar -->\n        <path d=\"M50,58 L55,68 L60,58 Z\" fill=\"#0B1929\"/>\n        <!-- Head -->\n        <ellipse cx=\"55\" cy=\"32\" rx=\"18\" ry=\"20\" fill=\"#E8B896\"/>\n        <!-- Hair top -->\n        <path d=\"M37,26 Q40,12 55,10 Q72,12 74,28 Q74,32 72,34 Q68,20 55,18 Q42,20 38,34 Q36,32 37,26 Z\" fill=\"#4A2E1F\"/>\n        <!-- Eyes -->\n        <ellipse cx=\"48\" cy=\"32\" rx=\"1.5\" ry=\"2\" fill=\"#0B1929\"/>\n        <ellipse cx=\"62\" cy=\"32\" rx=\"1.5\" ry=\"2\" fill=\"#0B1929\"/>\n        <!-- Eyebrows -->\n        <path d=\"M45,28 L51,27\" stroke=\"#4A2E1F\" stroke-width=\"1.2\" fill=\"none\"/>\n        <path d=\"M59,27 L65,28\" stroke=\"#4A2E1F\" stroke-width=\"1.2\" fill=\"none\"/>\n        <!-- Mouth (slight frown) -->\n        <path d=\"M50,40 Q55,38 60,40\" stroke=\"#8B4A3A\" stroke-width=\"1.2\" fill=\"none\"/>\n        <!-- Cheek -->\n        <circle cx=\"43\" cy=\"36\" r=\"2\" fill=\"#F5A88A\" opacity=\"0.5\"/>\n        <circle cx=\"67\" cy=\"36\" r=\"2\" fill=\"#F5A88A\" opacity=\"0.5\"/>\n        <!-- Arms holding paper -->\n        <rect x=\"30\" y=\"88\" width=\"10\" height=\"20\" rx=\"4\" fill=\"#E8B896\"/>\n        <rect x=\"70\" y=\"88\" width=\"10\" height=\"20\" rx=\"4\" fill=\"#E8B896\"/>\n        <!-- Spreadsheet in hands -->\n        <rect x=\"38\" y=\"94\" width=\"34\" height=\"24\" fill=\"white\" stroke=\"#ef4444\" stroke-width=\"1\"/>\n        <line x1=\"38\" y1=\"100\" x2=\"72\" y2=\"100\" stroke=\"#ef4444\" stroke-width=\"0.5\"/>\n        <line x1=\"38\" y1=\"106\" x2=\"72\" y2=\"106\" stroke=\"#ef4444\" stroke-width=\"0.5\"/>\n        <line x1=\"38\" y1=\"112\" x2=\"72\" y2=\"112\" stroke=\"#ef4444\" stroke-width=\"0.5\"/>\n        <line x1=\"50\" y1=\"94\" x2=\"50\" y2=\"118\" stroke=\"#ef4444\" stroke-width=\"0.5\"/>\n        <line x1=\"62\" y1=\"94\" x2=\"62\" y2=\"118\" stroke=\"#ef4444\" stroke-width=\"0.5\"/>\n      </svg>\n\n      <div class=\"thought-bubble\">\n        <div class=\"thought-text\">\"3 spreadsheets<br>+ missed jobs...\"</div>\n      </div>\n    </div>\n\n    <h1 class=\"headline\">He didn't fire her because she was <em>bad.</em></h1>\n    <p class=\"subtitle\">He fired her because a workflow was better.</p>\n    <div class=\"cta\">→ Sound familiar?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-header\">\n        <div class=\"panel-title\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#00D4FF\" stroke-width=\"2\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n          Case Study · Electrician\n        </div>\n        <div class=\"panel-tag\">⚡ Sparky Co.</div>\n      </div>\n\n      <div class=\"compare\">\n        <div class=\"col before\">\n          <div class=\"col-label\">◇ BEFORE</div>\n          <div class=\"col-line\">1 office manager</div>\n          <div class=\"col-line\">3 spreadsheets</div>\n          <div class=\"col-line\">Missed jobs weekly</div>\n        </div>\n        <div class=\"col after\">\n          <div class=\"col-label\">◆ AFTER</div>\n          <div class=\"col-line\">1 workflow</div>\n          <div class=\"col-line\">0 dropped leads</div>\n          <div class=\"col-line\">Sundays off</div>\n        </div>\n      </div>\n\n      <div class=\"stack\">\n        <div class=\"row\">\n          <div class=\"tool-icon\" style=\"background:rgba(59,130,246,0.15)\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3B82F6\" stroke-width=\"2\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/></svg>\n          </div>\n          <div class=\"row-text\"><b>GoHighLevel</b> — lead intake</div>\n          <div class=\"row-tag\">24/7</div>\n        </div>\n        <div class=\"row orange\">\n          <div class=\"tool-icon\" style=\"background:rgba(255,138,44,0.15)\">\n            <svg viewBox=\"0 0 100 100\"><use href=\"#claude-star\" fill=\"#FF8A2C\"/></svg>\n          </div>\n          <div class=\"row-text\"><b>Claude Code</b> — auto-generates quotes</div>\n          <div class=\"row-tag\">&lt; 60s</div>\n        </div>\n        <div class=\"row\">\n          <div class=\"tool-icon\" style=\"background:rgba(234,75,113,0.15)\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#EA4B71\" stroke-width=\"2\"><circle cx=\"6\" cy=\"6\" r=\"3\"/><circle cx=\"18\" cy=\"6\" r=\"3\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><circle cx=\"18\" cy=\"18\" r=\"3\"/><path d=\"M9 6h6M9 18h6M6 9v6M18 9v6\"/></svg>\n          </div>\n          <div class=\"row-text\"><b>N8N</b> — schedules the job</div>\n          <div class=\"row-tag\">HANDS-OFF</div>\n        </div>\n      </div>\n\n      <div class=\"savings\">\n        <div class=\"savings-icon\">💰</div>\n        <div class=\"savings-num\">$45K</div>\n        <div class=\"savings-label\">saved per year<span>replaced admin role</span></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">Export PNG</button>\n\n<script>\n  document.getElementById('exportBtn').addEventListener('click', () => {\n    domtoimage.toPng(document.getElementById('post'), { width: 1200, height: 630, quality: 1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-electrician-case.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>"
}