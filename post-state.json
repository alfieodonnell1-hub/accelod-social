  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod – The Tool Stack Lie IG</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body { background:#111; display:flex; flex-direction:column; align-items:center; padding:20px; gap:16px; font-family:'DM Sans',sans-serif; }\n  #post {\n    width:1080px; height:1350px;\n    background:#0B1929;\n    position:relative; overflow:hidden;\n    display:flex; flex-direction:column;\n    padding:52px 56px 44px;\n    color:#fff;\n  }\n  .dot-grid { position:absolute; inset:0; background-image:radial-gradient(circle,rgba(0,212,255,0.08) 1px,transparent 1px); background-size:28px 28px; pointer-events:none; }\n  .glow { position:absolute; top:-180px; left:-140px; width:640px; height:640px; background:radial-gradient(circle,rgba(0,212,255,0.14) 0%,transparent 60%); pointer-events:none; }\n  .watermark { position:absolute; top:-70px; right:-70px; width:480px; height:480px; opacity:0.05; transform:rotate(12deg); pointer-events:none; color:#00D4FF; }\n\n  .badge-row { display:flex; gap:10px; margin-bottom:22px; z-index:2; position:relative; }\n  .badge { display:inline-flex; align-items:center; gap:8px; padding:10px 18px; border-radius:100px; font-family:'JetBrains Mono',monospace; font-size:15px; width:fit-content; }\n  .badge.cyan { border:1.5px solid rgba(0,212,255,0.6); color:#00D4FF; background:rgba(0,212,255,0.05); }\n  .badge.dark { background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); color:#EF4444; }\n  .badge-dot { width:8px; height:8px; border-radius:50%; }\n\n  .headline { font-family:'Outfit',sans-serif; font-weight:900; font-size:100px; line-height:0.94; letter-spacing:-0.035em; margin-bottom:18px; z-index:2; position:relative; }\n  .headline em { font-style:normal; background:linear-gradient(90deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\n  .subtitle { font-size:23px; color:rgba(255,255,255,0.6); line-height:1.4; margin-bottom:26px; max-width:900px; z-index:2; position:relative; }\n\n  .panel { background:#06101A; border:1px solid rgba(0,212,255,0.2); border-radius:20px; padding:28px; z-index:2; position:relative; display:flex; flex-direction:column; gap:20px; flex:1; }\n\n  .compare-head { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:8px; }\n  .col-head { display:flex; align-items:baseline; gap:12px; }\n  .col-num { font-family:'Outfit',sans-serif; font-weight:900; font-size:72px; line-height:1; letter-spacing:-0.03em; }\n  .col-num.bad { color:#EF4444; }\n  .col-num.good { background:linear-gradient(90deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\n  .col-title { font-family:'JetBrains Mono',monospace; font-size:18px; text-transform:uppercase; letter-spacing:0.08em; }\n  .col-title.bad { color:#EF4444; }\n  .col-title.good { color:#00D4FF; }\n  .col-sub { font-family:'JetBrains Mono',monospace; font-size:14px; color:rgba(255,255,255,0.4); text-transform:uppercase; letter-spacing:0.08em; margin-top:4px; }\n\n  .messy-box { background:rgba(239,68,68,0.05); border:1px dashed rgba(239,68,68,0.3); border-radius:14px; padding:20px; }\n  .messy-grid { display:flex; flex-wrap:wrap; gap:10px; }\n  .messy-chip { font-family:'JetBrains Mono',monospace; font-size:16px; color:rgba(255,255,255,0.55); background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); padding:10px 14px; border-radius:8px; display:inline-flex; align-items:center; gap:8px; }\n  .messy-chip.strike { text-decoration:line-through; text-decoration-color:rgba(239,68,68,0.7); text-decoration-thickness:2px; opacity:0.7; }\n  .messy-x { color:#EF4444; font-weight:700; font-size:18px; }\n\n  .divider-label { display:flex; align-items:center; gap:14px; margin:4px 0; }\n  .divider-label .line { flex:1; height:1px; background:rgba(0,212,255,0.2); }\n  .divider-label .txt { font-family:'JetBrains Mono',monospace; font-size:15px; color:#00D4FF; text-transform:uppercase; letter-spacing:0.1em; display:flex; align-items:center; gap:8px; }\n\n  .clean-stack { display:flex; flex-direction:column; gap:12px; }\n  .tool-row { display:flex; align-items:center; gap:14px; padding:16px 18px; background:rgba(0,212,255,0.05); border:1px solid rgba(0,212,255,0.18); border-radius:12px; position:relative; }\n  .tool-row::before { content:''; position:absolute; left:0; top:0; bottom:0; width:4px; border-radius:12px 0 0 12px; }\n  .tool-row:nth-child(1)::before { background:#00D4FF; }\n  .tool-row:nth-child(2)::before { background:#EA4B71; }\n  .tool-row:nth-child(3)::before { background:#F59E0B; }\n  .tool-row:nth-child(4)::before { background:#4285F4; }\n  .tool-logo { flex-shrink:0; }\n  .tool-name { font-family:'Outfit',sans-serif; font-weight:700; font-size:22px; color:#fff; }\n  .tool-role { font-family:'DM Sans',sans-serif; font-size:18px; color:rgba(255,255,255,0.5); flex:1; }\n  .tool-tag { font-family:'JetBrains Mono',monospace; font-size:13px; color:#00D4FF; background:rgba(0,212,255,0.1); border:1px solid rgba(0,212,255,0.25); border-radius:6px; padding:4px 10px; white-space:nowrap; }\n\n  .insight { display:flex; gap:16px; align-items:flex-start; background:rgba(0,212,255,0.06); border:1px solid rgba(0,212,255,0.22); border-radius:14px; padding:20px; position:relative; overflow:hidden; }\n  .insight::before { content:''; position:absolute; left:0; top:0; bottom:0; width:4px; background:linear-gradient(180deg,#00D4FF,#33E1FF); }\n  .insight-icon { width:48px; height:48px; border-radius:10px; background:linear-gradient(135deg,#00D4FF,#33E1FF); display:flex; align-items:center; justify-content:center; font-family:'Outfit',sans-serif; font-weight:900; font-size:28px; color:#0B1929; flex-shrink:0; }\n  .insight-title { font-family:'Outfit',sans-serif; font-weight:700; font-size:22px; color:#fff; line-height:1.2; margin-bottom:6px; }\n  .insight-desc { font-size:18px; color:rgba(255,255,255,0.6); line-height:1.4; }\n\n  .footer { display:flex; align-items:center; justify-content:space-between; margin-top:22px; z-index:2; position:relative; }\n  .cta { display:inline-flex; align-items:center; gap:10px; padding:18px 30px; background:rgba(0,212,255,0.1); border:1.5px solid #00D4FF; border-radius:100px; font-family:'DM Sans',sans-serif; font-size:22px; font-weight:500; color:#fff; }\n  .cta-dot { width:10px; height:10px; border-radius:50%; background:#00D4FF; box-shadow:0 0 10px #00D4FF; }\n  .logo { font-family:'Outfit',sans-serif; font-weight:900; font-size:32px; letter-spacing:-0.02em; background:linear-gradient(90deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\n  button { padding:12px 24px; background:#00D4FF; color:#0B1929; border:none; border-radius:8px; font-size:15px; cursor:pointer; }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge-row\">\n    <div class=\"badge cyan\"><svg width=\"14\" height=\"14\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>AI Automation</div>\n    <div class=\"badge dark\"><div class=\"badge-dot\" style=\"background:#EF4444\"></div>Myth Bust</div>\n  </div>\n\n  <h1 class=\"headline\">The tool stack<br><em>lie.</em></h1>\n  <p class=\"subtitle\">You don't need 47 SaaS subscriptions. You need one thing: a brain that connects them.</p>\n\n  <div class=\"panel\">\n    <div class=\"compare-head\">\n      <div>\n        <div class=\"col-head\"><div class=\"col-num bad\">15+</div><div><div class=\"col-title bad\">✗ Duct-tape</div><div class=\"col-sub\">Disconnected apps</div></div></div>\n      </div>\n      <div>\n        <div class=\"col-head\"><div class=\"col-num good\">4</div><div><div class=\"col-title good\">✓ Integrated</div><div class=\"col-sub\">One brain</div></div></div>\n      </div>\n    </div>\n\n    <div class=\"messy-box\">\n      <div class=\"messy-grid\">\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Zapier</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Make</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Airtable</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Notion</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Trello</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Slack bots</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>HubSpot</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Mailchimp</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Calendly</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Typeform</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Sheets</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>ChatGPT</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Pipedrive</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>Asana</span>\n        <span class=\"messy-chip strike\"><span class=\"messy-x\">✕</span>+more</span>\n      </div>\n    </div>\n\n    <div class=\"divider-label\"><div class=\"line\"></div><div class=\"txt\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 5v14M19 12l-7 7-7-7\"/></svg>Replaced by<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 5v14M19 12l-7 7-7-7\"/></svg></div><div class=\"line\"></div></div>\n\n    <div class=\"clean-stack\">\n      <div class=\"tool-row\">\n        <svg width=\"38\" height=\"38\" viewBox=\"0 0 100 100\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n        <span class=\"tool-name\">Claude</span>\n        <span class=\"tool-role\">— the brain</span>\n        <span class=\"tool-tag\">reasoning</span>\n      </div>\n      <div class=\"tool-row\">\n        <svg width=\"38\" height=\"38\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#EA4B71\" stroke-width=\"2\"><circle cx=\"6\" cy=\"6\" r=\"3\"/><circle cx=\"18\" cy=\"6\" r=\"3\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><circle cx=\"18\" cy=\"18\" r=\"3\"/><path d=\"M9 6h6M9 18h6M6 9v6M18 9v6\"/></svg>\n        <span class=\"tool-name\">N8N</span>\n        <span class=\"tool-role\">— the nervous system</span>\n        <span class=\"tool-tag\">workflows</span>\n      </div>\n      <div class=\"tool-row\">\n        <svg width=\"38\" height=\"38\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>\n        <span class=\"tool-name\">GoHighLevel</span>\n        <span class=\"tool-role\">— the CRM engine</span>\n        <span class=\"tool-tag\">leads + comms</span>\n      </div>\n      <div class=\"tool-row\">\n        <svg width=\"38\" height=\"38\" viewBox=\"0 0 48 48\"><path fill=\"#4285F4\" d=\"M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z\"/><path fill=\"#34A853\" d=\"M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z\"/><path fill=\"#FBBC05\" d=\"M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z\"/><path fill=\"#EA4335\" d=\"M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z\"/></svg>\n        <span class=\"tool-name\">Google Workspace</span>\n        <span class=\"tool-role\">— the source of truth</span>\n        <span class=\"tool-tag\">data</span>\n      </div>\n    </div>\n\n    <div class=\"insight\">\n      <div class=\"insight-icon\">💡</div>\n      <div>\n        <div class=\"insight-title\">Tool count doesn't win. Integration does.</div>\n        <div class=\"insight-desc\">A stack of 4 that talks beats a stack of 40 that doesn't.</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta\"><span class=\"cta-dot\"></span>Stacking apps again?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n</div>\n<button onclick=\"domtoimage.toPng(document.getElementById('post'),{width:1080,height:1350,quality:1}).then(d=>{const l=document.createElement('a');l.download='accelod-tool-stack-lie.png';l.href=d;l.click();})\">Export PNG</button>\n</body>\n</html>",
  "fb_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod – Tool Stack Lie FB</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.com/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body { background:#111; display:flex; flex-direction:column; align-items:center; padding:20px; font-family:'DM Sans',sans-serif; }\n  #post {\n    width:1200px; height:630px;\n    background:#0B1929;\n    position:relative; overflow:hidden;\n    display:flex; color:#fff;\n  }\n  .dot-grid { position:absolute; inset:0; background-image:radial-gradient(circle,rgba(0,212,255,0.07) 1px,transparent 1px); background-size:24px 24px; pointer-events:none; }\n  .glow { position:absolute; top:-160px; left:-160px; width:560px; height:560px; background:radial-gradient(circle,rgba(0,212,255,0.14),transparent 65%); pointer-events:none; }\n  .watermark { position:absolute; top:-60px; right:-60px; width:380px; height:380px; opacity:0.05; transform:rotate(12deg); pointer-events:none; color:#00D4FF; }\n\n  .left { width:400px; padding:32px 24px 28px 32px; display:flex; flex-direction:column; position:relative; z-index:2; flex-shrink:0; }\n  .badge { display:inline-flex; align-items:center; gap:8px; padding:9px 15px; border:1.5px solid rgba(0,212,255,0.5); border-radius:100px; font-family:'JetBrains Mono',monospace; font-size:13px; color:#00D4FF; width:fit-content; margin-bottom:20px; background:rgba(0,212,255,0.05); }\n\n  .headline { font-family:'Outfit',sans-serif; font-weight:900; font-size:62px; line-height:0.96; letter-spacing:-0.03em; color:#fff; margin-bottom:16px; }\n  .headline em { font-style:normal; background:linear-gradient(90deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\n\n  .subtitle { font-size:16px; color:rgba(255,255,255,0.6); line-height:1.5; margin-bottom:22px; }\n\n  .spacer { flex:1; }\n\n  .cta { display:inline-flex; align-items:center; gap:10px; padding:14px 22px; background:rgba(0,212,255,0.1); border:1.5px solid #00D4FF; border-radius:100px; font-family:'Outfit',sans-serif; font-weight:700; font-size:16px; color:#fff; width:fit-content; margin-bottom:16px; }\n  .cta-dot { width:9px; height:9px; border-radius:50%; background:#00D4FF; box-shadow:0 0 10px #00D4FF; }\n\n  .footer-row { display:flex; justify-content:flex-end; align-items:center; }\n  .logo { font-family:'Outfit',sans-serif; font-weight:900; font-size:26px; letter-spacing:-0.02em; background:linear-gradient(135deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\n\n  .right { flex:1; padding:28px 32px 28px 8px; position:relative; z-index:2; display:flex; flex-direction:column; }\n  .panel { background:#06101A; border:1px solid rgba(0,212,255,0.2); border-radius:16px; padding:24px; flex:1; display:flex; flex-direction:column; gap:18px; }\n\n  .panel-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:4px; }\n  .panel-title { font-family:'JetBrains Mono',monospace; font-size:18px; color:rgba(255,255,255,0.55); text-transform:uppercase; letter-spacing:0.08em; }\n  .panel-tag { font-family:'JetBrains Mono',monospace; font-size:18px; color:#00D4FF; }\n\n  .compare { display:grid; grid-template-columns:1fr 1fr; gap:14px; }\n  .col { border-radius:12px; padding:16px; display:flex; flex-direction:column; gap:12px; }\n  .col.bad { background:rgba(239,68,68,0.08); border:2px solid rgba(239,68,68,0.3); }\n  .col.good { background:rgba(0,212,255,0.08); border:2px solid rgba(0,212,255,0.3); }\n  .col-title { font-family:'JetBrains Mono',monospace; font-size:18px; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:4px; font-weight:500; display:flex; align-items:center; gap:8px; }\n  .col.bad .col-title { color:#EF4444; }\n  .col.good .col-title { color:#00D4FF; }\n\n  .icon-x { display:inline-block; width:20px; height:20px; }\n  .icon-check { display:inline-block; width:20px; height:20px; }\n\n  .chip-cloud { display:flex; flex-wrap:wrap; gap:6px; }\n  .chip { font-family:'JetBrains Mono',monospace; font-size:11px; padding:5px 9px; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.3); border-radius:5px; color:rgba(255,255,255,0.75); white-space:nowrap; }\n  .chip-count { font-family:'Outfit',sans-serif; font-weight:900; font-size:28px; color:#EF4444; margin-top:4px; display:flex; align-items:baseline; gap:8px; }\n  .chip-count-label { font-size:14px; color:rgba(239,68,68,0.7); font-family:'JetBrains Mono',monospace; font-weight:500; }\n\n  .tool-row { display:flex; align-items:center; gap:12px; padding:8px 10px; background:rgba(0,212,255,0.05); border-radius:8px; border:1px solid rgba(0,212,255,0.15); }\n  .tool-row svg { flex-shrink:0; }\n  .tool-name { font-size:16px; font-weight:700; color:#fff; }\n  .tool-desc { font-size:13px; color:rgba(255,255,255,0.5); font-family:'JetBrains Mono',monospace; }\n\n  .stat-strip { display:flex; align-items:center; justify-content:space-between; background:linear-gradient(135deg, rgba(0,212,255,0.1), rgba(51,225,255,0.08)); border:2px solid rgba(0,212,255,0.3); border-radius:12px; padding:18px 22px; }\n  .stat-left { display:flex; align-items:baseline; gap:14px; }\n  .stat-num { font-family:'Outfit',sans-serif; font-weight:900; font-size:56px; background:linear-gradient(90deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; line-height:1; }\n  .stat-label { font-family:'JetBrains Mono',monospace; font-size:18px; color:rgba(255,255,255,0.7); text-transform:uppercase; letter-spacing:0.06em; }\n  .stat-right { font-family:'Outfit',monospace; font-size:22px; color:#22C55E; font-weight:700; display:flex; align-items:center; gap:8px; }\n\n  button { margin-top:12px; padding:10px 20px; background:#00D4FF; color:#0B1929; border:none; border-radius:6px; cursor:pointer; font-weight:700; }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\"><svg width=\"13\" height=\"13\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>AI Automation · Myth</div>\n\n    <h1 class=\"headline\">You don't need <em>47 tools.</em></h1>\n    <p class=\"subtitle\">You need one thing: a brain that connects them. Tool count is vanity — integration is the whole game.</p>\n\n    <div class=\"spacer\"></div>\n\n    <div class=\"cta\"><span class=\"cta-dot\"></span>Sound familiar?</div>\n    <div class=\"footer-row\">\n      <div class=\"logo\">Accelod AI</div>\n    </div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-header\">\n        <div class=\"panel-title\">// The Tool Stack Lie</div>\n        <div class=\"panel-tag\">Bust ⚡</div>\n      </div>\n\n      <div class=\"compare\">\n        <div class=\"col bad\">\n          <div class=\"col-title\">\n            <svg class=\"icon-x\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#EF4444\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M18 6L6 18M6 6l12 12\"/></svg>\n            Their Stack\n          </div>\n          <div class=\"chip-cloud\">\n            <span class=\"chip\">Zapier</span><span class=\"chip\">Make</span><span class=\"chip\">Airtable</span>\n            <span class=\"chip\">Notion</span><span class=\"chip\">Slack</span><span class=\"chip\">Trello</span>\n            <span class=\"chip\">HubSpot</span><span class=\"chip\">Calendly</span><span class=\"chip\">Typeform</span>\n            <span class=\"chip\">Loom</span><span class=\"chip\">Pipedrive</span><span class=\"chip\">Intercom</span>\n            <span class=\"chip\">Mailchimp</span><span class=\"chip\">ClickUp</span><span class=\"chip\">+more</span>\n          </div>\n          <div class=\"chip-count\">\n            15+\n            <span class=\"chip-count-label\">apps · 0 sync</span>\n          </div>\n        </div>\n        <div class=\"col good\">\n          <div class=\"col-title\">\n            <svg class=\"icon-check\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#00D4FF\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n            Our Stack\n          </div>\n          <div class=\"tool-row\">\n            <svg width=\"32\" height=\"32\" viewBox=\"0 0 100 100\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n            <div style=\"display:flex; flex-direction:column; gap:2px;\">\n              <span class=\"tool-name\">Claude</span>\n              <span class=\"tool-desc\">the brain</span>\n            </div>\n          </div>\n          <div class=\"tool-row\">\n            <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#EA4B71\" stroke-width=\"2\"><circle cx=\"6\" cy=\"6\" r=\"3\"/><circle cx=\"18\" cy=\"6\" r=\"3\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><circle cx=\"18\" cy=\"18\" r=\"3\"/><path d=\"M9 6h6M9 18h6M6 9v6M18 9v6\"/></svg>\n            <div style=\"display:flex; flex-direction:column; gap:2px;\">\n              <span class=\"tool-name\">N8N</span>\n              <span class=\"tool-desc\">the wiring</span>\n            </div>\n          </div>\n          <div class=\"tool-row\">\n            <svg width=\"32\" height=\"32\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>\n            <div style=\"display:flex; flex-direction:column; gap:2px;\">\n              <span class=\"tool-name\">GoHighLevel</span>\n              <span class=\"tool-desc\">the CRM</span>\n            </div>\n          </div>\n          <div class=\"tool-row\">\n            <svg width=\"32\" height=\"32\" viewBox=\"0 0 48 48\"><path fill=\"#4285F4\" d=\"M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z\"/><path fill=\"#34A853\" d=\"M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z\"/><path fill=\"#FBBC05\" d=\"M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z\"/><path fill=\"#EA4335\" d=\"M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z\"/></svg>\n            <div style=\"display:flex; flex-direction:column; gap:2px;\">\n              <span class=\"tool-name\">Google</span>\n              <span class=\"tool-desc\">the workspace</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"stat-strip\">\n        <div class=\"stat-left\">\n          <span class=\"stat-num\">4</span>\n          <span class=\"stat-label\">tools · fully integrated</span>\n        </div>\n        <span class=\"stat-right\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#22C55E\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n          replaces 15+\n        </span>\n      </div>\n    </div>\n  </div>\n</div>\n<button id=\"exportBtn\">Export PNG</button>\n<script>\n  document.getElementById('exportBtn').addEventListener('click', () => {\n    domtoimage.toPng(document.getElementById('post'), { width: 1200, height: 630, quality: 1 })\n      .then(dataUrl => { const link = document.createElement('a'); link.download = 'accelod-tool-stack-lie.png'; link.href = dataUrl; link.click(); });\n  });\n</script>\n</body>\n</html>"
