x;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -0.5px;\n  }\n  .logo svg { width: 32px; height: 32px; }\n\n  /* ============ FACEBOOK POST (1200x630) ============ */\n  #fb-post {\n    width: 1200px;\n    height: 630px;\n    background: #0B1929;\n    position: relative;\n    overflow: hidden;\n    padding: 50px 55px;\n    display: flex;\n    flex-direction: column;\n    font-family: 'DM Sans', sans-serif;\n  }\n  #fb-post .dot-grid {\n    position: absolute;\n    inset: 0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 26px 26px;\n    pointer-events: none;\n  }\n  #fb-post .glow {\n    position: absolute;\n    top: -180px;\n    left: -180px;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(0,212,255,0.2) 0%, transparent 60%);\n    pointer-events: none;\n  }\n  #fb-post .watermark {\n    position: absolute;\n    bottom: -120px;\n    right: -120px;\n    width: 450px;\n    height: 450px;\n    opacity: 0.06;\n    transform: rotate(18deg);\n    pointer-events: none;\n  }\n  .fb-top {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    position: relative;\n    z-index: 2;\n  }\n  .fb-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    border: 1.5px solid #00D4FF;\n    border-radius: 999px;\n    padding: 10px 20px;\n    color: #00D4FF;\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 700;\n    font-size: 16px;\n    letter-spacing: 0.5px;\n  }\n  .fb-badge svg { width: 16px; height: 16px; }\n  .fb-logo {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 28px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .fb-logo svg { width: 28px; height: 28px; }\n  .fb-body {\n    display: grid;\n    grid-template-columns: 1.15fr 1fr;\n    gap: 40px;\n    margin-top: 28px;\n    flex: 1;\n    position: relative;\n    z-index: 2;\n    align-items: center;\n  }\n  .fb-headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 76px;\n    line-height: 0.95;\n    color: #fff;\n    letter-spacing: -2px;\n  }\n  .fb-headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .fb-sub {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 700;\n    font-size: 22px;\n    color: #fff;\n    margin-top: 18px;\n    line-height: 1.35;\n  }\n  .fb-sub span {\n    color: #33E1FF;\n  }\n  .fb-cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: rgba(0,212,255,0.12);\n    border: 1.5px solid #00D4FF;\n    color: #fff;\n    padding: 14px 24px;\n    border-radius: 999px;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 700;\n    font-size: 18px;\n    margin-top: 22px;\n  }\n  .fb-cta .pulse {\n    width: 9px; height: 9px;\n    background: #00D4FF;\n    border-radius: 50%;\n    box-shadow: 0 0 10px #00D4FF;\n  }\n  .fb-stack {\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n  }\n  .fb-stack-label {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    color: #00D4FF;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n    font-weight: 700;\n    margin-bottom: 4px;\n  }\n  .fb-tool {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    background: rgba(0,0,0,0.3);\n    border: 1px solid rgba(0,212,255,0.25);\n    border-radius: 14px;\n    padding: 14px 18px;\n  }\n  .fb-tool-icon {\n    width: 54px;\n    height: 54px;\n    border-radius: 12px;\n    background: #fff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    padding: 8px;\n  }\n  .fb-tool-icon svg { width: 100%; height: 100%; }\n  .fb-tool-icon.dark { background: #0B1929; border: 1px solid rgba(0,212,255,0.3); }\n  .fb-tool-text {\n    display: flex;\n    flex-direction: column;\n  }\n  .fb-tool-name {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 20px;\n    color: #fff;\n    line-height: 1.1;\n  }\n  .fb-tool-desc {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 500;\n    font-size: 14px;\n    color: rgba(255,255,255,0.7);\n    margin-top: 2px;\n  }\n\n  #exportBtn {\n    margin-top: 30px;\n    padding: 14px 28px;\n    background: #00D4FF;\n    color: #0B1929;\n    border: none;\n    border-radius: 8px;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    cursor: pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <g>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"2\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"2\" transform=\"rotate(30)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"2\" transform=\"rotate(60)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"2\" transform=\"rotate(90)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"2\" transform=\"rotate(120)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"2\" transform=\"rotate(150)\"/>\n      </g>\n    </g>\n  </symbol>\n\n  <!-- N8N Logo -->\n  <symbol id=\"n8n-logo\" viewBox=\"0 0 64 64\">\n    <g fill=\"none\" stroke=\"#EA4B71\" stroke-width=\"3.5\" stroke-linecap=\"round\">\n      <circle cx=\"10\" cy=\"32\" r=\"5\" fill=\"#EA4B71\"/>\n      <circle cx=\"32\" cy=\"20\" r=\"5\" fill=\"#EA