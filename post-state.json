 }\n\n  .panel {\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    margin-top: 36px;\n    padding: 28px;\n    position: relative;\n    z-index: 2;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n  .row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px;\n    align-items: stretch;\n  }\n  .cell {\n    padding: 20px 24px;\n    border-radius: 12px;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .myth {\n    background: rgba(255,80,80,0.06);\n    border: 1px solid rgba(255,90,90,0.25);\n  }\n  .reality {\n    background: rgba(0,212,255,0.08);\n    border: 1px solid rgba(0,212,255,0.35);\n  }\n  .label {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 500;\n    font-size: 22px;\n    letter-spacing: 0.08em;\n  }\n  .label.m { color: #FF6B6B; }\n  .label.r { color: #33E1FF; }\n  .text {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 700;\n    font-size: 28px;\n    color: #fff;\n    line-height: 1.25;\n  }\n  .footer {\n    margin-top: auto;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    position: relative;\n    z-index: 2;\n    padding-top: 36px;\n  }\n  .cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    padding: 20px 34px;\n    border-radius: 999px;\n    background: rgba(0,212,255,0.1);\n    border: 1.5px solid rgba(0,212,255,0.4);\n    color: #fff;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 500;\n    font-size: 28px;\n  }\n  .cta::before {\n    content: '';\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: #00D4FF;\n    box-shadow: 0 0 14px #00D4FF;\n  }\n  .logo {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 44px;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -0.02em;\n  }\n  #export {\n    padding: 14px 28px;\n    background: #00D4FF;\n    color: #0B1929;\n    border: none;\n    border-radius: 8px;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 500;\n    font-size: 16px;\n    cursor: pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <path d=\"M 0,-48 L 3,-8 L 0,0 L -3,-8 Z\"/>\n      <path d=\"M 0,48 L 3,8 L 0,0 L -3,8 Z\"/>\n      <path d=\"M -48,0 L -8,-3 L 0,0 L -8,3 Z\"/>\n      <path d=\"M 48,0 L 8,-3 L 0,0 L 8,3 Z\"/>\n      <g transform=\"rotate(30)\">\n        <path d=\"M 0,-48 L 3,-8 L 0,0 L -3,-8 Z\"/>\n        <path d=\"M 0,48 L 3,8 L 0,0 L -3,8 Z\"/>\n        <path d=\"M -48,0 L -8,-3 L 0,0 L -8,3 Z\"/>\n        <path d=\"M 48,0 L 8,-3 L 0,0 L 8,3 Z\"/>\n      </g>\n      <g transform=\"rotate(60)\">\n        <path d=\"M 0,-48 L 3,-8 L 0,0 L -3,-8 Z\"/>\n        <path d=\"M 0,48 L 3,8 L 0,0 L -3,8 Z\"/>\n        <path d=\"M -48,0 L -8,-3 L 0,0 L -8,3 Z\"/>\n        <path d=\"M 48,0 L 8,-3 L 0,0 L 8,3 Z\"/>\n      </g>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge\">\n    <svg style=\"color:#D97757\"><use href=\"#claude-star\"/></svg>\n    Myth vs reality\n  </div>\n\n  <h1 class=\"headline\">Myth vs<br><em>reality</em></h1>\n\n  <div class=\"scene\">\n    <!-- Boy illustration -->\n    <svg class=\"boy\" viewBox=\"0 0 210 260\" xmlns=\"http://www.w3.org/2000/svg\">\n      <!-- Hair -->\n      <path d=\"M55 70 Q55 30 105 30 Q155 30 155 70 L155 90 Q150 75 130 72 Q115 60 95 65 Q75 68 65 85 Q58 85 55 90 Z\" fill=\"#2A1810\"/>\n      <!-- Face -->\n      <ellipse cx=\"105\" cy=\"90\" rx=\"42\" ry=\"48\" fill=\"#F4C7A1\"/>\n      <!-- Ears -->\n      <ellipse cx=\"63\" cy=\"92\" rx=\"7\" ry=\"10\" fill=\"#F4C7A1\"/>\n      <ellipse cx=\"147\" cy=\"92\" rx=\"7\" ry=\"10\" fill=\"#F4C7A1\"/>\n      <!-- Eyes -->\n      <circle cx=\"90\" cy=\"90\" r=\"4\" fill=\"#0B1929\"/>\n      <circle cx=\"120\" cy=\"90\" r=\"4\" fill=\"#0B1929\"/>\n      <circle cx=\"91\" cy=\"89\" r=\"1.2\" fill=\"#fff\"/>\n      <circle cx=\"121\" cy=\"89\" r=\"1.2\" fill=\"#fff\"/>\n      <!-- Eyebrows -->\n      <path d=\"M83 80 Q90 77 97 80\" stroke=\"#2A1810\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/>\n      <path d=\"M113 80 Q120 77 127 80\" stroke=\"#2A1810\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/>\n      <!-- Smile -->\n      <path d=\"M92 110 Q105 120 118 110\" stroke=\"#2A1810\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/>\n      <!-- Neck -->\n      <rect x=\"95\" y=\"132\" width=\"20\" height=\"18\" fill=\"#E5B58F\"/>\n      <!-- Shirt / body -->\n      <path d=\"M50 260 L50 180 Q50 155 80 148 L130 148 Q160 155 160 180 L160 260 Z\" fill=\"#00D4FF\"/>\n      <!-- Shirt collar -->\n      <path d=\"M85 148 L105 165 L125 148 Z\" fill=\"#0B1929\"/>\n      <!-- Arm raised pointing -->\n      <path d=\"M155 175 Q175 155 178 130\" stroke=\"#00D4FF\" stroke-width=\"22\" fill=\"none\" stroke-linecap=\"round\"/>\n      <circle cx=\"178\" cy=\"128\" r=\"10\" fill=\"#F4C7A1\"/>\n    </svg>\n\n    <div class=\"bubble\">Wait, so AI <em>won't</em> steal my job?</div>\n\n    <!-- Claudebot icon (orange) -->\n    <svg class=\"claudebot\" viewBox=\"-50 -50 100 100\" style=\"color:#D97757\"><use href=\"#claude-star\"/></svg>\n  </div>\n\n  <div class=\"panel\">\n    <div class=\"row\">\n      <div class=\"cell myth\">\n        <div class=\"label m\">MYTH</div>\n        <div class=\"text\">AI replaces people.</div>\n      </div>\n      <div class=\"cell reality\">\n        <div class=\"label r\">REALITY</div>\n        <div class=\"text\">It replaces busywork.</div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"cell myth\">\n        <div class=\"label m\">MYTH</div>\n        <div class=\"text\">Too expensive.</div>\n      </div>\n      <div class=\"cell reality\">\n        <div class=\"label r\">REALITY</div>\n        <div class=\"text\">Manual costs 10x more.</div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"cell myth\">\n        <div class=\"label m\">MYTH</div>\n        <div class=\"text\">Too complex.</div>\n      </div>\n      <div class=\"cell reality\">\n        <div class=\"label r\">REALITY</div>\n        <div class=\"text\">Live in weeks.</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta\">Sound familiar?</div>\n    <div class=\"logo\">accelod</div>\n  </div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', function() {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1080, height: 1350, quality: 1 })\n      .then(function(dataUrl) {\n        const link = document.createElement('a');\n        link.download = 'accelod-myth-vs-reality.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n\n</body>\n</html>",
