 font-family: 'JetBrains Mono', monospace;\n    font-weight: 500;\n    font-size: 20px;\n    background: rgba(0,212,255,0.05);\n  }\n  .badge svg { width: 20px; height: 20px; }\n  .icon-duo {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n  }\n  .boy-wrap {\n    position: relative;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .speech {\n    background: #00D4FF;\n    color: #0B1929;\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 500;\n    font-size: 15px;\n    padding: 8px 14px;\n    border-radius: 14px;\n    position: relative;\n    white-space: nowrap;\n  }\n  .speech::after {\n    content: '';\n    position: absolute;\n    right: -8px;\n    top: 50%;\n    transform: translateY(-50%);\n    border: 8px solid transparent;\n    border-left-color: #00D4FF;\n    border-right: 0;\n  }\n  .boy-svg { width: 60px; height: 60px; }\n  .bot-svg { width: 54px; height: 54px; color: #00D4FF; }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 92px;\n    line-height: 0.98;\n    color: #fff;\n    margin-top: 34px;\n    letter-spacing: -0.02em;\n    position: relative;\n    z-index: 2;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .subtitle {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 400;\n    font-size: 26px;\n    color: rgba(255,255,255,0.7);\n    margin-top: 22px;\n    line-height: 1.35;\n    position: relative;\n    z-index: 2;\n    max-width: 880px;\n  }\n  .panel {\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 18px;\n    margin-top: 34px;\n    padding: 30px;\n    position: relative;\n    z-index: 2;\n    display: flex;\n    flex-direction: column;\n    gap: 18px;\n  }\n  .row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n    align-items: stretch;\n  }\n  .cell {\n    padding: 22px 24px;\n    border-radius: 12px;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .myth {\n    background: rgba(255,80,80,0.06);\n    border: 1px solid rgba(255,90,90,0.25);\n  }\n  .reality {\n    background: rgba(0,212,255,0.08);\n    border: 1px solid rgba(0,212,255,0.35);\n  }\n  .label {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 500;\n    font-size: 18px;\n    letter-spacing: 0.08em;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .label.m { color: #FF6B6B; }\n  .label.r { color: #33E1FF; }\n  .text {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 700;\n    font-size: 30px;\n    color: #fff;\n    line-height: 1.2;\n    letter-spacing: -0.01em;\n  }\n  .footer {\n    margin-top: auto;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    position: relative;\n    z-index: 2;\n    padding-top: 36px;\n  }\n  .cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    padding: 18px 30px;\n    border-radius: 999px;\n    background: rgba(0,212,255,0.1);\n    border: 1.5px solid rgba(0,212,255,0.4);\n    color: #fff;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 500;\n    font-size: 22px;\n  }\n  .cta::before {\n    content: '';\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #00D4FF;\n    box-shadow: 0 0 12px #00D4FF;\n  }\n  .logo {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 36px;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -0.02em;\n  }\n  #export {\n    padding: 14px 28px;\n    background: #00D4FF;\n    color: #0B1929;\n    border: none;\n    border-radius: 8px;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 500;\n    font-size: 16px;\n    cursor: pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <path d=\"M 0,-48 L 3,-8 L 0,0 L -3,-8 Z\"/>\n      <path d=\"M 0,48 L 3,8 L 0,0 L -3,8 Z\"/>\n      <path d=\"M -48,0 L -8,-3 L 0,0 L -8,3 Z\"/>\n      <path d=\"M 48,0 L 8,-3 L 0,0 L 8,3 Z\"/>\n      <g transform=\"rotate(30)\">\n        <path d=\"M 0,-48 L 3,-8 L 0,0 L -3,-8 Z\"/>\n        <path d=\"M 0,48 L 3,8 L 0,0 L -3,8 Z\"/>\n        <path d=\"M -48,0 L -8,-3 L 0,0 L -8,3 Z\"/>\n        <path d=\"M 48,0 L 8,-3 L 0,0 L 8,3 Z\"/>\n      </g>\n      <g transform=\"rotate(60)\">\n        <path d=\"M 0,-48 L 3,-8 L 0,0 L -3,-8 Z\"/>\n        <path d=\"M 0,48 L 3,8 L 0,0 L -3,8 Z\"/>\n        <path d=\"M -48,0 L -8,-3 L 0,0 L -8,3 Z\"/>\n        <path d=\"M 48,0 L 8,-3 L 0,0 L 8,3 Z\"/>\n      </g>\n    </g>\n  </symbol>\n\n  <symbol id=\"boy\" viewBox=\"0 0 100 100\">\n    <!-- hair -->\n    <path d=\"M 28,38 Q 28,20 50,20 Q 72,20 72,38 L 72,44 Q 65,36 50,36 Q 35,36 28,44 Z\" fill=\"#2a1810\"/>\n    <!-- face -->\n    <circle cx=\"50\" cy=\"46\" r=\"18\" fill=\"#F5C79A\"/>\n    <!-- eyes -->\n    <circle cx=\"43\" cy=\"46\" r=\"2\" fill=\"#0B1929\"/>\n    <circle cx=\"57\" cy=\"46\" r=\"2\" fill=\"#0B1929\"/>\n    <!-- smile -->\n    <path d=\"M 44,53 Q 50,58 56,53\" stroke=\"#0B1929\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/>\n    <!-- neck -->\n    <rect x=\"45\" y=\"62\" width=\"10\" height=\"6\" fill=\"#F5C79A\"/>\n    <!-- shirt -->\n    <path d=\"M 30,90 Q 30,70 45,68 L 55,68 Q 70,70 70,90 Z\" fill=\"#00D4FF\"/>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"top-row\">\n    <div class=\"badge\">\n      <svg><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n    <div class=\"icon-duo\">\n      <div class=\"boy-wrap\">\n        <div class=\"speech\">Wait, really?</div>\n        <svg class=\"boy-svg\"><use href=\"#boy\"/></svg>\n      </div>\n      <svg class=\"bot-svg\"><use href=\"#claude-star\"/></svg>\n    </div>\n  </div>\n\n  <h1 class=\"headline\">AI isn't replacing<br>your team.<br><em>Bad systems are.</em></h1>\n\n  <p class=\"subtitle\">4 myths. 4 realities. The truth founders need.</p>\n\n  <div class=\"panel\">\n    <div class=\"row\">\n      <div class=\"cell myth\">\n        <div class=\"label m\">✕ MYTH 01</div>\n        <div class=\"text\">Replaces people.</div>\n      </div>\n      <div class=\"cell reality\">\n        <div class=\"label r\">✓ REALITY</div>\n        <div class=\"text\">Replaces busywork.</div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"cell myth\">\n        <div class=\"label m\">✕ MYTH 02</div>\n        <div class=\"text\">Too expensive.</div>\n      </div>\n      <div class=\"cell reality\">\n        <div class=\"label r\">✓ REALITY</div>\n        <div class=\"text\">Manual costs 10x more.</div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"cell myth\">\n        <div class=\"label m\">✕ MYTH 03</div>\n        <div class=\"text\">Too complex.</div>\n      </div>\n      <div class=\"cell reality\">\n        <div class=\"label r\">✓ REALITY</div>\n        <div class=\"text\">Live in weeks.</div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"cell myth\">\n        <div class=\"label m\">✕ MYTH 04</div>\n        <div class=\"text\">Only for tech.</div>\n      </div>\n      <div class=\"cell reality\">\n        <div class=\"label r\">✓ REALITY</div>\n        <div class=\"text\">Every business wins.</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta\">Sound familiar?</div>\n    <div class=\"logo\">accelod</div>\n  </div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', function() {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1080, height: 1350, quality: 1 })\n      .then(function(dataUrl) {\n        const link = document.createElement('a');\n        link.download = 'accelod-myth-vs-reality.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n\n</body>\n</html>",
