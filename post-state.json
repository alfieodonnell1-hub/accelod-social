  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI - Automated Monday</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    background: #1a1a1a;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 30px;\n    font-family: 'DM Sans', sans-serif;\n    gap: 20px;\n  }\n  #post {\n    width: 1080px;\n    height: 1350px;\n    background: #0B1929;\n    position: relative;\n    overflow: hidden;\n    padding: 80px 70px;\n    display: flex;\n    flex-direction: column;\n  }\n  .dot-grid {\n    position: absolute;\n    inset: 0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 28px 28px;\n    pointer-events: none;\n  }\n  .glow {\n    position: absolute;\n    top: -200px;\n    left: -200px;\n    width: 700px;\n    height: 700px;\n    background: radial-gradient(circle, rgba(0,212,255,0.18) 0%, transparent 65%);\n    pointer-events: none;\n  }\n  .watermark {\n    position: absolute;\n    top: -60px;\n    right: -80px;\n    width: 520px;\n    height: 520px;\n    opacity: 0.05;\n    transform: rotate(12deg);\n    pointer-events: none;\n  }\n  .badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    border: 1.5px solid #00D4FF;\n    border-radius: 100px;\n    padding: 10px 22px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 16px;\n    font-weight: 500;\n    color: #00D4FF;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    align-self: flex-start;\n    position: relative;\n    z-index: 2;\n  }\n  .badge svg { width: 16px; height: 16px; }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 92px;\n    line-height: 0.95;\n    color: #fff;\n    margin-top: 36px;\n    letter-spacing: -0.03em;\n    position: relative;\n    z-index: 2;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .subtitle {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 400;\n    font-size: 24px;\n    color: rgba(255,255,255,0.7);\n    margin-top: 28px;\n    line-height: 1.45;\n    max-width: 900px;\n    position: relative;\n    z-index: 2;\n  }\n  .panel {\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 38px 42px;\n    margin-top: 38px;\n    position: relative;\n    z-index: 2;\n    flex-grow: 1;\n  }\n  .panel-title {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 14px;\n    font-weight: 500;\n    color: rgba(0,212,255,0.7);\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    margin-bottom: 28px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .live-dot {\n    width: 8px; height: 8px;\n    background: #00D4FF;\n    border-radius: 50%;\n    box-shadow: 0 0 12px #00D4FF;\n  }\n  .timeline-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 22px;\n    padding: 20px 0;\n    border-bottom: 1px solid rgba(0,212,255,0.08);\n  }\n  .timeline-item:last-child { border-bottom: none; }\n  .timestamp {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 22px;\n    font-weight: 500;\n    color: #00D4FF;\n    min-width: 110px;\n    padding-top: 4px;\n  }\n  .event-body { flex: 1; }\n  .event-tool {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 28px;\n    color: #fff;\n    line-height: 1.2;\n  }\n  .event-desc {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 20px;\n    color: rgba(255,255,255,0.65);\n    margin-top: 6px;\n    line-height: 1.35;\n  }\n  .result-row {\n    display: flex;\n    gap: 20px;\n    margin-top: 28px;\n    padding-top: 28px;\n    border-top: 1px dashed rgba(0,212,255,0.25);\n  }\n  .stat {\n    flex: 1;\n    background: rgba(0,212,255,0.06);\n    border: 1px solid rgba(0,212,255,0.15);\n    border-radius: 12px;\n    padding: 18px 20px;\n  }\n  .stat-num {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 42px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    line-height: 1;\n  }\n  .stat-label {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 16px;\n    color: rgba(255,255,255,0.6);\n    margin-top: 8px;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n  }\n  .footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-top: 36px;\n    position: relative;\n    z-index: 2;\n  }\n  .cta-pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    color: #0B1929;\n    padding: 18px 32px;\n    border-radius: 100px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 22px;\n  }\n  .logo {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 32px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -0.02em;\n  }\n  #exportBtn {\n    background: #00D4FF;\n    color: #0B1929;\n    border: none;\n    padding: 14px 28px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    border-radius: 100px;\n    cursor: pointer;\n  }\n</style>\n</head>\n<body>\n\n<div id=\"post\">\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\">\n    <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n      <g fill=\"currentColor\">\n        <!-- 12 spokes -->\n        <g>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(30)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(60)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(90)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(120)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(150)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(180)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(210)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(240)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(270)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(300)\"/>\n          <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(330)\"/>\n        </g>\n      </g>\n    </symbol>\n  </svg>\n\n  <div class=\"glow\"></div>\n  <div class=\"dot-grid\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge\">\n    <svg><use href=\"#claude-star\"/></svg>\n    AI Automation\n  </div>\n\n  <h1 class=\"headline\">I Automated<br>My <em>Monday.</em></h1>\n\n  <p class=\"subtitle\">While you were checking emails, my system closed three deals before 9 AM. Here's the exact workflow that ran without me touching a thing.</p>\n\n  <div class=\"panel\">\n    <div class=\"panel-title\"><span class=\"live-dot\"></span>Workflow Replay · Mon 06:00 → 08:47</div>\n\n    <div class=\"timeline-item\">\n      <div class=\"timestamp\">06:12 AM</div>\n      <div class=\"event-body\">\n        <div class=\"event-tool\">Claude drafts proposals</div>\n        <div class=\"event-desc\">3 personalized PDFs generated from CRM signals — tone, pricing, scope dialed in.</div>\n      </div>\n    </div>\n\n    <div class=\"timeline-item\">\n      <div class=\"timestamp\">07:03 AM</div>\n      <div class=\"event-body\">\n        <div class=\"event-tool\">N8N routes leads</div>\n        <div class=\"event-desc\">Hot prospects scored, tagged, and pushed into the right pipeline stage instantly.</div>\n      </div>\n    </div>\n\n    <div class=\"timeline-item\">\n      <div class=\"timestamp\">08:47 AM</div>\n      <div class=\"event-body\">\n        <div class=\"event-tool\">GoHighLevel books calls</div>\n        <div class=\"event-desc\">Calendar fills with qualified discovery calls. Zero back-and-forth, zero manual input.</div>\n      </div>\n    </div>\n\n    <div class=\"result-row\">\n      <div class=\"stat\">\n        <div class=\"stat-num\">3</div>\n        <div class=\"stat-label\">Deals Closed</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"stat-num\">0</div>\n        <div class=\"stat-label\">Manual Clicks</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"stat-num\">9AM</div>\n        <div class=\"stat-label\">Done By</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta-pill\">Sound familiar? →</div>\n    <div class=\"logo\">Accelod<span style=\"color:#33E1FF\">/</span>AI</div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">Export PNG</button>\n\n<script>\n  document.getElementById('exportBtn').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1080, height: 1350, quality: 1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-automated-monday.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>",
