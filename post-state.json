  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI — Client Onboarding Automation</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/dom-to-image-more/3.3.0/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    background: #050d17;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 40px;\n    font-family: 'DM Sans', sans-serif;\n  }\n  #post {\n    width: 1080px;\n    height: 1350px;\n    background: #0B1929;\n    position: relative;\n    overflow: hidden;\n    padding: 80px 70px;\n    display: flex;\n    flex-direction: column;\n  }\n  .dot-grid {\n    position: absolute;\n    inset: 0;\n    background-image: radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size: 28px 28px;\n    z-index: 1;\n  }\n  .glow {\n    position: absolute;\n    top: -200px;\n    left: -200px;\n    width: 700px;\n    height: 700px;\n    background: radial-gradient(circle, rgba(0,212,255,0.18) 0%, rgba(0,212,255,0) 65%);\n    z-index: 1;\n    pointer-events: none;\n  }\n  .watermark {\n    position: absolute;\n    top: 40px;\n    right: -60px;\n    width: 520px;\n    height: 520px;\n    opacity: 0.05;\n    transform: rotate(12deg);\n    z-index: 1;\n  }\n  .content {\n    position: relative;\n    z-index: 3;\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n  }\n  .badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    padding: 12px 22px;\n    border: 1px solid rgba(0,212,255,0.5);\n    border-radius: 999px;\n    color: #00D4FF;\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 500;\n    font-size: 20px;\n    align-self: flex-start;\n    letter-spacing: 0.5px;\n    background: rgba(0,212,255,0.05);\n  }\n  .badge svg { width: 20px; height: 20px; }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 96px;\n    line-height: 0.95;\n    color: #ffffff;\n    margin-top: 34px;\n    letter-spacing: -2px;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .subtitle {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 400;\n    font-size: 24px;\n    line-height: 1.45;\n    color: rgba(255,255,255,0.7);\n    margin-top: 26px;\n    max-width: 880px;\n  }\n  .panel {\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 40px 42px;\n    margin-top: 40px;\n  }\n  .panel-title {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 500;\n    font-size: 15px;\n    color: #00D4FF;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    margin-bottom: 26px;\n  }\n  .stack {\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n  }\n  .stack-row {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n  }\n  .step-num {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 500;\n    font-size: 20px;\n    color: #00D4FF;\n    width: 44px;\n    flex-shrink: 0;\n  }\n  .tool {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 26px;\n    color: #ffffff;\n    min-width: 220px;\n  }\n  .arrow {\n    color: rgba(0,212,255,0.5);\n    font-size: 22px;\n  }\n  .role {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 400;\n    font-size: 22px;\n    color: rgba(255,255,255,0.75);\n  }\n  .stats {\n    display: flex;\n    gap: 24px;\n    margin-top: 28px;\n    padding-top: 28px;\n    border-top: 1px dashed rgba(0,212,255,0.2);\n  }\n  .stat {\n    flex: 1;\n  }\n  .stat-value {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 42px;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    line-height: 1;\n  }\n  .stat-label {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 400;\n    font-size: 14px;\n    color: rgba(255,255,255,0.55);\n    margin-top: 8px;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n  .footer {\n    margin-top: auto;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-top: 40px;\n  }\n  .cta-pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    padding: 18px 32px;\n    background: rgba(0,212,255,0.08);\n    border: 1px solid rgba(0,212,255,0.4);\n    border-radius: 999px;\n    color: #ffffff;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 500;\n    font-size: 22px;\n  }\n  .cta-pill::before {\n    content: '';\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: #00D4FF;\n    box-shadow: 0 0 12px #00D4FF;\n  }\n  .logo {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 34px;\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -1px;\n  }\n  #export {\n    margin-top: 30px;\n    padding: 14px 28px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    border: none;\n    border-radius: 999px;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 500;\n    font-size: 16px;\n    color: #0B1929;\n    cursor: pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <!-- 12 spokes -->\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\"/>\n      <path d=\"M23,-39.8 L4.5,-6.5 L0,-5.5 L1.5,-9.5 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-46 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"content\">\n    <div class=\"badge\">\n      <svg viewBox=\"-50 -50 100 100\"><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n\n    <h1 class=\"headline\">I automated my entire client <em>onboarding</em> in 4 hours.</h1>\n\n    <p class=\"subtitle\">Your onboarding process is leaking money. Here's the exact 4-hour build that fixed mine forever — zero manual work, zero dropped leads.</p>\n\n    <div class=\"panel\">\n      <div class=\"panel-title\">// THE STACK</div>\n      <div class=\"stack\">\n        <div class=\"stack-row\">\n          <div class=\"step-num\">01</div>\n          <div class=\"tool\">GoHighLevel</div>\n          <div class=\"arrow\">→</div>\n          <div class=\"role\">Intake forms & CRM triggers</div>\n        </div>\n        <div class=\"stack-row\">\n          <div class=\"step-num\">02</div>\n          <div class=\"tool\">N8N</div>\n          <div class=\"arrow\">→</div>\n          <div class=\"role\">Workflow logic & routing</div>\n        </div>\n        <div class=\"stack-row\">\n          <div class=\"step-num\">03</div>\n          <div class=\"tool\">Claude</div>\n          <div class=\"arrow\">→</div>\n          <div class=\"role\">Personalised client responses</div>\n        </div>\n        <div class=\"stack-row\">\n          <div class=\"step-num\">04</div>\n          <div class=\"tool\">Google Workspace</div>\n          <div class=\"arrow\">→</div>\n          <div class=\"role\">Auto-generated docs & folders</div>\n        </div>\n      </div>\n\n      <div class=\"stats\">\n        <div class=\"stat\">\n          <div class=\"stat-value\">4 hrs</div>\n          <div class=\"stat-label\">Build time</div>\n        </div>\n        <div class=\"stat\">\n          <div class=\"stat-value\">0</div>\n          <div class=\"stat-label\">Manual steps</div>\n        </div>\n        <div class=\"stat\">\n          <div class=\"stat-value\">100%</div>\n          <div class=\"stat-label\">Hands-off</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"footer\">\n      <div class=\"cta-pill\">Doing this manually?</div>\n      <div class=\"logo\">Accelod</div>\n    </div>\n  </div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', function() {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1080, height: 1350, quality: 1 })\n      .then(function (dataUrl) {\n        const link = document.createElement('a');\n        link.download = 'accelod-onboarding-automation.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n\n</body>\n</html>",
