  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI — 3AM Email</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  body{background:#1a1a1a;display:flex;flex-direction:column;align-items:center;padding:30px;font-family:'DM Sans',sans-serif;gap:20px}\n  #post{\n    width:1080px;height:1350px;\n    background:#0B1929;\n    position:relative;\n    overflow:hidden;\n    padding:80px 70px;\n    display:flex;flex-direction:column;\n  }\n  .dot-grid{\n    position:absolute;inset:0;\n    background-image:radial-gradient(circle, rgba(0,212,255,0.08) 1px, transparent 1px);\n    background-size:28px 28px;\n    pointer-events:none;\n  }\n  .glow{\n    position:absolute;\n    top:-200px;left:-200px;\n    width:700px;height:700px;\n    background:radial-gradient(circle, rgba(0,212,255,0.18) 0%, transparent 70%);\n    pointer-events:none;\n  }\n  .watermark{\n    position:absolute;\n    top:-80px;right:-80px;\n    width:520px;height:520px;\n    opacity:0.05;\n    transform:rotate(12deg);\n    pointer-events:none;\n  }\n  .content{position:relative;z-index:2;display:flex;flex-direction:column;height:100%;}\n  .badge{\n    display:inline-flex;align-items:center;gap:10px;\n    border:1.5px solid #00D4FF;\n    border-radius:999px;\n    padding:12px 22px;\n    font-family:'JetBrains Mono',monospace;\n    font-weight:500;\n    font-size:20px;\n    color:#00D4FF;\n    align-self:flex-start;\n    background:rgba(0,212,255,0.05);\n  }\n  .badge svg{width:20px;height:20px}\n  .headline{\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:88px;\n    line-height:0.98;\n    color:#fff;\n    margin-top:30px;\n    letter-spacing:-0.02em;\n  }\n  .headline em{\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF 0%,#33E1FF 100%);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle{\n    font-family:'DM Sans',sans-serif;\n    font-weight:400;\n    font-size:24px;\n    color:rgba(255,255,255,0.65);\n    margin-top:24px;\n    line-height:1.4;\n    max-width:880px;\n  }\n  .panel{\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:38px 40px;\n    margin-top:38px;\n  }\n  .panel-title{\n    font-family:'JetBrains Mono',monospace;\n    font-size:14px;\n    font-weight:500;\n    color:#00D4FF;\n    letter-spacing:0.15em;\n    text-transform:uppercase;\n    margin-bottom:24px;\n  }\n  .flow{display:flex;flex-direction:column;gap:18px}\n  .step{\n    display:flex;align-items:center;gap:18px;\n    font-family:'DM Sans',sans-serif;\n    font-size:22px;\n    color:#fff;\n  }\n  .step-num{\n    width:42px;height:42px;\n    border-radius:10px;\n    background:rgba(0,212,255,0.12);\n    border:1px solid rgba(0,212,255,0.3);\n    display:flex;align-items:center;justify-content:center;\n    font-family:'JetBrains Mono',monospace;\n    font-weight:500;\n    font-size:18px;\n    color:#33E1FF;\n    flex-shrink:0;\n  }\n  .step strong{color:#33E1FF;font-weight:500}\n  .stats{\n    display:flex;gap:30px;\n    margin-top:30px;\n    padding-top:30px;\n    border-top:1px solid rgba(0,212,255,0.15);\n  }\n  .stat-label{\n    font-family:'JetBrains Mono',monospace;\n    font-size:13px;\n    color:rgba(255,255,255,0.5);\n    letter-spacing:0.1em;\n    text-transform:uppercase;\n    margin-bottom:8px;\n  }\n  .stat-value{\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:38px;\n    color:#fff;\n  }\n  .stat-value em{\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .footer{\n    margin-top:auto;\n    display:flex;align-items:center;justify-content:space-between;\n  }\n  .cta-pill{\n    display:inline-flex;align-items:center;gap:12px;\n    background:rgba(0,212,255,0.1);\n    border:1.5px solid rgba(0,212,255,0.4);\n    border-radius:999px;\n    padding:18px 32px;\n    font-family:'DM Sans',sans-serif;\n    font-weight:500;\n    font-size:22px;\n    color:#fff;\n  }\n  .cta-pill::before{\n    content:'';\n    width:10px;height:10px;border-radius:50%;\n    background:#00D4FF;\n    box-shadow:0 0 12px #00D4FF;\n  }\n  .logo{\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:32px;\n    background:linear-gradient(135deg,#00D4FF 0%,#33E1FF 100%);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    letter-spacing:-0.02em;\n  }\n  #exportBtn{\n    padding:14px 28px;background:#00D4FF;color:#0B1929;\n    border:none;border-radius:8px;font-weight:700;cursor:pointer;\n    font-family:'DM Sans',sans-serif;font-size:16px;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <!-- 12 spokes -->\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L3,-8 L0,0 L-3,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"content\">\n    <div class=\"badge\">\n      <svg><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n\n    <h1 class=\"headline\">While you slept,<br>this workflow closed <em>$12K</em>.</h1>\n\n    <p class=\"subtitle\">3AM. Lead hits the inbox. N8N + Claude + GoHighLevel do the rest — qualify, reply, book. Here's exactly how it's wired.</p>\n\n    <div class=\"panel\">\n      <div class=\"panel-title\">// The Stack — 4 Steps</div>\n      <div class=\"flow\">\n        <div class=\"step\"><div class=\"step-num\">01</div>Lead form fires → <strong>N8N webhook</strong> catches it</div>\n        <div class=\"step\"><div class=\"step-num\">02</div><strong>Claude</strong> qualifies + drafts a personalised reply</div>\n        <div class=\"step\"><div class=\"step-num\">03</div><strong>GoHighLevel</strong> sends the email + opens calendar slot</div>\n        <div class=\"step\"><div class=\"step-num\">04</div>Call booked → SMS confirmation → CRM updated</div>\n      </div>\n\n      <div class=\"stats\">\n        <div>\n          <div class=\"stat-label\">Owner Effort</div>\n          <div class=\"stat-value\"><em>0 min</em></div>\n        </div>\n        <div>\n          <div class=\"stat-label\">Reply Time</div>\n          <div class=\"stat-value\"><em>&lt;90s</em></div>\n        </div>\n        <div>\n          <div class=\"stat-label\">Deal Closed</div>\n          <div class=\"stat-value\"><em>$12K</em></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"footer\">\n      <div class=\"cta-pill\">Still replying manually?</div>\n      <div class=\"logo\">accelod</div>\n    </div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">Export PNG</button>\n\n<script>\ndocument.getElementById('exportBtn').addEventListener('click', () => {\n  const node = document.getElementById('post');\n  domtoimage.toPng(node, {width:1080, height:1350, quality:1})\n    .then(dataUrl => {\n      const link = document.createElement('a');\n      link.download = 'accelod-3am-deal.png';\n      link.href = dataUrl;\n      link.click();\n    });\n});\n</script>\n</body>\n</html>",
  "fb_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI — 3AM Email</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    background: #1a1a1a;\n    font-family: 'DM Sans', sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 30px;\n    gap: 20px;\n    min-height: 100vh;\n  }\n  #post {\n    width: 1200px;\n    height: 630px;\n    background: #0B1929;\n    position: relative;\n    overflow: hidden;\n    display: flex;\n    color: #fff;\n  }\n  .dot-grid {\n    position: absolute;\n    inset: 0;\n    background-image: radial-gradient(rgba(0,212,255,0.12) 1px, transparent 1px);\n    background-size: 22px 22px;\n    pointer-events: none;\n  }\n  .glow {\n    position: absolute;\n    top: -180px;\n    left: -180px;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(0,212,255,0.25) 0%, rgba(0,212,255,0) 65%);\n    pointer-events: none;\n  }\n  .watermark {\n    position: absolute;\n    top: -80px;\n    right: -80px;\n    width: 420px;\n    height: 420px;\n    opacity: 0.05;\n    transform: rotate(12deg);\n    pointer-events: none;\n  }\n  .left {\n    width: 360px;\n    padding: 50px 36px;\n    display: flex;\n    flex-direction: column;\n    position: relative;\n    z-index: 2;\n  }\n  .badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    border: 1px solid #00D4FF;\n    border-radius: 999px;\n    padding: 7px 14px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 12px;\n    font-weight: 500;\n    color: #00D4FF;\n    text-transform: uppercase;\n    letter-spacing: 1.5px;\n    align-self: flex-start;\n    margin-bottom: 26px;\n  }\n  .badge svg { width: 14px; height: 14px; }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 58px;\n    line-height: 0.98;\n    letter-spacing: -2px;\n    color: #fff;\n    margin-bottom: 18px;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .subtitle {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 20px;\n    font-weight: 400;\n    line-height: 1.4;\n    color: rgba(255,255,255,0.75);\n    margin-bottom: 28px;\n  }\n  .cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: rgba(0,212,255,0.1);\n    border: 1px solid rgba(0,212,255,0.4);\n    border-radius: 999px;\n    padding: 11px 20px;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 500;\n    font-size: 16px;\n    color: #33E1FF;\n    align-self: flex-start;\n  }\n  .logo {\n    position: absolute;\n    bottom: 32px;\n    left: 36px;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 26px;\n    letter-spacing: -1px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    opacity: 1;\n  }\n  .right {\n    flex: 1;\n    padding: 50px 50px 50px 10px;\n    display: flex;\n    align-items: center;\n    position: relative;\n    z-index: 2;\n  }\n  .panel {\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 36px 38px;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n  .panel-title {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    color: #00D4FF;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    margin-bottom: 22px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .panel-title::before {\n    content: '';\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #00D4FF;\n    box-shadow: 0 0 12px #00D4FF;\n  }\n  .stat {\n    display: flex;\n    align-items: flex-start;\n    gap: 18px;\n    padding: 14px 0;\n    border-bottom: 1px solid rgba(0,212,255,0.08);\n  }\n  .stat:last-child { border-bottom: none; }\n  .stat-icon {\n    width: 38px;\n    height: 38px;\n    border-radius: 10px;\n    background: rgba(0,212,255,0.12);\n    border: 1px solid rgba(0,212,255,0.3);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 14px;\n    color: #33E1FF;\n    font-weight: 500;\n  }\n  .stat-text {\n    flex: 1;\n  }\n  .stat-value {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 26px;\n    color: #fff;\n    line-height: 1.1;\n    margin-bottom: 4px;\n  }\n  .stat-value span {\n    color: #33E1FF;\n  }\n  .stat-desc {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 15px;\n    color: rgba(255,255,255,0.6);\n    line-height: 1.35;\n  }\n  #export {\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    border: none;\n    color: #0B1929;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 15px;\n    padding: 12px 28px;\n    border-radius: 999px;\n    cursor: pointer;\n    letter-spacing: 0.5px;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <!-- 12 spokes -->\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"3\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"3\" transform=\"rotate(30)\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"3\" transform=\"rotate(60)\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"3\" transform=\"rotate(90)\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"3\" transform=\"rotate(120)\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"3\" transform=\"rotate(150)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <svg style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n    <h1 class=\"headline\">The 3AM email that closed <em>$12K</em></h1>\n    <p class=\"subtitle\">While you were sleeping, this workflow made me $12K. Here's exactly how it's built.</p>\n    <div class=\"cta\">Sound familiar?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-title\">Workflow Breakdown · N8N + Claude + GHL</div>\n\n      <div class=\"stat\">\n        <div class=\"stat-icon\">01</div>\n        <div class=\"stat-text\">\n          <div class=\"stat-value\">$12,000 <span>closed at 3:47AM</span></div>\n          <div class=\"stat-desc\">Lead arrived via form → qualified → replied → booked. Zero human touch.</div>\n        </div>\n      </div>\n\n      <div class=\"stat\">\n        <div class=\"stat-icon\">02</div>\n        <div class=\"stat-text\">\n          <div class=\"stat-value\">90 sec <span>response time</span></div>\n          <div class=\"stat-desc\">Claude AI drafts personalised replies referencing the lead's exact pain points.</div>\n        </div>\n      </div>\n\n      <div class=\"stat\">\n        <div class=\"stat-icon\">03</div>\n        <div class=\"stat-text\">\n          <div class=\"stat-value\">7-point <span>lead scoring</span></div>\n          <div class=\"stat-desc\">N8N filters tyre-kickers before they ever touch your calendar.</div>\n        </div>\n      </div>\n\n      <div class=\"stat\">\n        <div class=\"stat-icon\">04</div>\n        <div class=\"stat-text\">\n          <div class=\"stat-value\">Auto-booked <span>into GoHighLevel</span></div>\n          <div class=\"stat-desc\">Qualified leads land on your calendar with full context attached.</div>\n        </div>\n      </div>\n\n      <div class=\"stat\">\n        <div class=\"stat-icon\">05</div>\n        <div class=\"stat-text\">\n          <div class=\"stat-value\">24/7 <span>silent sales rep</span></div>\n          <div class=\"stat-desc\">Runs while you sleep, eat, train — never sick, never off.</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', function() {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1200, height: 630, quality: 1, bgcolor: '#0B1929' })\n      .then(function(dataUrl) {\n        const link = document.createElement('a');\n        link.download = 'accelod-3am-email.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n\n</body>\n</html>",
