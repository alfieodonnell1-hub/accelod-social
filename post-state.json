03em;\n    color:#fff;\n    margin-bottom:18px;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-size:15px;\n    color:rgba(255,255,255,0.65);\n    line-height:1.45;\n    margin-bottom:24px;\n  }\n  .cta {\n    display:inline-flex; align-items:center; gap:8px;\n    padding:12px 20px;\n    background:rgba(0,212,255,0.1);\n    border:1px solid rgba(0,212,255,0.4);\n    border-radius:100px;\n    color:#00D4FF;\n    font-family:'JetBrains Mono',monospace;\n    font-size:14px;\n    width:fit-content;\n    margin-bottom:auto;\n  }\n  .logo {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:24px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    letter-spacing:-0.02em;\n  }\n  .right {\n    flex:1;\n    padding:32px 32px 32px 8px;\n    position:relative; z-index:2;\n    display:flex; flex-direction:column;\n  }\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:24px;\n    flex:1;\n    display:flex; flex-direction:column;\n    gap:12px;\n  }\n  .panel-title {\n    font-family:'JetBrains Mono',monospace;\n    font-size:12px;\n    color:rgba(255,255,255,0.5);\n    text-transform:uppercase;\n    letter-spacing:0.1em;\n    margin-bottom:4px;\n  }\n  .stat-row {\n    display:flex; align-items:center; gap:16px;\n    padding:14px 16px;\n    background:rgba(239,68,68,0.08);\n    border-left:3px solid #EF4444;\n    border-radius:8px;\n  }\n  .stat-row.good {\n    background:rgba(0,212,255,0.08);\n    border-left-color:#00D4FF;\n  }\n  .stat-num {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:42px;\n    line-height:1;\n    color:#EF4444;\n    min-width:110px;\n  }\n  .stat-num.cyan {\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .stat-label {\n    font-size:15px;\n    color:rgba(255,255,255,0.85);\n    line-height:1.3;\n  }\n  .stat-label b { color:#fff; font-weight:700; }\n  .divider {\n    display:flex; align-items:center; gap:12px;\n    margin:4px 0;\n  }\n  .divider-line {\n    flex:1; height:1px;\n    background:linear-gradient(90deg,transparent,rgba(0,212,255,0.4),transparent);\n  }\n  .divider-label {\n    font-family:'JetBrains Mono',monospace;\n    font-size:12px;\n    color:#00D4FF;\n    letter-spacing:0.1em;\n  }\n  .stack-row {\n    display:flex; align-items:center; gap:12px;\n    padding:10px 14px;\n    background:rgba(255,255,255,0.03);\n    border-radius:8px;\n  }\n  .stack-row img, .stack-row svg { width:28px; height:28px; object-fit:contain; flex-shrink:0; }\n  .stack-name {\n    font-family:'JetBrains Mono',monospace;\n    font-size:13px;\n    color:#fff;\n    font-weight:500;\n  }\n  .stack-desc {\n    font-size:13px;\n    color:rgba(255,255,255,0.55);\n    margin-left:auto;\n  }\n  .stack-grid {\n    display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px;\n  }\n  #export {\n    padding:12px 24px;\n    background:#00D4FF; color:#0B1929;\n    border:none; border-radius:8px;\n    font-family:'JetBrains Mono',monospace;\n    font-weight:500; cursor:pointer;\n    font-size:14px;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\"/>\n      <rect x=\"0\" y=\"48\" width=\"100\" height=\"4\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(45 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(15 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(75 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(105 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(135 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(150 50 50)\"/>\n      <rect x=\"48\" y=\"0\" width=\"4\" height=\"100\" transform=\"rotate(165 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <svg viewBox=\"0 0 100 100\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n    <div class=\"headline\">6 months.<br>£4,200.<br>Broke every <em>Tuesday.</em></div>\n    <div class=\"subtitle\">A real client's DIY Zapier + spreadsheet + ChatGPT stack — and what replaced it in 9 days.</div>\n    <div class=\"cta\">💭 Sound familiar?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n\n      <div class=\"panel-title\">❌ The DIY duct-tape stack</div>\n\n      <div class=\"stat-row\">\n        <div class=\"stat-num\">47</div>\n        <div class=\"stat-label\"><b>Zaps chained together</b><br>Each one a single point of failure</div>\n      </div>\n\n      <div class=\"stat-row\">\n        <div class=\"stat-num\">£350</div>\n        <div class=\"stat-label\"><b>Monthly SaaS bill</b><br>Zapier + Sheets addons + ChatGPT Plus × 3</div>\n      </div>\n\n      <div class=\"stat-row\">\n        <div class=\"stat-num\">9hrs</div>\n        <div class=\"stat-label\"><b>Lost every Tuesday</b><br>Manually fixing what the automation broke</div>\n      </div>\n\n      <div class=\"divider\">\n        <div class=\"divider-line\"></div>\n        <div class=\"divider-label\">✓ REPLACED WITH</div>\n        <div class=\"divider-line\"></div>\n      </div>\n\n      <div class=\"stack-grid\">\n        <div class=\"stack-row\">\n          <img src=\"https://cdn.simpleicons.org/n8n/EA4B71\" alt=\"n8n\">\n          <span class=\"stack-name\">N8N</span>\n        </div>\n        <div class=\"stack-row\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>\n          <span class=\"stack-name\">GoHighLevel</span>\n        </div>\n        <div class=\"stack-row\">\n          <img src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\">\n          <span class=\"stack-name\">Claude</span>\n        </div>\n      </div>\n\n      <div class=\"stat-row good\">\n        <div class=\"stat-num cyan\">0</div>\n        <div class=\"stat-label\"><b>Tuesday breakdowns since.</b><br>Cheap automation is the most expensive kind.</div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1200, height:630, quality:1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-diy-automation.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>"
