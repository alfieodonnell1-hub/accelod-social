transparent; background-clip:text; }\n\n  .subtitle { font-size:16px; color:rgba(255,255,255,0.6); line-height:1.5; margin-bottom:22px; }\n\n  .spacer { flex:1; }\n\n  .cta { display:inline-flex; align-items:center; gap:10px; padding:14px 22px; background:rgba(0,212,255,0.1); border:1.5px solid #00D4FF; border-radius:100px; font-family:'Outfit',sans-serif; font-weight:700; font-size:16px; color:#fff; width:fit-content; margin-bottom:16px; }\n  .cta-dot { width:9px; height:9px; border-radius:50%; background:#00D4FF; box-shadow:0 0 10px #00D4FF; }\n\n  .footer-row { display:flex; justify-content:flex-end; align-items:center; }\n  .logo { font-family:'Outfit',sans-serif; font-weight:900; font-size:26px; letter-spacing:-0.02em; background:linear-gradient(135deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }\n\n  .right { flex:1; padding:28px 32px 28px 8px; position:relative; z-index:2; display:flex; flex-direction:column; }\n  .panel { background:#06101A; border:1px solid rgba(0,212,255,0.2); border-radius:16px; padding:20px; flex:1; display:flex; flex-direction:column; gap:14px; }\n\n  .panel-header { display:flex; align-items:center; justify-content:space-between; }\n  .panel-title { font-family:'JetBrains Mono',monospace; font-size:18px; color:rgba(255,255,255,0.55); text-transform:uppercase; letter-spacing:0.08em; }\n  .panel-tag { font-family:'JetBrains Mono',monospace; font-size:18px; color:#00D4FF; }\n\n  .compare { display:grid; grid-template-columns:1fr 1fr; gap:12px; }\n  .col { border-radius:10px; padding:14px 14px 12px; }\n  .col.bad { background:rgba(239,68,68,0.07); border-left:3px solid #EF4444; }\n  .col.good { background:rgba(0,212,255,0.07); border-left:3px solid #00D4FF; }\n  .col-title { font-family:'JetBrains Mono',monospace; font-size:18px; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:10px; font-weight:500; }\n  .col.bad .col-title { color:#EF4444; }\n  .col.good .col-title { color:#00D4FF; }\n\n  .chip-cloud { display:flex; flex-wrap:wrap; gap:5px; }\n  .chip { font-family:'JetBrains Mono',monospace; font-size:11px; padding:4px 8px; background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.25); border-radius:4px; color:rgba(255,255,255,0.7); }\n  .chip-count { font-family:'Outfit',sans-serif; font-weight:900; font-size:22px; color:#EF4444; margin-top:8px; display:block; }\n\n  .tool-row { display:flex; align-items:center; gap:10px; padding:6px 0; }\n  .tool-row img, .tool-row svg.tlogo { width:26px; height:26px; object-fit:contain; flex-shrink:0; }\n  .tool-name { font-size:15px; font-weight:700; color:#fff; }\n\n  .stat-strip { display:flex; align-items:center; justify-content:space-between; background:rgba(0,212,255,0.06); border:1px solid rgba(0,212,255,0.22); border-radius:10px; padding:14px 18px; }\n  .stat-left { display:flex; align-items:baseline; gap:12px; }\n  .stat-num { font-family:'Outfit',sans-serif; font-weight:900; font-size:48px; background:linear-gradient(90deg,#00D4FF,#33E1FF); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; line-height:1; }\n  .stat-label { font-family:'JetBrains Mono',monospace; font-size:18px; color:rgba(255,255,255,0.6); text-transform:uppercase; letter-spacing:0.06em; }\n  .stat-right { font-family:'JetBrains Mono',monospace; font-size:18px; color:#22C55E; }\n\n  button { margin-top:12px; padding:10px 20px; background:#00D4FF; color:#0B1929; border:none; border-radius:6px; cursor:pointer; font-weight:700; }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"5\" width=\"4\" height=\"90\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\"><svg width=\"13\" height=\"13\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>AI Automation · Myth</div>\n\n    <h1 class=\"headline\">You don't need <em>47 tools.</em></h1>\n    <p class=\"subtitle\">You need one thing: a brain that connects them. Tool count is vanity — integration is the whole game.</p>\n\n    <div class=\"spacer\"></div>\n\n    <div class=\"cta\"><span class=\"cta-dot\"></span>Sound familiar?</div>\n    <div class=\"footer-row\">\n      <div class=\"logo\">Accelod AI</div>\n    </div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-header\">\n        <div class=\"panel-title\">// The Tool Stack Lie</div>\n        <div class=\"panel-tag\">Bust ⚡</div>\n      </div>\n\n      <div class=\"compare\">\n        <div class=\"col bad\">\n          <div class=\"col-title\">✗ Their Stack</div>\n          <div class=\"chip-cloud\">\n            <span class=\"chip\">Zapier</span><span class=\"chip\">Make</span><span class=\"chip\">Airtable</span>\n            <span class=\"chip\">Notion</span><span class=\"chip\">Slack</span><span class=\"chip\">Trello</span>\n            <span class=\"chip\">HubSpot</span><span class=\"chip\">Calendly</span><span class=\"chip\">Typeform</span>\n            <span class=\"chip\">Loom</span><span class=\"chip\">Pipedrive</span><span class=\"chip\">Intercom</span>\n            <span class=\"chip\">Mailchimp</span><span class=\"chip\">ClickUp</span><span class=\"chip\">+more</span>\n          </div>\n          <span class=\"chip-count\">15+ apps · 0 sync</span>\n        </div>\n        <div class=\"col good\">\n          <div class=\"col-title\">✓ Our Stack</div>\n          <div class=\"tool-row\">\n            <img src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\">\n            <span class=\"tool-name\">Claude — the brain</span>\n          </div>\n          <div class=\"tool-row\">\n            <img src=\"https://cdn.simpleicons.org/n8n/EA4B71\" alt=\"n8n\">\n            <span class=\"tool-name\">N8N — the wiring</span>\n          </div>\n          <div class=\"tool-row\">\n            <svg class=\"tlogo\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>\n            <span class=\"tool-name\">GoHighLevel — the CRM</span>\n          </div>\n          <div class=\"tool-row\">\n            <img src=\"https://cdn.simpleicons.org/google\" alt=\"Google\">\n            <span class=\"tool-name\">Google — the workspace</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"stat-strip\">\n        <div class=\"stat-left\">\n          <span class=\"stat-num\">4</span>\n          <span class=\"stat-label\">tools · fully integrated</span>\n        </div>\n        <span class=\"stat-right\">→ replaces 15+</span>\n      </div>\n    </div>\n  </div>\n</div>\n<button id=\"exportBtn\">Export PNG</button>\n<script>\n  document.getElementById('exportBtn').addEventListener('click', () => {\n    domtoimage.toPng(document.getElementById('post'), { width: 1200, height: 630, quality: 1 })\n      .then(dataUrl => { const link = document.createElement('a'); link.download = 'accelod-tool-stack-lie.png'; link.href = dataUrl; link.click(); });\n  });\n</script>\n</body>\n</html>"
}