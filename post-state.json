  "ig_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI — Fire Yourself First</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/dom-to-image-more/3.3.0/dom-to-image-more.min.js\"></script>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body {\n    background:#040B14;\n    min-height:100vh;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    padding:40px 20px;\n    font-family:'DM Sans', sans-serif;\n  }\n  #post {\n    width:1080px;\n    height:1350px;\n    background:#0B1929;\n    background-image:\n      radial-gradient(circle at 15% 15%, rgba(0,212,255,0.18) 0%, transparent 45%),\n      radial-gradient(rgba(0,212,255,0.08) 1.2px, transparent 1.2px);\n    background-size: auto, 28px 28px;\n    background-position: 0 0, 0 0;\n    position:relative;\n    overflow:hidden;\n    padding:72px 70px;\n    display:flex;\n    flex-direction:column;\n  }\n  .watermark {\n    position:absolute;\n    top:-120px;\n    right:-120px;\n    width:680px;\n    height:680px;\n    opacity:0.05;\n    transform:rotate(12deg);\n    pointer-events:none;\n  }\n  .badge {\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    border:1.5px solid rgba(0,212,255,0.5);\n    color:#00D4FF;\n    padding:12px 22px;\n    border-radius:999px;\n    font-family:'JetBrains Mono', monospace;\n    font-weight:500;\n    font-size:18px;\n    letter-spacing:0.08em;\n    text-transform:uppercase;\n    width:fit-content;\n    background:rgba(0,212,255,0.05);\n  }\n  .badge svg { width:18px; height:18px; fill:#00D4FF; }\n  .headline {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:88px;\n    line-height:0.96;\n    color:#FFFFFF;\n    letter-spacing:-0.03em;\n    margin-top:30px;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n  }\n  .subtitle {\n    font-family:'DM Sans', sans-serif;\n    font-weight:400;\n    font-size:24px;\n    line-height:1.45;\n    color:#9BB0C4;\n    margin-top:24px;\n    max-width:900px;\n  }\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:30px 40px;\n    margin-top:28px;\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    justify-content:space-between;\n  }\n  .row {\n    display:flex;\n    align-items:center;\n    gap:22px;\n    padding:12px 0;\n    border-bottom:1px dashed rgba(0,212,255,0.12);\n  }\n  .row:last-child { border-bottom:none; }\n  .num {\n    font-family:'JetBrains Mono', monospace;\n    font-weight:500;\n    font-size:24px;\n    color:#00D4FF;\n    min-width:48px;\n  }\n  .task-block { flex:1; }\n  .task {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:34px;\n    color:#FFFFFF;\n    line-height:1.15;\n    letter-spacing:-0.01em;\n    text-shadow:0 2px 18px rgba(0,212,255,0.18);\n  }\n  .replace {\n    font-family:'DM Sans', sans-serif;\n    font-weight:500;\n    font-size:22px;\n    color:#B7CADE;\n    margin-top:8px;\n    display:flex;\n    align-items:center;\n    flex-wrap:wrap;\n    gap:6px;\n  }\n  .replace .arrow-txt {\n    color:#00D4FF;\n    font-family:'JetBrains Mono', monospace;\n    font-weight:700;\n    margin:0 4px;\n  }\n  .platform {\n    display:inline-flex;\n    align-items:center;\n    gap:8px;\n    background:rgba(0,212,255,0.10);\n    border:1px solid rgba(0,212,255,0.35);\n    padding:4px 12px 4px 8px;\n    border-radius:999px;\n    color:#33E1FF;\n    font-family:'JetBrains Mono', monospace;\n    font-weight:700;\n    font-size:20px;\n    box-shadow:0 0 14px rgba(0,212,255,0.15);\n  }\n  .platform svg {\n    width:22px;\n    height:22px;\n    display:block;\n  }\n  .footer-row {\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    margin-top:28px;\n  }\n  .cta-pill {\n    display:inline-flex;\n    align-items:center;\n    gap:12px;\n    background:linear-gradient(135deg, rgba(0,212,255,0.15), rgba(51,225,255,0.08));\n    border:1.5px solid #00D4FF;\n    color:#FFFFFF;\n    padding:18px 30px;\n    border-radius:999px;\n    font-family:'Outfit', sans-serif;\n    font-weight:700;\n    font-size:24px;\n  }\n  .cta-pill::before {\n    content:\"\";\n    width:10px; height:10px;\n    background:#00D4FF;\n    border-radius:50%;\n    box-shadow:0 0 12px #00D4FF;\n  }\n  .logo {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:32px;\n    letter-spacing:-0.02em;\n    background:linear-gradient(135deg,#00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    opacity:1;\n  }\n  #exportBtn {\n    margin-top:24px;\n    padding:14px 28px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    color:#0B1929;\n    border:none;\n    border-radius:999px;\n    font-family:'Outfit', sans-serif;\n    font-weight:700;\n    font-size:16px;\n    cursor:pointer;\n    letter-spacing:0.05em;\n  }\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g>\n      <g id=\"spokes\">\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(15)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(30)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(45)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(60)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(75)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(90)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(105)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(120)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(135)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(150)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"3\" transform=\"rotate(165)\"/>\n      </g>\n    </g>\n  </symbol>\n\n  <!-- Platform icons -->\n  <symbol id=\"icon-ghl\" viewBox=\"0 0 24 24\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"#33E1FF\" opacity=\"0.18\"/>\n    <path d=\"M12 5 L18 9 V15 L12 19 L6 15 V9 Z\" fill=\"none\" stroke=\"#33E1FF\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n    <circle cx=\"12\" cy=\"12\" r=\"2.4\" fill=\"#33E1FF\"/>\n  </symbol>\n  <symbol id=\"icon-claude\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"#33E1FF\">\n      <rect x=\"-3\" y=\"-44\" width=\"6\" height=\"88\" rx=\"3\"/>\n      <rect x=\"-3\" y=\"-44\" width=\"6\" height=\"88\" rx=\"3\" transform=\"rotate(30)\"/>\n      <rect x=\"-3\" y=\"-44\" width=\"6\" height=\"88\" rx=\"3\" transform=\"rotate(60)\"/>\n      <rect x=\"-3\" y=\"-44\" width=\"6\" height=\"88\" rx=\"3\" transform=\"rotate(90)\"/>\n      <rect x=\"-3\" y=\"-44\" width=\"6\" height=\"88\" rx=\"3\" transform=\"rotate(120)\"/>\n      <rect x=\"-3\" y=\"-44\" width=\"6\" height=\"88\" rx=\"3\" transform=\"rotate(150)\"/>\n    </g>\n  </symbol>\n  <symbol id=\"icon-n8n\" viewBox=\"0 0 24 24\">\n    <circle cx=\"5\" cy=\"12\" r=\"2.6\" fill=\"#33E1FF\"/>\n    <circle cx=\"12\" cy=\"7\" r=\"2.6\" fill=\"none\" stroke=\"#33E1FF\" stroke-width=\"1.8\"/>\n    <circle cx=\"12\" cy=\"17\" r=\"2.6\" fill=\"none\" stroke=\"#33E1FF\" stroke-width=\"1.8\"/>\n    <circle cx=\"19\" cy=\"12\" r=\"2.6\" fill=\"#33E1FF\"/>\n    <path d=\"M7.4 11 L9.6 8 M7.4 13 L9.6 16 M14.4 8 L16.6 11 M14.4 16 L16.6 13\" stroke=\"#33E1FF\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n  </symbol>\n  <symbol id=\"icon-calendar\" viewBox=\"0 0 24 24\">\n    <rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15\" rx=\"2.2\" fill=\"none\" stroke=\"#33E1FF\" stroke-width=\"1.8\"/>\n    <path d=\"M3.5 10 H20.5\" stroke=\"#33E1FF\" stroke-width=\"1.8\"/>\n    <rect x=\"7\" y=\"3\" width=\"2\" height=\"4\" rx=\"1\" fill=\"#33E1FF\"/>\n    <rect x=\"15\" y=\"3\" width=\"2\" height=\"4\" rx=\"1\" fill=\"#33E1FF\"/>\n    <circle cx=\"8.5\" cy=\"14\" r=\"1.2\" fill=\"#33E1FF\"/>\n    <circle cx=\"12\" cy=\"14\" r=\"1.2\" fill=\"#33E1FF\"/>\n    <circle cx=\"15.5\" cy=\"14\" r=\"1.2\" fill=\"#33E1FF\"/>\n  </symbol>\n  <symbol id=\"icon-stack\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 3 L21 7.5 L12 12 L3 7.5 Z\" fill=\"none\" stroke=\"#33E1FF\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n    <path d=\"M3 12 L12 16.5 L21 12\" fill=\"none\" stroke=\"#33E1FF\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n    <path d=\"M3 16.5 L12 21 L21 16.5\" fill=\"none\" stroke=\"#33E1FF\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge\">\n    <svg><use href=\"#claude-star\"/></svg>\n    AI Automation\n  </div>\n\n  <h1 class=\"headline\">Fire <em>Yourself</em><br>First.</h1>\n\n  <p class=\"subtitle\">If you're still doing these 5 things in your business, you're the bottleneck. Not the market.</p>\n\n  <div class=\"panel\">\n    <div class=\"row\">\n      <div class=\"num\">01</div>\n      <div class=\"task-block\">\n        <div class=\"task\">Chasing leads manually</div>\n        <div class=\"replace\">Replace with <span class=\"arrow-txt\">→</span>\n          <span class=\"platform\"><svg><use href=\"#icon-ghl\"/></svg>GoHighLevel</span>\n          follow-up sequences\n        </div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"num\">02</div>\n      <div class=\"task-block\">\n        <div class=\"task\">Writing every caption + email</div>\n        <div class=\"replace\">Replace with <span class=\"arrow-txt\">→</span>\n          <span class=\"platform\"><svg><use href=\"#icon-claude\"/></svg>Claude</span>\n          content engine\n        </div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"num\">03</div>\n      <div class=\"task-block\">\n        <div class=\"task\">Copy-pasting between tools</div>\n        <div class=\"replace\">Replace with <span class=\"arrow-txt\">→</span>\n          <span class=\"platform\"><svg><use href=\"#icon-n8n\"/></svg>N8N</span>\n          workflow glue\n        </div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"num\">04</div>\n      <div class=\"task-block\">\n        <div class=\"task\">Booking + reminding clients</div>\n        <div class=\"replace\">Replace with <span class=\"arrow-txt\">→</span>\n          <span class=\"platform\"><svg><use href=\"#icon-calendar\"/></svg>GHL Calendars</span>\n          + SMS triggers\n        </div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"num\">05</div>\n      <div class=\"task-block\">\n        <div class=\"task\">Reporting numbers by hand</div>\n        <div class=\"replace\">Replace with <span class=\"arrow-txt\">→</span>\n          <span class=\"platform\"><svg><use href=\"#icon-stack\"/></svg>N8N + Claude</span>\n          auto-dashboards\n        </div>\n      </div>\n    </div>\n\n    <div class=\"footer-row\">\n      <div class=\"cta-pill\">Using AI yet?</div>\n      <div class=\"logo\">accelod<span style=\"color:#00D4FF\">.</span></div>\n    </div>\n  </div>\n</div>\n\n<button id=\"exportBtn\" onclick=\"exportPNG()\">↓ EXPORT PNG</button>\n\n<script>\n  function exportPNG() {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1080, height:1350, quality:1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-fire-yourself-first.png';\n        link.href = dataUrl;\n        link.click();\n      })\n      .catch(err => console.error(err));\n  }\n</script>\n</body>\n</html>",
  "fb_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Accelod AI — Fire Yourself First</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/dom-to-image-more@3.3.0/dist/dom-to-image-more.min.js\"></script>\n<style>\n  *{box-sizing:border-box;margin:0;padding:0}\n  body{background:#1a1a1a;display:flex;flex-direction:column;align-items:center;padding:30px;font-family:'DM Sans',sans-serif;gap:20px}\n  #post{\n    width:1200px;height:630px;\n    background:#0B1929;\n    position:relative;overflow:hidden;\n    display:flex;\n    font-family:'DM Sans',sans-serif;\n    color:#fff;\n  }\n  .dotgrid{\n    position:absolute;inset:0;\n    background-image:radial-gradient(circle at 1px 1px, rgba(0,212,255,0.08) 1px, transparent 0);\n    background-size:22px 22px;\n    pointer-events:none;\n  }\n  .glow{\n    position:absolute;top:-200px;left:-200px;width:600px;height:600px;\n    background:radial-gradient(circle, rgba(0,212,255,0.18) 0%, transparent 70%);\n    pointer-events:none;\n  }\n  .watermark{\n    position:absolute;top:-60px;right:-60px;width:420px;height:420px;\n    opacity:0.05;transform:rotate(12deg);pointer-events:none;\n  }\n  .left{\n    width:360px;padding:38px 26px 32px 42px;\n    display:flex;flex-direction:column;\n    position:relative;z-index:2;\n  }\n  .right{\n    flex:1;padding:32px 42px 32px 16px;\n    display:flex;align-items:center;\n    position:relative;z-index:2;\n  }\n  .badge{\n    display:inline-flex;align-items:center;gap:8px;\n    padding:8px 16px;\n    border:1px solid rgba(0,212,255,0.5);\n    border-radius:999px;\n    font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:500;\n    color:#00D4FF;letter-spacing:0.08em;text-transform:uppercase;\n    align-self:flex-start;\n    background:rgba(0,212,255,0.05);\n  }\n  .badge svg{width:14px;height:14px;fill:#00D4FF}\n  .headline{\n    font-family:'Outfit',sans-serif;font-weight:900;\n    font-size:68px;line-height:0.95;\n    margin-top:22px;letter-spacing:-0.02em;\n    text-shadow:0 4px 24px rgba(0,212,255,0.25);\n  }\n  .headline em{\n    font-style:normal;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;background-clip:text;\n    -webkit-text-fill-color:transparent;\n    filter:drop-shadow(0 2px 12px rgba(0,212,255,0.5));\n  }\n  .subtitle{\n    margin-top:18px;\n    font-size:17px;line-height:1.5;\n    color:rgba(255,255,255,0.8);\n    font-weight:400;\n  }\n  .cta{\n    margin-top:auto;\n    display:inline-flex;align-items:center;gap:10px;\n    padding:13px 22px;\n    border:1px solid rgba(0,212,255,0.4);\n    border-radius:999px;\n    font-size:14px;font-weight:500;\n    color:#fff;\n    background:rgba(0,212,255,0.08);\n    align-self:flex-start;\n  }\n  .cta::before{\n    content:\"\";width:8px;height:8px;border-radius:50%;\n    background:#00D4FF;box-shadow:0 0 12px #00D4FF;\n  }\n  .logo{\n    margin-top:20px;\n    font-family:'Outfit',sans-serif;font-weight:900;\n    font-size:22px;letter-spacing:-0.02em;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .panel{\n    width:100%;\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:26px 28px;\n  }\n  .panel-title{\n    font-family:'JetBrains Mono',monospace;\n    font-size:12px;letter-spacing:0.12em;text-transform:uppercase;\n    color:#00D4FF;margin-bottom:14px;\n    display:flex;align-items:center;gap:10px;\n  }\n  .panel-title::after{\n    content:\"\";flex:1;height:1px;\n    background:linear-gradient(90deg,rgba(0,212,255,0.4),transparent);\n  }\n  .row{\n    display:flex;align-items:center;gap:12px;\n    padding:11px 0;\n    border-bottom:1px solid rgba(255,255,255,0.06);\n  }\n  .row:last-child{border-bottom:none}\n  .num{\n    width:32px;height:32px;flex-shrink:0;\n    border-radius:8px;\n    background:linear-gradient(135deg,rgba(0,212,255,0.22),rgba(51,225,255,0.06));\n    border:1px solid rgba(0,212,255,0.4);\n    display:flex;align-items:center;justify-content:center;\n    font-family:'JetBrains Mono',monospace;font-weight:500;\n    color:#00D4FF;font-size:13px;\n  }\n  .task{\n    flex:1;\n    font-family:'Outfit',sans-serif;font-weight:700;\n    font-size:22px;color:#fff;\n    letter-spacing:-0.01em;\n  }\n  .arrow{\n    color:rgba(255,255,255,0.35);font-size:20px;font-weight:700;\n  }\n  .tool{\n    display:inline-flex;align-items:center;gap:7px;\n    font-family:'JetBrains Mono',monospace;font-weight:500;\n    font-size:15px;\n    color:#33E1FF;\n    padding:6px 12px;\n    background:rgba(0,212,255,0.1);\n    border:1px solid rgba(0,212,255,0.3);\n    border-radius:6px;\n    white-space:nowrap;\n  }\n  .tool-icon{\n    width:16px;height:16px;flex-shrink:0;\n    display:inline-flex;align-items:center;justify-content:center;\n    border-radius:4px;\n    font-family:'Outfit',sans-serif;font-weight:900;font-size:10px;\n    color:#0B1929;\n  }\n  .ic-ghl{background:linear-gradient(135deg,#FFB400,#FF7A00);}\n  .ic-claude{background:linear-gradient(135deg,#D97757,#C15F3C);color:#fff;}\n  .ic-n8n{background:linear-gradient(135deg,#EA4B71,#B8365A);color:#fff;}\n  .ic-combo{background:linear-gradient(135deg,#EA4B71,#FFB400);color:#fff;}\n  .footer-stat{\n    margin-top:14px;\n    display:flex;align-items:baseline;gap:10px;\n    padding-top:12px;\n    border-top:1px dashed rgba(0,212,255,0.25);\n  }\n  .footer-stat .big{\n    font-family:'Outfit',sans-serif;font-weight:900;\n    font-size:30px;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;background-clip:text;\n    -webkit-text-fill-color:transparent;\n    filter:drop-shadow(0 2px 10px rgba(0,212,255,0.4));\n  }\n  .footer-stat .lbl{\n    font-size:14px;color:rgba(255,255,255,0.65);\n  }\n  .corner-logo{\n    position:absolute;bottom:20px;right:24px;\n    font-family:'Outfit',sans-serif;font-weight:900;\n    font-size:16px;letter-spacing:-0.01em;\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;background-clip:text;\n    -webkit-text-fill-color:transparent;\n    z-index:5;\n  }\n  #export{\n    padding:12px 24px;background:#00D4FF;color:#0B1929;\n    border:none;border-radius:8px;font-weight:700;cursor:pointer;\n    font-family:'Outfit',sans-serif;font-size:14px;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"2\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"2\" transform=\"rotate(30)\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"2\" transform=\"rotate(60)\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"2\" transform=\"rotate(90)\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"2\" transform=\"rotate(120)\"/>\n      <rect x=\"-3\" y=\"-50\" width=\"6\" height=\"100\" rx=\"2\" transform=\"rotate(150)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dotgrid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <svg><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n    <h1 class=\"headline\">Fire <em>Yourself</em> First.</h1>\n    <p class=\"subtitle\">If you're still doing these 5 things in your business, you're the bottleneck. Not the market.</p>\n    <div class=\"cta\">Using AI yet?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-title\">5 Tasks → Replace With</div>\n\n      <div class=\"row\">\n        <div class=\"num\">01</div>\n        <div class=\"task\">Chasing leads</div>\n        <span class=\"arrow\">→</span>\n        <span class=\"tool\"><span class=\"tool-icon ic-ghl\">G</span>GoHighLevel</span>\n      </div>\n      <div class=\"row\">\n        <div class=\"num\">02</div>\n        <div class=\"task\">Writing content</div>\n        <span class=\"arrow\">→</span>\n        <span class=\"tool\"><span class=\"tool-icon ic-claude\">✦</span>Claude</span>\n      </div>\n      <div class=\"row\">\n        <div class=\"num\">03</div>\n        <div class=\"task\">Booking calls</div>\n        <span class=\"arrow\">→</span>\n        <span class=\"tool\"><span class=\"tool-icon ic-ghl\">G</span>GoHighLevel</span>\n      </div>\n      <div class=\"row\">\n        <div class=\"num\">04</div>\n        <div class=\"task\">Data entry &amp; sync</div>\n        <span class=\"arrow\">→</span>\n        <span class=\"tool\"><span class=\"tool-icon ic-n8n\">n</span>N8N</span>\n      </div>\n      <div class=\"row\">\n        <div class=\"num\">05</div>\n        <div class=\"task\">Manual follow-ups</div>\n        <span class=\"arrow\">→</span>\n        <span class=\"tool\"><span class=\"tool-icon ic-combo\">⚡</span>N8N + GHL</span>\n      </div>\n\n      <div class=\"footer-stat\">\n        <span class=\"big\">20+ hrs/week</span>\n        <span class=\"lbl\">reclaimed by owners running this exact stack</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"corner-logo\">Accelod AI</div>\n</div>\n\n<button id=\"export\">Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, {width:1200, height:630, quality:1}).then(dataUrl => {\n      const link = document.createElement('a');\n      link.download = 'accelod-fire-yourself.png';\n      link.href = dataUrl;\n      link.click();\n    });\n  });\n</script>\n</body>\n</html>",
