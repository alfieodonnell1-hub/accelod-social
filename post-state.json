sition:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <!-- 12 spokes -->\n      <script/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\"/>\n      <path d=\"M22.5,-38.97 L3.5,-6.93 L1.03,-7.46 L0.5,-9.93 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-45 L2,-8 L0,-6 L-2,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" viewBox=\"-50 -50 100 100\"><use href=\"#claude-star\" style=\"color:#00D4FF\"/></svg>\n\n  <div class=\"left-col\">\n    <div class=\"badge\">\n      <svg viewBox=\"-50 -50 100 100\"><use href=\"#claude-star\" style=\"color:#00D4FF\"/></svg>\n      AI AUTOMATION\n    </div>\n    <h1 class=\"headline\">Most owners use 27 tools.<br>I use <em>4.</em></h1>\n    <p class=\"subtitle\">Here's why mine outperform yours.</p>\n    <div class=\"cta-pill\">Sound familiar?</div>\n    <div class=\"logo\">◆ Accelod AI</div>\n  </div>\n\n  <div class=\"right-panel\">\n    <div class=\"panel-title\">The Stack · 90% of Daily Ops</div>\n\n    <div class=\"tool-row\">\n      <div class=\"tool-num\">01</div>\n      <div class=\"tool-name\">Claude AI</div>\n      <div class=\"arrow\">→</div>\n      <div class=\"tool-role\">The Brain</div>\n    </div>\n    <div class=\"tool-row\">\n      <div class=\"tool-num\">02</div>\n      <div class=\"tool-name\">N8N</div>\n      <div class=\"arrow\">→</div>\n      <div class=\"tool-role\">Nervous System</div>\n    </div>\n    <div class=\"tool-row\">\n      <div class=\"tool-num\">03</div>\n      <div class=\"tool-name\">GoHighLevel</div>\n      <div class=\"arrow\">→</div>\n      <div class=\"tool-role\">The Mouth</div>\n    </div>\n    <div class=\"tool-row\">\n      <div class=\"tool-num\">04</div>\n      <div class=\"tool-name\">Google Workspace</div>\n      <div class=\"arrow\">→</div>\n      <div class=\"tool-role\">The Memory</div>\n    </div>\n\n    <div class=\"footer-stat\">\n      <div class=\"stat-num\">4 &gt; 27</div>\n      <div class=\"stat-label\">Audit your stack. What can you kill this week?</div>\n    </div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">↓ Export PNG</button>\n\n<script>\ndocument.getElementById('exportBtn').addEventListener('click', function() {\n  const node = document.getElementById('post');\n  domtoimage.toPng(node, { width:1200, height:630, quality:1 })\n    .then(function(dataUrl) {\n      const link = document.createElement('a');\n      link.download = 'accelod-4-tool-stack.png';\n      link.href = dataUrl;\n      link.click();\n    });\n});\n</script>\n</body>\n</html>",
