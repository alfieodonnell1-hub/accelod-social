tion: relative;\n    z-index: 2;\n    background: rgba(0,212,255,0.05);\n  }\n  .badge svg { width: 22px; height: 22px; }\n  .headline {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 92px;\n    line-height: 0.98;\n    color: #fff;\n    margin-top: 32px;\n    letter-spacing: -2px;\n    position: relative;\n    z-index: 2;\n  }\n  .headline em {\n    font-style: normal;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .subtitle {\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 400;\n    font-size: 24px;\n    line-height: 1.45;\n    color: #9BB0C4;\n    margin-top: 28px;\n    max-width: 880px;\n    position: relative;\n    z-index: 2;\n  }\n  .panel {\n    background: #06101A;\n    border: 1px solid rgba(0,212,255,0.2);\n    border-radius: 16px;\n    padding: 38px 42px;\n    margin-top: 36px;\n    position: relative;\n    z-index: 2;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n  }\n  .panel-label {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 18px;\n    color: #00D4FF;\n    letter-spacing: 2px;\n    margin-bottom: 8px;\n  }\n  .panel-title {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 38px;\n    color: #fff;\n    margin-bottom: 26px;\n  }\n  .stat-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px;\n    margin-bottom: 24px;\n  }\n  .stat-card {\n    background: rgba(0,212,255,0.06);\n    border: 1px solid rgba(0,212,255,0.15);\n    border-radius: 12px;\n    padding: 20px 22px;\n  }\n  .stat-value {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 44px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    line-height: 1;\n  }\n  .stat-label {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 20px;\n    color: #9BB0C4;\n    margin-top: 8px;\n  }\n  .fix-list {\n    list-style: none;\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n  }\n  .fix-list li {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n    font-family: 'DM Sans', sans-serif;\n    font-size: 21px;\n    color: #E4ECF3;\n    line-height: 1.4;\n  }\n  .check {\n    color: #00D4FF;\n    font-weight: 700;\n    flex-shrink: 0;\n    margin-top: 2px;\n    font-family: 'JetBrains Mono', monospace;\n  }\n  .fix-list b {\n    color: #fff;\n    font-weight: 700;\n  }\n  .footer {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-top: 36px;\n    position: relative;\n    z-index: 2;\n  }\n  .cta-pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    color: #0B1929;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    font-size: 26px;\n    padding: 18px 32px;\n    border-radius: 999px;\n  }\n  .logo {\n    font-family: 'Outfit', sans-serif;\n    font-weight: 900;\n    font-size: 32px;\n    background: linear-gradient(135deg, #00D4FF, #33E1FF);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -1px;\n  }\n  #exportBtn {\n    background: #00D4FF;\n    color: #0B1929;\n    border: none;\n    padding: 14px 28px;\n    font-family: 'DM Sans', sans-serif;\n    font-weight: 500;\n    font-size: 16px;\n    border-radius: 8px;\n    cursor: pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <!-- 12 spokes -->\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(30)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(60)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(90)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(120)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(150)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(180)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(210)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(240)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(270)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(300)\"/>\n      <path d=\"M0,-48 L3,-8 L0,-4 L-3,-8 Z\" transform=\"rotate(330)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge\">\n    <svg viewBox=\"-50 -50 100 100\"><use href=\"#claude-star\"/></svg>\n    AI AUTOMATION\n  </div>\n\n  <h1 class=\"headline\">The Automation <em>Audit</em>.</h1>\n\n  <p class=\"subtitle\">I looked at this owner's daily workflow and nearly threw my laptop. 14 tabs open, sticky notes everywhere, leads sitting 3+ days cold. Here's what we fixed in 7 days.</p>\n\n  <div class=\"panel\">\n    <div class=\"panel-label\">AFTER — 7 DAYS LATER</div>\n    <div class=\"panel-title\">The new operating system.</div>\n\n    <div class=\"stat-row\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">60%+</div>\n        <div class=\"stat-label\">Admin time cut</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">&lt;5 min</div>\n        <div class=\"stat-label\">Lead follow-up time</div>\n      </div>\n    </div>\n\n    <ul class=\"fix-list\">\n      <li><span class=\"check\">→</span><span><b>Google Workspace hub</b> — one source of truth, killed the 14 tabs.</span></li>\n      <li><span class=\"check\">→</span><span><b>GoHighLevel pipeline</b> auto-nurturing every lead from first touch.</span></li>\n      <li><span class=\"check\">→</span><span><b>Claude AI</b> handling repetitive client comms & follow-ups.</span></li>\n      <li><span class=\"check\">→</span><span><b>Unified invoicing</b> — 4 spreadsheets collapsed into 1 system.</span></li>\n      <li><span class=\"check\">→</span><span><b>Calendar sync</b> replaced the \"I'll remember it\" method.</span></li>\n    </ul>\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta-pill\">Still selling manually?</div>\n    <div class=\"logo\">Accelod<span style=\"color:#00D4FF\">.</span></div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">Export PNG</button>\n\n<script>\n  document.getElementById('exportBtn').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1080, height: 1350, quality: 1 })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-automation-audit.png';\n        link.href = dataUrl;\n        link.click();",
  "fb_caption": "I looked at this owner's daily workflow and nearly threw my laptop.\n\nHere's the BEFORE:\n• 14 browser tabs open at all times\n• Sticky notes everywhere\n• Leads sitting 3+ days with no follow-up\n• Manual invoicing spread across 4 spreadsheets\n• Calendar system = 'I'll remember it'\n\nHere's the AFTER (7 days later):\n✅ Centralised Google Workspace hub\n✅ GoHighLevel pipeline auto-nurturing leads\n✅ Claude AI handling repetitive comms\n✅ 60%+ admin time cut\n\nThis wasn't a marketing problem. It was a workflow problem. And it's the same one I see in nearly every business I audit.\n\nStill selling manually? Drop a 'AUDIT' below and I'll show you where you're leaking time.\n\n#AIAutomation #N8N #GoHighLevel #BusinessAutomation #Entrepreneur #SmallBusinessOwner #WorkflowAutomation #ClaudeAI #GoogleWorkspace #SalesAutomation #LeadGeneration #CRM #DigitalTransformation #ProductivityHacks #BusinessGrowth #Accelod #AutomationAgency #ScaleYourBusiness #TimeManagement #SystemsThinking #MarketingAutomation #BusinessSystems #StartupLife #OnlineBusiness",
