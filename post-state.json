dth:fit-content;\n    position:relative;\n    z-index:2;\n  }\n  .badge svg { width:18px; height:18px; }\n  .headline {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:98px;\n    line-height:0.96;\n    letter-spacing:-0.03em;\n    margin-top:24px;\n    color:#fff;\n    position:relative;\n    z-index:2;\n  }\n  .headline em {\n    font-style:normal;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .subtitle {\n    font-family:'DM Sans',sans-serif;\n    font-weight:400;\n    font-size:24px;\n    line-height:1.4;\n    color:#B8C5D6;\n    margin-top:22px;\n    max-width:900px;\n    position:relative;\n    z-index:2;\n  }\n  .panel {\n    background:#06101A;\n    border:1px solid rgba(0,212,255,0.2);\n    border-radius:16px;\n    padding:32px;\n    margin-top:28px;\n    position:relative;\n    z-index:2;\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    gap:18px;\n  }\n  .compare {\n    display:grid;\n    grid-template-columns: 1fr 1fr;\n    gap:14px;\n  }\n  .compare-box {\n    padding:20px;\n    border-radius:12px;\n    display:flex;\n    flex-direction:column;\n    gap:10px;\n  }\n  .before {\n    background:rgba(239,68,68,0.08);\n    border:1px solid rgba(239,68,68,0.3);\n  }\n  .after {\n    background:rgba(0,212,255,0.08);\n    border:1px solid rgba(0,212,255,0.35);\n  }\n  .compare-label {\n    font-family:'JetBrains Mono',monospace;\n    font-size:18px;\n    letter-spacing:0.08em;\n    text-transform:uppercase;\n  }\n  .before .compare-label { color:#EF4444; }\n  .after .compare-label { color:#00D4FF; }\n  .compare-stat {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:62px;\n    line-height:1;\n    color:#fff;\n    letter-spacing:-0.02em;\n  }\n  .after .compare-stat {\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  .compare-desc {\n    font-family:'DM Sans',sans-serif;\n    font-size:22px;\n    color:#B8C5D6;\n    line-height:1.35;\n  }\n  .savings-strip {\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    background:linear-gradient(90deg, rgba(0,212,255,0.15), rgba(0,212,255,0.02));\n    border-left:4px solid #00D4FF;\n    border-radius:10px;\n    padding:20px 24px;\n  }\n  .savings-label {\n    font-family:'JetBrains Mono',monospace;\n    font-size:20px;\n    color:#B8C5D6;\n    text-transform:uppercase;\n    letter-spacing:0.05em;\n  }\n  .savings-num {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:56px;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n    letter-spacing:-0.02em;\n  }\n  .stack-title {\n    font-family:'JetBrains Mono',monospace;\n    font-size:18px;\n    color:#00D4FF;\n    letter-spacing:0.12em;\n    text-transform:uppercase;\n    margin-top:4px;\n  }\n  .stack-row {\n    display:flex;\n    align-items:center;\n    gap:18px;\n    padding:16px 20px;\n    background:rgba(255,255,255,0.02);\n    border:1px solid rgba(255,255,255,0.06);\n    border-radius:12px;\n  }\n  .stack-row .step {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:32px;\n    color:#00D4FF;\n    min-width:40px;\n  }\n  .stack-row img, .stack-row svg.tool-logo {\n    width:38px; height:38px; object-fit:contain;\n    flex-shrink:0;\n  }\n  .stack-row .tool-name {\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:24px;\n    color:#fff;\n    min-width:170px;\n  }\n  .stack-row .tool-job {\n    font-family:'DM Sans',sans-serif;\n    font-size:22px;\n    color:#B8C5D6;\n  }\n  .footer {\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    margin-top:24px;\n    position:relative;\n    z-index:2;\n  }\n  .cta {\n    display:inline-flex;\n    align-items:center;\n    gap:12px;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    color:#0B1929;\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:24px;\n    padding:18px 34px;\n    border-radius:999px;\n    letter-spacing:-0.01em;\n  }\n  .logo {\n    font-family:'Outfit',sans-serif;\n    font-weight:900;\n    font-size:34px;\n    letter-spacing:-0.02em;\n    background:linear-gradient(90deg,#00D4FF,#33E1FF);\n    -webkit-background-clip:text;\n    background-clip:text;\n    -webkit-text-fill-color:transparent;\n  }\n  #export {\n    padding:14px 28px;\n    background:#00D4FF;\n    color:#0B1929;\n    border:none;\n    border-radius:8px;\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:16px;\n    cursor:pointer;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"0 0 100 100\">\n    <g fill=\"currentColor\">\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(30 50 50)\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(60 50 50)\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(90 50 50)\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(120 50 50)\"/>\n      <rect x=\"48\" y=\"4\" width=\"4\" height=\"92\" rx=\"2\" transform=\"rotate(150 50 50)\"/>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"dot-grid\"></div>\n  <div class=\"glow-tl\"></div>\n  <svg class=\"watermark\" style=\"color:#00D4FF\"><use href=\"#claude-star\"/></svg>\n\n  <div class=\"badge\">\n    <svg><use href=\"#claude-star\"/></svg>\n    AI AUTOMATION / CASE STUDY\n  </div>\n\n  <h1 class=\"headline\">He didn't fire her<br>because she was<br>bad. He fired her<br>because a <em>workflow</em><br>was better.</h1>\n\n  <p class=\"subtitle\">A real electrician replaced a $45k/yr office manager with three tools talking to each other. Here's the receipt.</p>\n\n  <div class=\"panel\">\n\n    <div class=\"compare\">\n      <div class=\"compare-box before\">\n        <div class=\"compare-label\">◼ Before</div>\n        <div class=\"compare-stat\">1 · 3 · ∞</div>\n        <div class=\"compare-desc\">1 office manager<br>3 spreadsheets<br>Missed jobs weekly</div>\n      </div>\n      <div class=\"compare-box after\">\n        <div class=\"compare-label\">◆ After</div>\n        <div class=\"compare-stat\">1 · 0 · 0</div>\n        <div class=\"compare-desc\">1 workflow<br>0 dropped leads<br>Sleeps in Sundays</div>\n      </div>\n    </div>\n\n    <div class=\"savings-strip\">\n      <div class=\"savings-label\">Annual cost saved</div>\n      <div class=\"savings-num\">$45,000</div>\n    </div>\n\n    <div class=\"stack-title\">— The 3-tool stack that replaced her</div>\n\n    <div class=\"stack-row\">\n      <div class=\"step\">01</div>\n      <svg class=\"tool-logo\" width=\"36\" height=\"36\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"#112240\"/><path d=\"M20,72 L20,52 L14,52 L26,28 L38,52 L32,52 L32,72 Z\" fill=\"#F59E0B\"/><path d=\"M50,76 L50,50 L43,50 L55,22 L67,50 L60,50 L60,76 Z\" fill=\"#3B82F6\"/><path d=\"M72,72 L72,52 L66,52 L78,28 L90,52 L84,52 L84,72 Z\" fill=\"#22C55E\"/></svg>\n      <div class=\"tool-name\">GoHighLevel</div>\n      <div class=\"tool-job\">Captures every lead. Never sleeps.</div>\n    </div>\n\n    <div class=\"stack-row\">\n      <div class=\"step\">02</div>\n      <img src=\"https://cdn.simpleicons.org/anthropic/00D4FF\" alt=\"Claude\">\n      <div class=\"tool-name\">Claude AI</div>\n      <div class=\"tool-job\">Writes quotes in the boss's voice.</div>\n    </div>\n\n    <div class=\"stack-row\">\n      <div class=\"step\">03</div>\n      <img src=\"https://cdn.simpleicons.org/n8n/EA4B71\" alt=\"N8N\">\n      <div class=\"tool-name\">N8N</div>\n      <div class=\"tool-job\">Schedules jobs. Sends the van.</div>\n    </div>\n\n  </div>\n\n  <div class=\"footer\">\n    <div class=\"cta\">Sound familiar? →</div>\n    <div class=\"logo\">✦ Accelod AI</div>\n  </div>\n</div>\n\n<button id=\"export\">⬇ Export PNG</button>\n\n<script>\n  document.getElementById('export').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width:1080, height:1350, quality:1, bgcolor:'#0B1929' })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-electrician-case-study.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n</body>\n</html>",
