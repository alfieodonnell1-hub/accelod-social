    padding:34px 36px;\n    display:flex;\n    flex-direction:column;\n  }\n  .panel-title {\n    font-family:'JetBrains Mono', monospace;\n    font-size:12px;\n    letter-spacing:0.18em;\n    color:#00D4FF;\n    text-transform:uppercase;\n    margin-bottom:6px;\n  }\n  .panel-sub {\n    font-family:'Outfit', sans-serif;\n    font-weight:700;\n    color:#fff;\n    font-size:22px;\n    margin-bottom:20px;\n  }\n\n  .stack {\n    display:grid;\n    grid-template-columns: 1fr 1fr;\n    gap:14px;\n    margin-bottom:20px;\n  }\n  .tool {\n    background:rgba(0,212,255,0.04);\n    border:1px solid rgba(0,212,255,0.15);\n    border-radius:10px;\n    padding:12px 14px;\n  }\n  .tool .role {\n    font-family:'JetBrains Mono', monospace;\n    font-size:11px;\n    color:#7fb8cf;\n    text-transform:uppercase;\n    letter-spacing:0.1em;\n  }\n  .tool .name {\n    font-family:'Outfit', sans-serif;\n    font-weight:700;\n    color:#fff;\n    font-size:20px;\n    margin-top:2px;\n  }\n\n  .divider {\n    height:1px;\n    background:rgba(0,212,255,0.15);\n    margin:6px 0 18px;\n  }\n\n  .results {\n    display:flex;\n    flex-direction:column;\n    gap:12px;\n  }\n  .row {\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:16px;\n  }\n  .row .label {\n    color:#B8C5D6;\n    font-size:20px;\n    font-weight:400;\n  }\n  .row .value {\n    font-family:'Outfit', sans-serif;\n    font-weight:900;\n    font-size:28px;\n    color:#fff;\n  }\n  .row .value.cyan {\n    background: linear-gradient(135deg, #00D4FF 0%, #33E1FF 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .arrow {\n    color:#00D4FF;\n    font-family:'JetBrains Mono', monospace;\n    margin:0 6px;\n  }\n\n  #exportBtn {\n    background:linear-gradient(135deg,#00D4FF,#33E1FF);\n    border:none;\n    color:#0B1929;\n    padding:12px 24px;\n    border-radius:999px;\n    font-family:'Outfit',sans-serif;\n    font-weight:700;\n    font-size:14px;\n    cursor:pointer;\n    letter-spacing:0.05em;\n  }\n</style>\n</head>\n<body>\n\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n  <symbol id=\"claude-star\" viewBox=\"-50 -50 100 100\">\n    <g fill=\"currentColor\">\n      <!-- 12 spokes -->\n      <g>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"1.5\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"1.5\" transform=\"rotate(30)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"1.5\" transform=\"rotate(60)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"1.5\" transform=\"rotate(90)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"1.5\" transform=\"rotate(120)\"/>\n        <rect x=\"-3\" y=\"-48\" width=\"6\" height=\"96\" rx=\"1.5\" transform=\"rotate(150)\"/>\n      </g>\n    </g>\n  </symbol>\n</svg>\n\n<div id=\"post\">\n  <div class=\"glow\"></div>\n  <div class=\"watermark\">\n    <svg><use href=\"#claude-star\"/></svg>\n  </div>\n\n  <div class=\"left\">\n    <div class=\"badge\">\n      <svg><use href=\"#claude-star\"/></svg>\n      AI Automation\n    </div>\n    <h1 class=\"headline\">Your onboarding is <em>leaking money.</em></h1>\n    <p class=\"subtitle\">The exact 4-hour build that fixed mine forever — zero manual work.</p>\n    <div class=\"cta\">Doing this manually?</div>\n    <div class=\"logo\">Accelod AI</div>\n  </div>\n\n  <div class=\"right\">\n    <div class=\"panel\">\n      <div class=\"panel-title\">The 4-Hour Stack</div>\n      <div class=\"panel-sub\">Built end-to-end, no code touched twice.</div>\n\n      <div class=\"stack\">\n        <div class=\"tool\">\n          <div class=\"role\">Intake</div>\n          <div class=\"name\">GoHighLevel</div>\n        </div>\n        <div class=\"tool\">\n          <div class=\"role\">Workflow Logic</div>\n          <div class=\"name\">n8n</div>\n        </div>\n        <div class=\"tool\">\n          <div class=\"role\">Personalisation</div>\n          <div class=\"name\">Claude</div>\n        </div>\n        <div class=\"tool\">\n          <div class=\"role\">Docs & Delivery</div>\n          <div class=\"name\">Google Workspace</div>\n        </div>\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <div class=\"results\">\n        <div class=\"row\">\n          <div class=\"label\">Build time</div>\n          <div class=\"value cyan\">4 hours</div>\n        </div>\n        <div class=\"row\">\n          <div class=\"label\">Manual steps per client</div>\n          <div class=\"value\"><span style=\"color:#7fb8cf;font-size:22px\">17</span> <span class=\"arrow\">→</span> <span class=\"value cyan\">0</span></div>\n        </div>\n        <div class=\"row\">\n          <div class=\"label\">Time to onboard a client</div>\n          <div class=\"value\"><span style=\"color:#7fb8cf;font-size:22px\">2 days</span> <span class=\"arrow\">→</span> <span class=\"value cyan\">9 min</span></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<button id=\"exportBtn\">⬇ Export PNG</button>\n\n<script>\n  document.getElementById('exportBtn').addEventListener('click', () => {\n    const node = document.getElementById('post');\n    domtoimage.toPng(node, { width: 1200, height: 630, bgcolor:'#0B1929' })\n      .then(dataUrl => {\n        const link = document.createElement('a');\n        link.download = 'accelod-onboarding-automation.png';\n        link.href = dataUrl;\n        link.click();\n      });\n  });\n</script>\n\n</body>\n</html>",
